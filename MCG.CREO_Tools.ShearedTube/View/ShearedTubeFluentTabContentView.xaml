<UserControl x:Class="MCG.CREO_Tools.ShearedTube.View.ShearedTubeFluentTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.ShearedTube.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:Fluent="urn:fluent-ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>
            <BitmapImage x:Key="Tube02" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CreateTube0002.jpg" />
            <BitmapImage x:Key="Tube03" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CreateTube0003.jpg" />
            <BitmapImage x:Key="Tube05" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CreateTube0005.jpg" />
            <BitmapImage x:Key="Tube06" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CreateTube0006.jpg" />
            <BitmapImage x:Key="Tube07" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CreateTube0007.jpg" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Canvas>
        <Image Canvas.Top="12" Canvas.Left="100" Height="120" Width="500" Stretch="Fill" Source="{StaticResource ResourceKey=Tube02}" />
        <Fluent:TextBox PreviewTextInput="Double_PreviewTextInput" 
                     LostFocus="Double_LostFocus" 
                     Text="{Binding CurrentShearedTubeDataContext.TotalLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=1500}" 
                     Height="23" Canvas.Left="450"  Canvas.Top="11" TextWrapping="Wrap" Width="55" TextAlignment="Center" VerticalContentAlignment="Center" />

        <Image Canvas.Top="130" Canvas.Left="2" Height="100" Width="688" Stretch="Fill"  Source="{StaticResource ResourceKey=Tube06}" />
        <Fluent:TextBox PreviewTextInput="Double_PreviewTextInput" 
                     LostFocus="Double_LostFocus" 
                     Text="{Binding CurrentShearedTubeDataContext.LeftAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=45}" 
                     Height="23" Canvas.Left="17"  Canvas.Top="195" TextWrapping="Wrap" Width="30" TextAlignment="Center" VerticalContentAlignment="Center" />
        <Fluent:TextBox PreviewTextInput="Double_PreviewTextInput" 
                     LostFocus="Double_LostFocus" 
                     Text="{Binding CurrentShearedTubeDataContext.RightAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=45}" 
                     Height="23" Canvas.Left="635"  Canvas.Top="145" TextWrapping="Wrap" Width="30" TextAlignment="Center" VerticalContentAlignment="Center" />

        <Image Canvas.Top="246" Canvas.Left="2" Height="150" Width="216" Stretch="Fill" Source="{StaticResource ResourceKey=Tube03}" />
        <Fluent:ComboBox ItemsSource="{Binding CurrentShearedTubeDataContext.ListThickness}" 
                      SelectedItem="{Binding CurrentShearedTubeDataContext.SelectedThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      IsEditable="False"
                      Height="23" Canvas.Left="137"  Canvas.Top="245" Width="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        <Fluent:ComboBox ItemsSource="{Binding CurrentShearedTubeDataContext.ListDiameter}" 
                      SelectedItem="{Binding CurrentShearedTubeDataContext.SelectedDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      IsEditable="False"
                      Height="23" Canvas.Left="30"  Canvas.Top="245"  Width="55" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

        <Image Canvas.Top="246" Canvas.Left="220" Height="150" Width="218" Stretch="Fill" Source="{StaticResource ResourceKey=Tube05}" />
        <Fluent:TextBox PreviewTextInput="Double_PreviewTextInput" 
                     LostFocus="Double_LostFocus" 
                     Text="{Binding CurrentShearedTubeDataContext.ExtremityAngle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}" 
                     Height="23" Canvas.Left="220"  Canvas.Top="281" TextWrapping="Wrap"  Width="40" TextAlignment="Center" VerticalContentAlignment="Center" />

        <Image Canvas.Top="246" Canvas.Left="440" Height="150" Width="250" Stretch="Fill" Source="{StaticResource ResourceKey=Tube07}" />
        <Fluent:CheckBox IsChecked="{Binding CurrentShearedTubeDataContext.IsHoleSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
               Canvas.Left="480" Canvas.Top="302" Height="15" Width="16" >
            <CheckBox.LayoutTransform>
                <ScaleTransform ScaleX="2" ScaleY="2" />
            </CheckBox.LayoutTransform>
        </Fluent:CheckBox>
        <Fluent:TextBox Name="TbHoleDiameter" PreviewTextInput="Double_PreviewTextInput" LostFocus="Double_LostFocus" 
                     Text="{Binding CurrentShearedTubeDataContext.HoleDiameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=7}" 
                     IsEnabled="{Binding CurrentShearedTubeDataContext.IsHoleSelected}" 
                     Height="23" Canvas.Left="632"  Canvas.Top="280" TextWrapping="Wrap" Width="45" TextAlignment="Center" VerticalContentAlignment="Center" />
        <Fluent:TextBox Name="TbHoleLength" PreviewTextInput="Double_PreviewTextInput" LostFocus="Double_LostFocus"  
                     Text="{Binding CurrentShearedTubeDataContext.HoleLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=12}" 
                     IsEnabled="{Binding CurrentShearedTubeDataContext.IsHoleSelected}" 
                     Height="23" Canvas.Left="580" Canvas.Top="340" TextWrapping="Wrap" Width="45" TextAlignment="Center" VerticalContentAlignment="Center" RenderTransformOrigin="0.5,0.5" >
            <Fluent:TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="53"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Fluent:TextBox.RenderTransform>
        </Fluent:TextBox>
    </Canvas>
</UserControl>
