<Fluent:RibbonTabItem x:Class="MCG.CREO_Tools.ShearedTube.View.ShearedTubeFluentTabMainView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.CREO_Tools.ShearedTube.View"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      xmlns:Fluent="urn:fluent-ribbon"
                      mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="800"
                      Header="{DynamicResource ST_AppName}">

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/exec.ico" />
            <BitmapImage x:Key="START" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Update.png" />
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help_32x32.png" />
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox Header="{DynamicResource ST_RibGrpData}">
        <StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image Source="{StaticResource ResourceKey=PART}"
                       Height="24"
                       Margin="5,0,5,0"/>
                <Fluent:TwoLineLabel HorizontalAlignment="Center" 
                                     Text="{DynamicResource ST_LabelPartNumbner}"/>
            </StackPanel>
            <Fluent:TextBox Text="{Binding CurrentShearedTubeDataContext.Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            TextAlignment="Center"
                            VerticalContentAlignment="Center"
                            MinWidth="100"
                            Margin="-9,0,0,0"/>
        </StackPanel>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource ST_RibParameters}">
        <Fluent:TextBox Text="{Binding CurrentShearedTubeDataContext.PtcCommonName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=TUBE}" 
                        TextAlignment="Center"
                        Header="{DynamicResource ST_LabelPtcCommonName}"/>
        <Fluent:TextBox Text="{Binding CurrentShearedTubeDataContext.Description_2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=TUBE}" 
                        TextAlignment="Center"
                        Header="{DynamicResource ST_LabelDescription_2}"/>
        <Fluent:ComboBox ItemsSource="{Binding CurrentShearedTubeDataContext.ListGroupCreator}" 
                            SelectedItem="{Binding CurrentShearedTubeDataContext.SelectedGroupCreator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=BAB}" 
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            IsEditable="True"
                            Header="{DynamicResource ST_LabelGroupCreator}"></Fluent:ComboBox>
        <StackPanel Margin="10,0,0,0">
            <Fluent:TextBox Text="{Binding CurrentShearedTubeDataContext.Description2_1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=TUBE}" 
                                TextAlignment="Center"
                                Header="{DynamicResource ST_LabelDescription2_1}"/>
            <Fluent:TextBox Text="{Binding CurrentShearedTubeDataContext.Description2_2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=TUBE}" 
                                TextAlignment="Center"
                                Header="{DynamicResource ST_LabelDescription2_2}"/>
            <Fluent:ComboBox ItemsSource="{Binding CurrentShearedTubeDataContext.ListQualInspGroup}" 
                                 SelectedItem="{Binding CurrentShearedTubeDataContext.SelectedQualInspGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=BAB}" 
                                 HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center"
                                 IsEditable="False"
                                 Header="{DynamicResource ST_LabelQualInspGrp}"></Fluent:ComboBox>
        </StackPanel>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource ST_RibGrpCreo}">
        <Fluent:Button LargeIcon="{StaticResource START}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandCreateTube}"
                       IsEnabled="{Binding CurrentShearedTubeDataContext.IsCreoEnable}"></Fluent:Button>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource ST_RibGrpTools}">
        <Fluent:Button LargeIcon="{StaticResource HELP}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandBtHelpMouseLeftButtonUpEvent}"></Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
