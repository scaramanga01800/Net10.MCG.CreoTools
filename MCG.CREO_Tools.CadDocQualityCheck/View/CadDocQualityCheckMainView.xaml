<Fluent:RibbonTabItem x:Class="MCG.CREO_Tools.CadDocQualityCheck.View.CadDocQualityCheckMainView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.CREO_Tools.CadDocQualityCheck.View"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      xmlns:Fluent="urn:fluent-ribbon"
                      mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="800"
                      Header="{DynamicResource CQC_AppName}">

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="CADDOC" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Export_Cad.png" />
            <BitmapImage x:Key="CHECK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Check_Cad.gif" />
            <BitmapImage x:Key="UPDATERELATION" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Relation_Update_32x32.gif" />
            <BitmapImage x:Key="UPDATEATTRIBUTE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Attribute_Update_32x32.gif" />
            <BitmapImage x:Key="UPDATELAYER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Layer_Update_32x32.gif" />
            <BitmapImage x:Key="UPDATEUNITS" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Units_Update_32x32.gif" />
            <BitmapImage x:Key="XLS" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico" />
            <BitmapImage x:Key="CheckOut" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CheckOut.png" />
            <BitmapImage x:Key="CheckIn" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CheckIn.png" />
            <BitmapImage x:Key="LARGEDELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"></conv:BoolToInverseBoolConverter>
            <conv:BooleanAndConverter x:Key="MultiAndBoolConv"/>
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox Header="{DynamicResource CQC_RibGrpCreoInteraction}">
        <Fluent:CheckBox Header="{DynamicResource CQC_CbDisplayedModelsOnly}"
                         IsChecked="{Binding CurrentDataContext.IsOnlyDisplayedModels,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
        <Fluent:CheckBox Header="{DynamicResource CQC_CbDisplayedActiveModelOnly}"
                         IsChecked="{Binding CurrentDataContext.IsOnlyActiveModel,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>

        <Fluent:Button LargeIcon="{StaticResource XLS}"
                       Header="{DynamicResource CQC_MenuImportFromXls}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandImportFromExcel}">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress"/>
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource CADDOC}"
                       Command="{Binding CommandListCadDoc}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress"/>
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>
        <Fluent:Button LargeIcon="{StaticResource CHECK}"
                       Command="{Binding CommandCheckCadDoc}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource CQC_RibGrpShow}">
        <Fluent:Button  LargeIcon="{StaticResource LARGEDELETE}" 
                        Command="{Binding CommandDeleteSelectedCadDoc}" 
                        Margin="5,0,5,0">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource CQC_BtTitleDeleteSelectedCadDocs}" Width ="250"
                          Image="{StaticResource LARGEDELETE}"
                          Text="{DynamicResource CQC_BtStartDeleteSelectedCadDocs}"/>
            </Fluent:Button.ToolTip>
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

        <Fluent:CheckBox Header="{DynamicResource CQC_CbIsCheckedOutText}"
                         IsChecked="{Binding CurrentDataContext.IsCheckedOutShown,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
        <Fluent:CheckBox Header="{DynamicResource CQC_CbIsLocallyModifiedText}"
                         IsChecked="{Binding CurrentDataContext.IsLocallyModifiedShown,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
        <Fluent:CheckBox Header="{DynamicResource CQC_CbIsReadOnlyShownText}"
                         IsChecked="{Binding CurrentDataContext.IsReadOnlyShown,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
        <Fluent:CheckBox Header="{DynamicResource CQC_CbCheckUncheckedOutItemText}"
                         IsChecked="{Binding CurrentDataContext.CheckUncheckedOutItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
        <Fluent:CheckBox Header="{DynamicResource CQC_CbForceTypeProeUpdateText}"
                         IsChecked="{Binding CurrentDataContext.ForceTypeProeUpdate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource CQC_RibGrpUpdate}">
        <Fluent:Button LargeIcon="{StaticResource CheckIn}"
                       Command="{Binding CommandCheckIn}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>
        <Fluent:Button LargeIcon="{StaticResource CheckOut}"
                       Command="{Binding CommandCheckOut}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>
        <Fluent:Button LargeIcon="{StaticResource UPDATERELATION}"
                       Command="{Binding CommandUpdateRelations}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource UPDATEATTRIBUTE}"
                       Command="{Binding CommandUpdateAttributes}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource UPDATELAYER}"
                       Command="{Binding CommandUpdateLayers}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource UPDATEUNITS}"
                       Command="{Binding CommandUpdateUnits}"
                       Margin="5,0,5,0">
            <Fluent:Button.IsEnabled>
                <MultiBinding Converter="{StaticResource MultiAndBoolConv}">
                    <Binding Path="CurrentDataContext.ShowActionButton" />
                    <Binding Path="CurrentDataContext.IsNoActionInProgress" />
                </MultiBinding>
            </Fluent:Button.IsEnabled>
        </Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
