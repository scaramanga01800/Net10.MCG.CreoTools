<UserControl x:Class="MCG.CREO_Tools.CadDocQualityCheck.View.RunCreoMacroTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.CadDocQualityCheck.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:CadDataCheckVM="clr-namespace:MCG.CREO_Tools.CadDocQualityCheck.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="PASTE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/paste.gif" />
            <BitmapImage x:Key="DOWN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Arrow_Down.ico" />
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <conv:BoolToVisibilityHiddenConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityHiddenConverter>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"></conv:InverseBoolToVisibilityConverter>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" MinWidth="200"></ColumnDefinition>
                <ColumnDefinition Width="2*"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DataGridCadItem" 
              IsReadOnly="True"
              ItemsSource="{Binding CurrentDataContext.ShownCadModels}" 
              AutoGenerateColumns="False" 
              CanUserAddRows="False" 
              CanUserDeleteRows="False">
                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="KeyDown">
                        <behaviors:InvokeCommandAction Command="{Binding CommandPaste}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>

                <DataGrid.ContextMenu>
                    <Fluent:ContextMenu>
                        <Fluent:MenuItem Header="{DynamicResource CQC_MiPastePart}" Command="{Binding CommandPaste}">
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource PASTE}"></Image>
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                    </Fluent:ContextMenu>
                </DataGrid.ContextMenu>


                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="ColPartNumber"  Binding="{Binding Number}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource CQC_ColHeader01}"></TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Background" Value="#FFC9C9C9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLocallyModified}" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="ColStatus"  
                                Binding="{Binding Status}" 
                                IsReadOnly="True" 
                                CanUserSort="True" 
                                Visibility="{Binding Data.CurrentDataContext.IsLoadedFromCreo, Source={StaticResource proxy}, Converter={StaticResource ResourceKey=InverseBoolToVisibilityConverter}}" >
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource CQC_ColHeader02}"></TextBlock>
                        </DataGridTextColumn.Header>
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnly}" Value="True">
                                        <Setter Property="Background" Value="#FFC9C9C9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLocallyModified}" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Fluent:TwoLineLabel HasTwoLines="False" 
                                 Text="{DynamicResource CQC_LabelMacroTitle}"
                                 HorizontalAlignment="Center"></Fluent:TwoLineLabel>
                <TextBox Grid.Row="1"
                 Text="{Binding CurrentDataContext.Macro, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                </TextBox>
            </Grid>
        </Grid>

    </DockPanel>
</UserControl>
