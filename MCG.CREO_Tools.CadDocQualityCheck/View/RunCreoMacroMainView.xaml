<Fluent:RibbonTabItem x:Class="MCG.CREO_Tools.CadDocQualityCheck.View.RunCreoMacroMainView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.CREO_Tools.CadDocQualityCheck.View"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      xmlns:Fluent="urn:fluent-ribbon"
                      mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="800"
                      Header="{DynamicResource CQC_AppNameRunCreoMacro}">

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="DELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <BitmapImage x:Key="START" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Start.png" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox IsEnabled="{Binding CurrentDataContext.IsEnableActionButton}">
        <Fluent:Button Command="{Binding CommandStart}" 
                       LargeIcon="{StaticResource START}"
                       Margin="5,0,5,0"
                       IsEnabled="{Binding CurrentDataContext.IsEnabledCreo}">
        </Fluent:Button>
        <Fluent:Button  LargeIcon="{StaticResource DELETE}" Command="{Binding CommandDeleteItem}" Margin="5,0,5,0">
        </Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
