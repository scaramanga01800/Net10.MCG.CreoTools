<Fluent:RibbonWindow x:Class="MCG.WindchillTools.ManageWTObject.View.CreateWtDocumentMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.WindchillTools.ManageWTObject.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     xmlns:MCGLib="clr-namespace:MCG.CommonLib.Models.Enums;assembly=MCG.CommonLib"
                     mc:Ignorable="d"
                     Title="{DynamicResource MWT_WindowAddDocument}" 
                     Height="470" Width="300"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/add_document.ico">

    <Fluent:RibbonWindow.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="OK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico"/>
            <BitmapImage x:Key="CANCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/cross.ico"/>
            <BitmapImage x:Key="FOLDER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Folder.ico"/>

            <ObjectDataProvider x:Key="DataRevisionEnum" MethodName="GetValues"
                           ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="MCGLib:McgRevisionSchemaEnum"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="QualInspGrpEnum" MethodName="GetValues"
                           ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="MCGLib:QualInspGrpValueEnum"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </ResourceDictionary>
    </Fluent:RibbonWindow.Resources>

    <DockPanel Background="{DynamicResource Fluent.Ribbon.Brushes.RibbonTabControl.Background}">
        <StackPanel DockPanel.Dock="Top" Margin="10">
            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColWindchillType}"
                            ItemsSource="{Binding ListWindchillDocumentType}" 
                            SelectedItem="{Binding SelectedWindchillDocumentType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEditable="False"></Fluent:ComboBox>
            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColWindchillPartType}"
                            ItemsSource="{Binding ListWindchillPartType}" 
                            SelectedItem="{Binding SelectedWindchillPartType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEditable="False"></Fluent:ComboBox>
            <Fluent:TextBox Header="{DynamicResource MWT_LabelColNumber}"
                           Text="{Binding WtObject.NUMBER, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColRevision}"
                            Text="{Binding WtObject.REVISION, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Source={StaticResource DataRevisionEnum}}"></Fluent:ComboBox>

            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColPtcCommonName}"
                            Text="{Binding WtObject.PTCCOMMONNAME, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding ListWebterm}"
                            SelectedItem="{Binding SelectedWebterm, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                            IsEditable="True"></Fluent:ComboBox>
            <Fluent:TextBox Header="{DynamicResource MWT_LabelColDescription2}"
                           Text="{Binding WtObject.DESCRIPTION2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColDescription21}"
                            Text="{Binding WtObject.DESCRIPTION21, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding ListWebtermLocal}"
                            SelectedItem="{Binding SelectedLocalWebterm, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                            IsEditable="True"></Fluent:ComboBox>
            <Fluent:TextBox Header="{DynamicResource MWT_LabelColDescription22}"
                           Text="{Binding WtObject.DESCRIPTION22, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

            <Fluent:TextBox Header="{DynamicResource MWT_LabelColGroupCreator}"
                           Text="{Binding WtObject.GROUPCREATOR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
            <Fluent:TextBox Header="{DynamicResource MWT_LabelColMass}"
                           Text="{Binding WtObject.MASS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

            <Fluent:ComboBox Header="{DynamicResource MWT_LabelColQualInspGrp}"
                            Text="{Binding WtObject.QUALINSPGRP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Source={StaticResource QualInspGrpEnum}}"></Fluent:ComboBox>

            <Fluent:ComboBox Header="{DynamicResource MWT_LabelGroup}"
                            Text="{Binding WtObject.GROUP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding ListGroup}"></Fluent:ComboBox>
            <Fluent:TextBox Header="{DynamicResource MWT_LabelSubGroup}"
                           Text="{Binding WtObject.SUB_GROUP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
            <Fluent:ComboBox Header="{DynamicResource MWT_LabelBrand}"
                            Text="{Binding WtObject.BRAND, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding ListBrand}"></Fluent:ComboBox>

            <DockPanel>
                <Button Height="40"
                       Command="{Binding CommandSelectContext}">
                    <Image Source="{StaticResource FOLDER}"></Image>
                </Button>
                <Grid DockPanel.Dock="Top">
                    <StackPanel DockPanel.Dock="Top" >
                        <Fluent:TextBox Header="{DynamicResource MWT_LabelColContext}"
                                       Text="{Binding WtObject.SelectedWindchillContext.Name}"
                                       IsReadOnly="True"></Fluent:TextBox>
                        <Fluent:TextBox Header="{DynamicResource MWT_LabelColFolder}"
                                       Text="{Binding WtObject.SelectedWindchillContext.Folder}"
                                       IsReadOnly="True"></Fluent:TextBox>
                    </StackPanel>

                </Grid>
            </DockPanel>

        </StackPanel>
        <StackPanel Orientation="Horizontal" 
                   DockPanel.Dock="Bottom"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom">
            <Button Height="32" Width="32" 
                   Margin="20,10,20,10"
                   Click="Button_OK">
                <Image Source="{StaticResource OK}"></Image>
            </Button>
            <Button Height="32" Width="32" 
                   Margin="20,10,20,10"
                   Click="Button_Cancel">
                <Image Source="{StaticResource CANCEL}"></Image>
            </Button>

        </StackPanel>
    </DockPanel>
</Fluent:RibbonWindow>
