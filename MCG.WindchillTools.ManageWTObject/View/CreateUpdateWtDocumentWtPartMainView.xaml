                    <Style TargetType="{x:Type Image}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentDataContext.CurrentWtObject.LinkStatus}" Value="{x:Static MCGLib:ObjectState.LINKED}">
                                <Setter Property="Source" Value="{StaticResource LINKED}" />
                                <Setter Property="ToolTip" Value="{DynamicResource MWT_ToolTipLinked}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentDataContext.CurrentWtObject.LinkStatus}" Value="{x:Static MCGLib:ObjectState.UNLINKED}">
                                <Setter Property="Source" Value="{StaticResource UNLINKED}" />
                                <Setter Property="ToolTip" Value="{DynamicResource MWT_ToolTipUnlinked}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>

        </Grid>

    </DockPanel>
</Fluent:RibbonWindow>
