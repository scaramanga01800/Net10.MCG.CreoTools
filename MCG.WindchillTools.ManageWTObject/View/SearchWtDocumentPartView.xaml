<Fluent:RibbonWindow x:Class="MCG.WindchillTools.ManageWTObject.View.SearchWtDocumentPartView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.WindchillTools.ManageWTObject.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     mc:Ignorable="d"
                     Title="SearchWtDocumentPartView" 
                     MinHeight="450" MinWidth="700"
                     Height="450" Width="700">
    <Fluent:RibbonWindow.Resources>
        <BitmapImage x:Key="Close" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/cross.ico" />
        <BitmapImage x:Key="Check" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico" />
    </Fluent:RibbonWindow.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" 
                       Name="StackPanelButton" 
                       Orientation="Horizontal" 
                       HorizontalAlignment="Center" 
                       Height="32" 
                       Margin="0,2">
            <Button ToolTip="{Binding BtOkValue, FallbackValue=OK}"
                       Click="Button_Click"
                       Command="{Binding CommandSearchOk}">
                <Image   Source="{StaticResource Check}"></Image>
            </Button>
            <Rectangle Width="50"></Rectangle>
            <Button  ToolTip="{Binding BtCancelValue, FallbackValue=Cancel}"
                        Click="Button_Click"
                        Command="{Binding CommandSearchCancel}">
                <Image   Source="{StaticResource Close}"></Image>
            </Button>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition ></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid Background="AliceBlue">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Fluent:TwoLineLabel Text="{DynamicResource MWT_LabelWtDocument}"  
                                    HasTwoLines="False"
                                    FontSize="20"
                                    HorizontalAlignment="Center"></Fluent:TwoLineLabel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto"
                             Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding CurrentDataContext.ListSearchWtDocument}"
                                 Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate >
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <RadioButton IsChecked="{Binding IsSelected}" 
                                                Margin="5,0" 
                                                GroupName="WtDoc" 
                                                VerticalAlignment="Center"></RadioButton>
                                    <TextBlock Text="{Binding Number}" 
                                              Margin="5,0" 
                                              Width="130" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding Name}" 
                                              Margin="5,0" 
                                              Width="130" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding Revision}" 
                                              Margin="5,0" 
                                              Width="20" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding State.Display}" 
                                              Margin="5,0" 
                                              VerticalAlignment="Center"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Grid Grid.Column="1" 
                 Background="#FFF1FFF1">
                <Grid.RowDefinitions >
                    <RowDefinition Height="30"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Fluent:TwoLineLabel Text="{DynamicResource MWT_LabelWtPart}"  
                                    HasTwoLines="False"
                                    FontSize="20"
                                    HorizontalAlignment="Center"></Fluent:TwoLineLabel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                             HorizontalScrollBarVisibility="Auto"
                             Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding CurrentDataContext.ListSearchWtPart}"
                                 Margin="10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate >
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <RadioButton IsChecked="{Binding IsSelected}" 
                                                Margin="5,0" 
                                                GroupName="WtPart" 
                                                VerticalAlignment="Center"></RadioButton>
                                    <TextBlock Text="{Binding Number}" 
                                              Margin="5,0" 
                                              Width="130" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding Name}" 
                                              Margin="5,0" 
                                              Width="130" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding Revision}" 
                                              Margin="5,0" 
                                              Width="20" 
                                              VerticalAlignment="Center"></TextBlock>
                                    <TextBlock Text="{Binding State.Display}" 
                                              Margin="5,0" 
                                              VerticalAlignment="Center"></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

    </DockPanel>
</Fluent:RibbonWindow>
