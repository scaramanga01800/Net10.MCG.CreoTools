<UserControl x:Class="MCG.CREO_Tools.ProfileApp.View.ProfileFluentTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.ProfileApp.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="CLASS" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_SubClass.ico" />
            <BitmapImage x:Key="Edit" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Edit.ico"  />
            <BitmapImage x:Key="Duplicate" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/duplicate2.ico"  />
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToVisibilityConverter x:Key="BoolConv"/>
            <conv:ByteToBitmapSourceConverter x:Key="ImageConverter"></conv:ByteToBitmapSourceConverter>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Image Stretch="Uniform"
           Height="150"
           DockPanel.Dock="Top"
           Source="{Binding CurrentDataContext.ProfileTypeImageFromDb,  Converter={StaticResource ImageConverter} }"/>

        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="First item"
                              Margin="5,0,0,0"
                              Content="{DynamicResource APR_StatusBarText}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="Second item"
                              Margin="5,0,0,0"
                              Content="{Binding CurrentDataContext.ListProfileShown.Count, FallbackValue=0}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>

        <DataGrid ItemsSource="{Binding CurrentDataContext.ListProfileShown}" 
              SelectedItem="{Binding CurrentDataContext.SelectedItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
              AutoGenerateColumns="False" 
              SelectionMode="Single" 
              IsReadOnly="True" 
              CanUserSortColumns="True">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StandardType}" Value="TYPE1">
                            <Setter Property="Background" Value="LightGreen"/>
                            <Setter Property="ToolTip" Value="{DynamicResource APR_ToolTipStdType1}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StandardType}" Value="TYPE2">
                            <Setter Property="Background" Value="LightYellow"/>
                            <Setter Property="ToolTip" Value="{DynamicResource APR_ToolTipStdType2}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StandardType}" Value="TYPE3">
                            <Setter Property="Background" Value="LightPink"/>
                            <Setter Property="ToolTip" Value="{DynamicResource APR_ToolTipStdType3}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StandardTypes}" Value="TYPE4">
                            <Setter Property="Background" Value="LightBlue"/>
                            <Setter Property="ToolTip" Value="{DynamicResource APR_ToolTipStdType4}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.ContextMenu>
                <Fluent:ContextMenu x:Name="CmCheckedPart" >
                    <Fluent:MenuItem Command="{Binding CommandEditProfile}" 
                                 Header="{DynamicResource APR_MiEditPartNumber}"
                                 Visibility="{Binding CurrentDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv}}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Edit}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem Command="{Binding CommandAddNewProfile}" 
                                 CommandParameter="{StaticResource TrueValue}"
                                 Header="{DynamicResource APR_MiDuplicatePartNumber}"
                                 Visibility="{Binding CurrentDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv}}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Duplicate}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                </Fluent:ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Description}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource APR_ColHeader01}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColWidth" 
                                Binding="{Binding Width}"  
                                Visibility="{Binding Data.CurrentDataContext.CurrentProfileType.ColWidthVisibility, Converter={StaticResource BoolConv}, Source={StaticResource proxy}}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource APR_ColHeader02}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColHeiht" 
                                Binding="{Binding Height}" 
                                Visibility="{Binding Data.CurrentDataContext.CurrentProfileType.ColHeightVisibility, Converter={StaticResource BoolConv}, Source={StaticResource proxy}}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource APR_ColHeader03}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColThickness" 
                                Binding="{Binding Thickness}" 
                                Visibility="{Binding Data.CurrentDataContext.CurrentProfileType.ColThicknessVisibility, Converter={StaticResource BoolConv}, Source={StaticResource proxy}}">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource APR_ColHeader04}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
