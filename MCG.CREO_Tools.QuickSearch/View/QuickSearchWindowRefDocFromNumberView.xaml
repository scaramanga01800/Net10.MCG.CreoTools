<Window x:Class="MCG.CREO_Tools.QuickSearch.View.QuickSearchWindowRefDocFromNumberView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCG.CREO_Tools.QuickSearch.View"
        mc:Ignorable="d"
        Title="{DynamicResource QS_TitleSearchRefDoc}" 
        Height="140" 
        Width="355" 
        ResizeMode="NoResize" 
        Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Reference_document.ico">

    <Window.Resources>
        <BitmapImage x:Key="OPEN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/document_open.gif" />
        <BitmapImage x:Key="Close" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
        <BitmapImage x:Key="Search" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Search_32x32.png" />
    </Window.Resources>

    <StackPanel>
        <Grid Height="32" Background="#FFC9C9CA" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="203"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Content="{DynamicResource QS_LabelNumber}"/>
            <TextBox Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Text="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></TextBox>
        </Grid>
        <Grid Height="32" Background="#FFC9C9CA" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="157"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="14" Content="{DynamicResource QS_LabelRefDoc}"/>
            <TextBox Grid.Column="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15" Text="{Binding RefDocNumber, FallbackValue=Unknown}" Background="#FFE8E8E8" ></TextBox>
            <Button Name="BtOpen" Grid.Column="2" IsEnabled="{Binding IsRefDocFound,FallbackValue=false}" Command="{Binding CommandOpenRefDoc}" ToolTip="{DynamicResource QS_ToolTipOpenRefDoc}">
                <Image Source="{StaticResource OPEN}"/>
            </Button>
        </Grid>
        <StackPanel Name="StackPanelButton"  DockPanel.Dock="Bottom"  Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Height="32" Margin="0,2" Width="{Binding ActualWindowWidth,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}">
            <Button Name="BtSearch" Grid.Column="0" FontSize="14" ToolTip="{DynamicResource QS_BtSearchRefDoc}" Command="{Binding CommandSearchRefDoc}">
                <Image   Source="{StaticResource ResourceKey=Search}"></Image>
            </Button>
            <Rectangle Width="50"></Rectangle>
            <Button Name="BtCancel" Grid.Column="1" FontSize="14" ToolTip="{DynamicResource QS_BtCancel}" Command="{Binding CommandClose}">
                <Image   Source="{StaticResource ResourceKey=Close}"></Image>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
