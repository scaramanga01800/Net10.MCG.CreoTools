<UserControl x:Class="MCG.CREO_Tools.QuickSearch.View.QuickSearchShortCut"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.QuickSearch.View"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="200">

    <UserControl.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="DELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <BitmapImage x:Key="UP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Stock Index Up_16x16.png" />
            <BitmapImage x:Key="DOWN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Stock Index Down_16x16.png" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Width="200">
        <Button Height="32" Width="168" Command="{Binding MainApp.CommandShortCutClassSubClass}" CommandParameter="{Binding}">
            <StackPanel>
                <TextBlock TextAlignment="Center" FontSize="11" Text="{Binding Class, FallbackValue=CLASS}"></TextBlock>
                <TextBlock TextAlignment="Center" FontSize="10" Text="{Binding SubClass, FallbackValue=SUB-CLASS}"></TextBlock>
            </StackPanel>
            <Button.ToolTip>
                <StackPanel>
                    <TextBlock TextAlignment="Center" Text="{Binding Class, FallbackValue=CLASS}"></TextBlock>
                    <TextBlock TextAlignment="Center"  Text="{Binding SubClass, FallbackValue=SUB-CLASS}"></TextBlock>
                </StackPanel>
            </Button.ToolTip>
        </Button>
        <StackPanel Orientation="Vertical" Height="32" >
            <Button Height="16" Command="{Binding MainApp.CommandShortCutDelete}" CommandParameter="{Binding}">
                <Image Source="{StaticResource DELETE}" ></Image>
            </Button>
            <StackPanel Orientation="Horizontal" Height="16">
                <Button Command="{Binding MainApp.CommandShortCutReOrderUp}" CommandParameter="{Binding}">
                    <Image Source="{StaticResource UP}"></Image>
                </Button>
                <Button Command="{Binding MainApp.CommandShortCutReOrderDown}" CommandParameter="{Binding}">
                    <Image Source="{StaticResource DOWN}"></Image>
                </Button>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
