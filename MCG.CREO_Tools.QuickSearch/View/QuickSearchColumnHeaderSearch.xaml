<UserControl x:Class="MCG.CREO_Tools.QuickSearch.View.QuickSearchColumnHeaderSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.QuickSearch.View"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300" MinWidth="{Binding MinWidth,FallbackValue=30}">
    
    <StackPanel Orientation="Vertical">
        <Label Grid.Row="0" 
               HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center" 
               Height="25" 
               FontSize="12" 
               Content="{Binding AttributeName,FallbackValue='Attribute Name'}" Background="#FFC9C9CA"/>
        <TextBox x:Name="TbValue" 
                 Grid.Row="1" 
                 Text="{Binding RefObject.FilterValue, FallbackValue=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                 FontSize="12"  
                 HorizontalContentAlignment="Center" 
                 VerticalContentAlignment="Center" >
            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="KeyUp" >
                    <behaviors:InvokeCommandAction Command="{Binding DataContextCommand.CommandSearchColumnKeyWord}" 
                                                   CommandParameter="{Binding RefObject}"/>
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
        </TextBox>
    </StackPanel>
</UserControl>
