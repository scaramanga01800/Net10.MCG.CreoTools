<UserControl x:Class="MCG.CREO_Tools.QuickSearch.View.QuickSearchFluentTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.QuickSearch.View"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BitmapImage x:Key="Class" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_class.ico"  />
        <BitmapImage x:Key="SubClass" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_subclass.ico"  />
        <BitmapImage x:Key="MainPicture" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Fastener01.jpg" />
        <BitmapImage x:Key="RefDoc" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Reference_document.ico"  />
        <BitmapImage x:Key="NotFound" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/not_found.jpg" />
        <BitmapImage x:Key="Parts" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/exec.ico" />
        <BitmapImage x:Key="Copy" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/page_copy.png" />
        <BitmapImage x:Key="Open" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/open.ico"  />
        <BitmapImage x:Key="Add" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/add_assembly.png"  />
        <BitmapImage x:Key="Edit" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Edit.ico"  />
        <BitmapImage x:Key="Duplicate" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/duplicate2.ico"  />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv2"></conv:BoolToVisibilityConverter>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"></conv:InverseBoolToVisibilityConverter>
        <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>
        <conv:ByteToBitmapSourceConverter x:Key="ImageConverter"></conv:ByteToBitmapSourceConverter>
        <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel Orientation="Horizontal" 
                DockPanel.Dock="Top" 
                Margin="2">
            <Grid x:Name="GridPart">
                <Border BorderThickness="2" 
                    BorderBrush="Gray"  
                    CornerRadius="0,0,0,0" 
                    Margin="5,0,30,0">
                    <StackPanel Orientation="Vertical" 
                            PreviewMouseWheel="StackPanel_PreviewMouseWheel">
                        <Image Margin="2" 
                           x:Name="ImageParts" 
                           Grid.Column="1" 
                           Stretch="Fill"
                           Height="{Binding Path=Value, ElementName=SliderImage}"
                           Source="{Binding CurrentQuickSearchDataContext.SelectedSubClassItem.CurrentPartSubClass.SUBCLASSPICTUREBIN, Converter={StaticResource ImageConverter}, FallbackValue={StaticResource ResourceKey=MainPicture}}"/>
                        <Slider x:Name="SliderImage"
                            Minimum="100"
                            Maximum="400"
                            Value="200" ></Slider>
                    </StackPanel>
                </Border>
                <Grid x:Name="GridPictureExtraComponent" 
                  Margin="5,0,30,0"
                  Opacity="0.9" 
                  Visibility="{Binding CurrentQuickSearchDataContext.IsExtraComponentShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=Collapsed}"  >
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0,0" MappingMode="RelativeToBoundingBox" StartPoint="1,1">
                            <GradientStop Color="#FFD4D4D4" Offset="0"/>
                            <GradientStop Color="Black"  Offset="0.5"/>
                            <GradientStop Color="#FFD4D4D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>

                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="Visibility" Value="Visible">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                From="0.0" To=".9" Duration="0:0:0.5"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                 </Grid>
                <Grid Height="{Binding Path=ActualHeight, ElementName=ImageParts}"
                  Width="{Binding Path=ActualWidth, ElementName=ImageParts}">
                    <Image  x:Name="PictureExtraComponent"
                        Margin="0,0,25,0"
                        Source="{Binding CurrentQuickSearchDataContext.ExtraPictureShown}" 
                        Visibility="{Binding CurrentQuickSearchDataContext.IsExtraComponentShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=Collapsed}"/>
                </Grid>
                <Image  Margin="2"
                    Stretch="Uniform"
                    Height="{Binding Path=ActualHeight, ElementName=ImageParts}"
                    Width="{Binding Path=ActualWidth, ElementName=ImageParts}"
                    Source="{Binding CurrentQuickSearchDataContext.PartPictureShown, FallbackValue={StaticResource ResourceKey=NotFound}}" 
                    Visibility="{Binding CurrentQuickSearchDataContext.IsPartPictureShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=Collapsed}"/>
            </Grid>
            <StackPanel VerticalAlignment="Center" >
                <StackPanel Height="32" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Image Source="{StaticResource Class}"></Image>
                    <Fluent:TwoLineLabel Margin="10,0,0,0" 
                                     Text="{Binding CurrentQuickSearchDataContext.SelectedClassItem, Mode=OneWay}" 
                                     HasTwoLines="False"></Fluent:TwoLineLabel>
                </StackPanel>
                <StackPanel Height="32" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                    <Image Source="{StaticResource SubClass}"></Image>
                    <Fluent:TwoLineLabel Margin="10,0,0,0" 
                                     Text="{Binding CurrentQuickSearchDataContext.SelectedSubClassItem, Mode=OneWay}"
                                     HasTwoLines="False"></Fluent:TwoLineLabel>
                </StackPanel>
                <StackPanel Height="32" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0">
                    <Image Source="{StaticResource RefDoc}"></Image>
                    <Fluent:TwoLineLabel Margin="10,0,0,0" 
                                     Text="{Binding CurrentQuickSearchDataContext.RefDocument, Mode=OneWay}"
                                     HasTwoLines="False"
                                     Visibility="{Binding CurrentQuickSearchDataContext.IsRefDocHtmlLink, Converter={StaticResource InverseBoolToVisibilityConverter}}"></Fluent:TwoLineLabel>
                    <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding CurrentQuickSearchDataContext.IsRefDocHtmlLink, Converter={StaticResource BoolToVisibilityConv}}">
                    <Hyperlink NavigateUri="{Binding CurrentQuickSearchDataContext.RefDocument}"
                               Command="{Binding CommandOpenRefDocumentFromLink}">
                        <Run Text="{Binding CurrentQuickSearchDataContext.RefDocument, Mode=OneWay}" />
                    </Hyperlink>
                    </TextBlock>
                </StackPanel>

            </StackPanel>
        </StackPanel>
        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem HorizontalAlignment="Left"
                              Value="{DynamicResource QS_StatusBarMsg}"
                              Margin="10,0,10,0">
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem HorizontalAlignment="Left"
                              Value="{Binding CurrentQuickSearchDataContext.ListPartItemShown.Count, Mode=OneWay, StringFormat= \{0\}}"
                              Margin="0,0,10,0">
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem HorizontalAlignment="Left"
                              Value="{DynamicResource QS_StatusBarMsgSapSearch}" Visibility="{Binding CurrentQuickSearchDataContext.IsMsgSearchSap, Converter={StaticResource BoolToVisibilityConv}}">
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>
        <DataGrid Name="DgPart" AutoGenerateColumns="False" ItemsSource="{Binding CurrentQuickSearchDataContext.ListPartItemShown}" 
              SelectedItem="{Binding CurrentQuickSearchDataContext.SelectedPartItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
              IsReadOnly="True"  FrozenColumnCount="1" >
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <StackPanel Orientation="Vertical">
                                <Label Content="{DynamicResource QS_DgToolTipRecommended}"></Label>
                                <Image Source="{Binding CurrentPart.PARTPICTUREBIN}" MaxHeight="250"></Image>
                            </StackPanel>
                        </Setter.Value>
                    </Setter>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PlantVolume}" Value="0">
                            <Setter Property="Background" Value="DarkGray"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <StackPanel Orientation="Vertical">
                                        <Label Content="{DynamicResource QS_DgToolTipNotRecommended}"></Label>
                                        <Image Source="{Binding CurrentPart.PARTPICTUREBIN}" MaxHeight="250"></Image>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PlantMaxVolume}" Value="None">
                            <Setter Property="Background" Value="Gray"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <StackPanel Orientation="Vertical">
                                        <Label Content="{DynamicResource QS_DgToolTipNotRecommended2}"></Label>
                                        <Image Source="{Binding CurrentPart.PARTPICTUREBIN}"  MaxHeight="250"></Image>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Data.CurrentQuickSearchDataContext.IsMsgSearchSap, Source={StaticResource proxy}}" Value="True">
                            <Setter Property="Background" Value="LightGray"/>
                            <Setter Property="ToolTip">
                                <Setter.Value>
                                    <StackPanel Orientation="Vertical">
                                        <Label Content="{DynamicResource QS_DgToolTipSapSearch}"></Label>
                                        <Image Source="{Binding CurrentPart.PARTPICTUREBIN}"  MaxHeight="250"></Image>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.ContextMenu>
                <Fluent:ContextMenu x:Name="ExtraCompMenu"  Visibility="{Binding CurrentQuickSearchDataContext.SelectedPartItem, Converter={StaticResource SelectItemToVisibilityConv}}" IsOpen="False">

                    <Fluent:MenuItem Command="{Binding CommandEditPartNumber}" 
                                 Header="{DynamicResource QS_MiEditPartNumber}"
                                 Visibility="{Binding CurrentQuickSearchDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv2}, FallbackValue=Collapsed}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Edit}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem Command="{Binding CommandAddNewPartNumber}" 
                                 CommandParameter="{StaticResource TrueValue}"
                                 Header="{DynamicResource QS_MiDuplicatePartNumber}"
                                 Visibility="{Binding CurrentQuickSearchDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv2}, FallbackValue=Collapsed}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Duplicate}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem  IsEnabled="{Binding CurrentQuickSearchDataContext.IsCreoEnable}" Command="{Binding CommandOpenModelInCreo}" CommandParameter="{StaticResource TrueValue}" Header="{DynamicResource QS_BtOpenInCreo}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Open}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                    <Fluent:MenuItem  IsEnabled="{Binding CurrentQuickSearchDataContext.IsCreoEnable}" Command="{Binding CommandAddModelInAssembly}" CommandParameter="{StaticResource TrueValue}" Header="{DynamicResource QS_BtAddToAsm}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Add}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem x:Name="ExtraCompMainMenuItem" 
                                 ItemsSource="{Binding CurrentQuickSearchDataContext.ListExtraMenu}" 
                                 Visibility="{Binding CurrentQuickSearchDataContext.IsExtraComponentPossible, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=Collapsed}"  
                                 Header="{DynamicResource QS_MiAddExtraComp}" >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Parts}" Width="16"></Image>
                        </MenuItem.Icon>
                        <behaviors:Interaction.Triggers>
                            <behaviors:EventTrigger EventName="MouseEnter">
                                <behaviors:InvokeCommandAction Command="{Binding CommandUpdateExtraCompMenu}"></behaviors:InvokeCommandAction>
                            </behaviors:EventTrigger>
                        </behaviors:Interaction.Triggers>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem x:Name="MiOpenPartInPdm" Command="{Binding CommandOpenPartInPdm}" Header="{DynamicResource QS_MiOpenPartInPdm}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Parts}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiOpenRefDocInPdm" Command="{Binding CommandOpenRefDocInPdm}" CommandParameter="{StaticResource TrueValue}" Header="{DynamicResource QS_MiOpenRefDocInPdm}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=RefDoc}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem x:Name="MiCopyPartNumber" Command="{Binding CommandCopyPartNumber}" Header="{DynamicResource QS_MiCopyPartNumber}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Copy}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                </Fluent:ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </DockPanel>
</UserControl>
