<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.MassUpdateAttribute.View.UpdateRelationsParametersMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.MassUpdateAttribute.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                     mc:Ignorable="d"
                     Title="UpdateRelationsParametersMainView"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Update_Params.png"
                     Height="450" Width="800">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="MouseEnter">
            <behaviors:InvokeCommandAction Command="{Binding CommandUpdateActiveCadModel}"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Fluent:RibbonWindow.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="START" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Start.png"/>
            <BitmapImage x:Key="Help" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico"/>
            <BitmapImage x:Key="UPDATE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Update.png" />
            <BitmapImage x:Key="ASSEMBLY" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Assembly_32x32.png" />
            <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Part_32x32.png" />
            <BitmapImage x:Key="DRAWING" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Drawing_32x32.png" />
            <BitmapImage x:Key="UNKNOWN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Unknown.ico" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"></conv:BoolToInverseBoolConverter>
        </ResourceDictionary>
    </Fluent:RibbonWindow.Resources>

    <DockPanel>
        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="ProgressBar"                                     
                                  HorizontalAlignment="Right"
                                  Margin="0,0,5,0">
                <ProgressBar Height="18"
                             Width="250"
                             Maximum="{Binding CurrentDataContext.NbModels}" 
                             Value="{Binding CurrentDataContext.NbModelsInProgress}"
                             Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}}">
                    <ProgressBar.ToolTip>
                        <StackPanel  Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentDataContext.NbModelsInProgress}"></TextBlock>
                            <TextBlock Text="/"></TextBlock>
                            <TextBlock Text="{Binding CurrentDataContext.NbModels}"></TextBlock>
                        </StackPanel>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>
        <Fluent:Ribbon DockPanel.Dock="Top" 
                       AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem>
                <Fluent:RibbonGroupBox IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}" >
                    <Fluent:Button Command="{Binding CommandReadAndUpdateCadDocument}"
                                   Header="{DynamicResource MUA_BtStartUpdate}"
                                   LargeIcon="{StaticResource UPDATE}"
                                   IsEnabled="{Binding CurrentDataContext.IsCreoConnected}"
                                   Margin="5,0,5,0">
                    </Fluent:Button>

                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,5,0,0">
                        <Fluent:RadioButton GroupName="UpdateType"
                                            Header="{DynamicResource MUA_RbUpperLevel}"
                                            IsChecked="{Binding CurrentDataContext.IsUpperLevelSelected, Mode=TwoWay}"
                                            Margin="0,0,10,0"/>
                        <Fluent:RadioButton GroupName="UpdateType"
                                            Header="{DynamicResource MUA_RbOneLevel}"
                                            IsChecked="{Binding CurrentDataContext.IsOneLevelSelected, Mode=TwoWay}"
                                            Margin="0,0,10,0"/>
                        <Fluent:RadioButton GroupName="UpdateType"
                                            Header="{DynamicResource MUA_RbAllLevels}"
                                            IsChecked="{Binding CurrentDataContext.IsAllLevelsSelected, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0" Height="32">
                        <Image Margin="0,0,10,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{StaticResource UNKNOWN}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CadDocType}" Value="PRT">
                                            <Setter Property="Source" Value="{StaticResource PART}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CadDocType}" Value="ASM">
                                            <Setter Property="Source" Value="{StaticResource ASSEMBLY}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CadDocType}" Value="DRW">
                                            <Setter Property="Source" Value="{StaticResource DRAWING}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding CurrentDataContext.ActiveModelFileName, FallbackValue=Assembly}"
                                   VerticalAlignment="Center"></TextBlock>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>
        <DataGrid CanUserAddRows="False"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding CurrentDataContext.ListItem}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource MUA_Column_Number}" 
                                    Binding="{Binding Number}" 
                                    IsReadOnly="True"/>
                <DataGridTextColumn Header="{DynamicResource MUA_Column_Comment}" 
                                    Binding="{Binding Comment}"
                                    IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Fluent:RibbonWindow>
