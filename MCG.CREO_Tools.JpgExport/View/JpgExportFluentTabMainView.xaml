<Fluent:RibbonTabItem x:Class="MCG.CREO_Tools.JpgExport.View.JpgExportFluentTabMainView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.CREO_Tools.JpgExport.View"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      xmlns:Fluent="urn:fluent-ribbon"
                      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                      mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="800"
                      Header="{DynamicResource JPG_AppName}">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="KeyDown">
            <behaviors:InvokeCommandAction Command="{Binding CommandPaste}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConv"></conv:InverseBoolConverter>
            <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>
            <BitmapImage x:Key="FOLDER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_class.ico" />
            <BitmapImage x:Key="FILE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/configuration_settings.ico" />
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
            <BitmapImage x:Key="START" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Start.png" />
            <BitmapImage x:Key="VIEW" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/View_20x20.png" />
            <BitmapImage x:Key="STYLE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Style_20x20.png" />
            <BitmapImage x:Key="DPI" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Image.ico" />
            <BitmapImage x:Key="COLOR_BW" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Color_bw.ico"/>
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox Header="{DynamicResource JPG_RibGrpFileFolder}" 
                           IsEnabled="{Binding CurrentJpgExportDataContext.ActionInProgress, Converter={StaticResource InverseBoolConv}}">
        <Fluent:Button Header="{DynamicResource JPG_LabelExportFolder}"
                       LargeIcon="{StaticResource FOLDER}"
                       Command="{Binding CommandOpenFolder}"></Fluent:Button>
        <Fluent:Button Header="{DynamicResource JPG_LabelExportFile}"
                       LargeIcon="{StaticResource FILE}"
                       Command="{Binding CommandOpenFile}"></Fluent:Button>

        <Fluent:ToggleButton Header="{DynamicResource JPG_BtRemoveColor}"
                             IsChecked="{Binding CurrentJpgExportDataContext.IsRemoveColor}"
                             Margin="5,0,5,0"
                             LargeIcon="{StaticResource COLOR_BW}">
        </Fluent:ToggleButton>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource JPG_RibGrpSettings}" 
                           IsEnabled="{Binding CurrentJpgExportDataContext.ActionInProgress, Converter={StaticResource InverseBoolConv}}">
        <StackPanel Orientation="Horizontal">
            <Image Height="20" Source="{StaticResource VIEW}"/>
            <Fluent:ComboBox ItemsSource="{Binding CurrentJpgExportDataContext.ListView3D}"
                             Width="180"
                             IsEditable="False"
                             SelectedItem="{Binding CurrentJpgExportDataContext.SelectedView3D, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                <Fluent:ComboBox.ToolTip>
                    <Fluent:ScreenTip Title="{DynamicResource JPG_LabelView}" 
                                      Width ="250"
                                      Image="{StaticResource VIEW}"
                                      Text="{DynamicResource JPG_TextView}"/>
                </Fluent:ComboBox.ToolTip>
            </Fluent:ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Height="20" Source="{StaticResource STYLE}"/>
            <Fluent:ComboBox ItemsSource="{Binding CurrentJpgExportDataContext.ListDisplayStyle}"
                             Width="180"
                             IsEditable="False"
                             SelectedItem="{Binding CurrentJpgExportDataContext.SelectedDisplayStyle, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                <Fluent:ComboBox.ToolTip>
                    <Fluent:ScreenTip Title="{DynamicResource JPG_LabelDisplayStyle}" 
                                      Width ="250"
                                      Image="{StaticResource STYLE}"
                                      Text="{DynamicResource JPG_TextDisplayStyle}"/>
                </Fluent:ComboBox.ToolTip>
            </Fluent:ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Image Height="20" Source="{StaticResource DPI}"/>
            <Fluent:ComboBox ItemsSource="{Binding CurrentJpgExportDataContext.ListResolution}"
                             Width="180"
                             IsEditable="False"
                             SelectedItem="{Binding CurrentJpgExportDataContext.SelectedResolution, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                <Fluent:ComboBox.ToolTip>
                    <Fluent:ScreenTip Title="{DynamicResource JPG_LabelResolution}" 
                                      Width ="250"
                                      Image="{StaticResource DPI}"
                                      Text="{DynamicResource JPG_TextResolution}"/>
                </Fluent:ComboBox.ToolTip>
            </Fluent:ComboBox>
        </StackPanel>

    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource JPG_RibGrpCreo}" 
                           IsEnabled="{Binding CurrentJpgExportDataContext.IsCreoEnable}">
        <Fluent:Button LargeIcon="{StaticResource START}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandExportJpg}"
                       IsEnabled="{Binding CurrentJpgExportDataContext.IsCreoEnable}"></Fluent:Button>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource JPG_RibGrpTools}" 
                           IsEnabled="{Binding CurrentJpgExportDataContext.ActionInProgress, Converter={StaticResource InverseBoolConv}}">
        <Fluent:Button LargeIcon="{StaticResource HELP}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandBtHelpMouseLeftButtonUpEvent}"></Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
