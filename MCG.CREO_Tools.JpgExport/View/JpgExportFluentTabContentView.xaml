<UserControl x:Class="MCG.CREO_Tools.JpgExport.View.JpgExportFluentTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.JpgExport.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:Fluent="urn:fluent-ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>

            <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/exec.ico" />
            <BitmapImage x:Key="FOLDER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_class.ico" />
            <BitmapImage x:Key="FILE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/configuration_settings.ico" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top"
                 Orientation="Horizontal">
            <Image Source="{StaticResource ResourceKey=FOLDER}" Width="32"/>
            <Fluent:TextBox Text="{Binding CurrentJpgExportDataContext.CurrentFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalContentAlignment="Center"
                         MinWidth="150"
                         MaxWidth="300"/>
            <Image Source="{StaticResource ResourceKey=FILE}" Width="32" Margin="15,0,0,0"/>
            <Fluent:TextBox Text="{Binding CurrentJpgExportDataContext.CurrentFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalContentAlignment="Center"
                         MinWidth="150"
                         MaxWidth="300"/>
        </StackPanel>

        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="First item"
                               Margin="5,0,0,0"
                               Content="{Binding CurrentJpgExportDataContext.StatusBarMessage}"
                               HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>

        <DataGrid x:Name="DataGridParts" IsReadOnly="True" ItemsSource="{Binding CurrentJpgExportDataContext.ListItems}" SelectedItem="{Binding CurrentJpgExportDataContext.SelectedItem}" AutoGenerateColumns="False">
            <DataGrid.ContextMenu>
                <Fluent:ContextMenu x:Name="OpenInCreoMenu" Visibility="{Binding CurrentJpgExportDataContext.SelectedItem, Converter={StaticResource SelectItemToVisibilityConv}}">
                    <Fluent:MenuItem Header="{DynamicResource JPG_MiOpenInCreo}" Command="{Binding CommandOpenModelInCreo}" IsEnabled="{Binding CurrentJpgExportDataContext.IsCreoEnable}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=PART}" Width="16" >
                            </Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                </Fluent:ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Number}" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource JPG_ColHeader01}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Status}" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource JPG_ColHeader02}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Comment}" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource JPG_ColHeader03}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
