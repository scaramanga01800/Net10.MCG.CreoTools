<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.MiscTools.View.SapBomExport.SapBomExportMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.SapBomExport"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:MCGLib="clr-namespace:MCG.CommonLib.Models.Enums;assembly=MCG.CommonLib"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
                     mc:Ignorable="d"
                     Title="{DynamicResource SBE_WindowTitle}" 
                     Height="650" Width="1230"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SAP_BOM_32x32.png">

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="SAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SAP_BOM_32x32.png"/>
            <BitmapImage x:Key="EXCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico"/>
            <BitmapImage x:Key="EXIT" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico"/>
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
            <BitmapImage x:Key="EXPAND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/ExpandAll.gif" />
            <BitmapImage x:Key="COLLAPSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CollapseAll.gif" />
            <ObjectDataProvider x:Key="DataRevisionEnum" 
                                MethodName="GetValues"
                                ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="MCGLib:McgRevisionSchemaEnum"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <conv:LevelConverter x:Key="levelConverter" />
            <conv:LevelConverter2 x:Key="levelConverter2" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"></conv:BoolToInverseBoolConverter>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Fluent:Ribbon DockPanel.Dock="Top" AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem>
                <Fluent:RibbonGroupBox Header="{DynamicResource SBE_GrpData}"
                                   IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <StackPanel MinWidth="120"
                            Margin="2,0,2,0">
                        <Fluent:TextBox Header="{DynamicResource SBE_LbPart}"
                                    Text="{Binding CurrentDataContext.PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        <Fluent:ComboBox Header="{DynamicResource SBE_LbPlant}"
                                     IsEditable="False"
                                     ItemsSource="{Binding CurrentDataContext.AllSapPlants}"
                                     SelectedItem="{Binding CurrentDataContext.Plant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>

                        <Fluent:ComboBox Header="{DynamicResource SBE_LbBomApplication}"
                                     IsEditable="False"
                                     ItemsSource="{Binding CurrentDataContext.AllBomApplication}"
                                     SelectedItem="{Binding CurrentDataContext.BomApplication, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text=":" />
                                        <TextBlock Text="{Binding Description}">
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </Fluent:ComboBox>
                    </StackPanel>
                    <StackPanel Margin="2,0,2,0">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                            <Fluent:TwoLineLabel Text="{DynamicResource SBE_LbValidFrom}"
                                             HasTwoLines="False"
                                             VerticalContentAlignment="Center"  
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <DatePicker Width="100" 
                                    SelectedDate="{Binding CurrentDataContext.DateValidity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                        </StackPanel>
                        <Fluent:TextBox Header="{DynamicResource SBE_LbChangeNumber}"
                                    Text="{Binding CurrentDataContext.EcoNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        <Fluent:ComboBox Header="{DynamicResource SBE_LbRevision}"
                                     IsEditable="False"
                                     ItemsSource="{Binding Source={StaticResource DataRevisionEnum}}"
                                     SelectedItem="{Binding CurrentDataContext.Revision, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>

                    </StackPanel>
                    <StackPanel Margin="2,0,2,0">
                        <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" >
                            <Fluent:TwoLineLabel Text="{DynamicResource SBE_LbValidityDatePrice}"
                                             HasTwoLines="False"
                                             VerticalContentAlignment="Center"  
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <DatePicker Width="100" 
                                    SelectedDate="{Binding CurrentDataContext.DateValidityCost,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                        </StackPanel>
                        <Fluent:CheckBox Header="{DynamicResource SBE_LbCbRequirements}"
                                     IsChecked="{Binding CurrentDataContext.Is_CB_RLT_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
                        <Fluent:CheckBox Header="{DynamicResource SBE_LbCbExplode}"
                                     IsChecked="{Binding CurrentDataContext.Is_CB_PUR_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
                    </StackPanel>
                    <StackPanel Margin="2,0,2,0">
                        <Fluent:RadioButton GroupName="BomExp"
                                        Header="{DynamicResource SBE_LbRnBomComponents}"
                                        IsChecked="{Binding CurrentDataContext.Is_RB_SC_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        Height="18"></Fluent:RadioButton>
                        <Fluent:RadioButton GroupName="BomExp"
                                        Header="{DynamicResource SBE_LbRnRoutingTimes}"
                                        IsChecked="{Binding CurrentDataContext.Is_RB_RT_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        Height="18"></Fluent:RadioButton>
                        <Fluent:RadioButton GroupName="BomExp"
                                        Header="{DynamicResource SBE_LbRnDisplayAll}"
                                        IsChecked="{Binding CurrentDataContext.Is_RB_ALL_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        Height="18"></Fluent:RadioButton>
                        <Fluent:RadioButton GroupName="BomExp"
                                        Header="{DynamicResource SBE_LbRnDisplayMulti}"
                                        IsChecked="{Binding CurrentDataContext.Is_RB_MRT_Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                        Height="18"></Fluent:RadioButton>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="{DynamicResource SBE_GrpExport}"
                                   IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <Fluent:Button   Command="{Binding CommandStartSapBomExport}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource SAP}">
                    </Fluent:Button>
                    <Fluent:Button   Command="{Binding CommandStartExportExcel}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource EXCEL}">
                    </Fluent:Button>
                    <Fluent:Button   Command="{Binding CommandOpenHelp}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource HELP}">
                    </Fluent:Button>

                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>
        <DockPanel>
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">
                    <Grid Grid.IsSharedSizeScope="True" Name="treeGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TreeView Grid.Row="0" 
                              BorderThickness="0" 
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                              ScrollViewer.CanContentScroll="True" 
                              Grid.ColumnSpan="2"
                              Margin="6,0,0,0">

                            <TreeViewItem Focusable="False">
                                <TreeViewItem.Header>
                                    <Grid Name="GridColumnAttribute">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="rowHeader1"/>
                                            <ColumnDefinition SharedSizeGroup="rowHeader2"/>
                                            <ColumnDefinition />
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[0]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[1]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[2]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[3]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[4]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[5]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[6]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[7]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[8]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[9]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[10]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[11]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[12]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[13]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[14]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[15]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[16]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[17]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[18]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[19]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[20]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[21]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[22]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[23]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[24]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[25]}"/>
                                            <ColumnDefinition MinWidth="{Binding CurrentDataContext.SizeColumns[26]}"/>
                                        </Grid.ColumnDefinitions>

                                        <DataGridColumnHeader Grid.Column="0" >
                                            <TextBlock Text="{DynamicResource SBE_LabelCol01}" Margin="5,0" ></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumnNumber}" Grid.Column="1" >
                                            <TextBlock Text="{DynamicResource SBE_LabelCol02}" Margin="5,0" ></TextBlock>
                                        </DataGridColumnHeader>
                                        <TreeViewItem Grid.Column="2">
                                            <TreeViewItem.Header>
                                                <TreeViewItem Name="treeViewItemToMeasure" Padding="0"></TreeViewItem>
                                            </TreeViewItem.Header>
                                            <TreeViewItem.Width>
                                                <MultiBinding Converter="{StaticResource levelConverter}">
                                                    <Binding Path="CurrentDataContext.MaxBomLevel"></Binding>
                                                    <Binding ElementName="treeViewItemToMeasure"  Path="ActualWidth"></Binding>
                                                </MultiBinding>
                                            </TreeViewItem.Width>
                                        </TreeViewItem>

                                        <DataGridColumnHeader Grid.Column="3" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn1}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol03}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="4" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn2}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol04}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="5" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn3}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol05}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="6" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn4}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol06}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="7" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn5}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol07}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="8" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn6}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol08}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="9" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn7}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol09}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="10" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn8}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol10}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="11" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn9}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol11}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="12" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn10}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol12}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="13" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn11}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol13}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="14" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn12}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol14}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="15" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn13}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol15}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="16" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn14}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol16}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="17" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn15}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol17}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="18" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn16}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol18}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="19" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn17}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol19}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="20" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn18}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol20}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="21" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn19}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol21}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="22" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol22}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="23" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol23}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="24" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol24}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="25" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol25}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="26" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol26}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="27" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol27}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="28" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol28}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="29" 
                                                      Command="{Binding CommandSortBom}" 
                                                      CommandParameter="{Binding CurrentDataContext.BomColumn20}">
                                            <TextBlock Text="{DynamicResource SBE_LabelCol29}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                    </Grid>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeView>


                        <TreeView Grid.Row="1" 
                          BorderThickness="0"  
                          ItemsSource="{Binding CurrentDataContext.MainStructure}" 
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                          Grid.ColumnSpan="2"
                          Margin="6,0,0,0">

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Structure}">
                                    <Grid>
                                        <Border BorderBrush="Gray" BorderThickness="1" />
                                        <Grid Name="GridComponent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="rowHeader1"/>
                                                <ColumnDefinition SharedSizeGroup="rowHeader2"/>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[0], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[1], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[2], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[3], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[4], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[5], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[6], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[7], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[8], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[9], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[10], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[11], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[12], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[13], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[14], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[15], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[16], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[17], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[18], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[19], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[20], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[21], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[22], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[23], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[24], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[25], Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentDataContext.SizeColumns[26], Source={StaticResource proxy}}"/>
                                            </Grid.ColumnDefinitions>



                                            <TextBlock Grid.Column="0" Text="{Binding Validation}" Margin="5,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" Margin="5,0" />
                                            <Rectangle Grid.Column="2" >
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource levelConverter2}">
                                                        <Binding Path="Data.CurrentDataContext.MaxBomLevel" Source="{StaticResource proxy}"></Binding>
                                                        <Binding Path="Level"></Binding>
                                                        <Binding ElementName="treeViewItemToMeasure" Path="ActualWidth"></Binding>
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>

                                            <TextBlock Grid.Column="3" Text="{Binding AssemblyIndicator}" Margin="5,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding PhamtomItem}" Margin="5,0" />
                                            <TextBlock Grid.Column="5" Text="{Binding ParentNumber}" Margin="5,0" />
                                            <TextBlock Grid.Column="6" Text="{Binding LineNumber}" Margin="5,0" />
                                            <TextBlock Grid.Column="7" Text="{Binding ItemCategory}" Margin="5,0" />
                                            <TextBlock Grid.Column="8" Text="{Binding MaterialType}" Margin="5,0" />
                                            <TextBlock Grid.Column="9" Text="{Binding Number}" Margin="5,0" />
                                            <TextBlock Grid.Column="10" Text="{Binding Description}" Margin="5,0" />
                                            <TextBlock Grid.Column="11" Text="{Binding Quantity}" Margin="5,0" />
                                            <TextBlock Grid.Column="12" Text="{Binding Unit}" Margin="5,0" />
                                            <TextBlock Grid.Column="13" Text="{Binding ProcurementType}" Margin="5,0" />
                                            <TextBlock Grid.Column="14" Text="{Binding SpecialProcurement}" Margin="5,0" />
                                            <TextBlock Grid.Column="15" Text="{Binding MrpController}" Margin="5,0" />
                                            <TextBlock Grid.Column="16" Text="{Binding PreferredSupplier}" Margin="5,0" />
                                            <TextBlock Grid.Column="17" Text="{Binding Supplier}" Margin="5,0" />
                                            <TextBlock Grid.Column="18" Text="{Binding PurchasingInfoRec}" Margin="5,0" />
                                            <TextBlock Grid.Column="19" Text="{Binding MaterialGroup}" Margin="5,0" />
                                            <TextBlock Grid.Column="20" Text="{Binding MaterialGroupDescription}" Margin="5,0" />
                                            <TextBlock Grid.Column="21" Text="{Binding StandardPrice}" Margin="5,0" />
                                            <TextBlock Grid.Column="22" Text="{Binding TotalItemStdPrice}" Margin="5,0" />
                                            <TextBlock Grid.Column="23" Text="{Binding PurchasingPrice}" Margin="5,0" />
                                            <TextBlock Grid.Column="24" Text="{Binding Currency}" Margin="5,0" />
                                            <TextBlock Grid.Column="25" Text="{Binding PriceUnit}" Margin="5,0" />
                                            <TextBlock Grid.Column="26" Text="{Binding QualInspGrp}" Margin="5,0" />
                                            <TextBlock Grid.Column="27" Text="{Binding QualityValidation}" Margin="5,0" />
                                            <TextBlock Grid.Column="28" Text="{Binding SerialNoProfil}" Margin="5,0" />
                                            <TextBlock Grid.Column="29" Text="{Binding Agreement}" Margin="5,0" />
                                        </Grid>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <ToggleButton Command="{Binding CommandToggleExpandCollapse}" 
                                  CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                  Width="26"
                                  IsChecked="True"
                                  HorizontalAlignment="Left">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Image Source="{StaticResource COLLAPSE}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Image Source="{StaticResource EXPAND}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                    </Grid>
                </ScrollViewer>
                <Image  Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=False}" 
                        Stretch="Fill" 
                        gif:AnimationBehavior.SourceUri="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/wait.gif" 
                        ForceCursor="True" 
                        Cursor="Hand" 
                        Opacity="0.4"
                        IsHitTestVisible="False"></Image>
            </Grid>
        </DockPanel>
    </DockPanel>
</Fluent:RibbonWindow>
