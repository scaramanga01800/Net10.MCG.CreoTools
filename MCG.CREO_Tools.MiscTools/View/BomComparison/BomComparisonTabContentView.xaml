<UserControl x:Class="MCG.CREO_Tools.MiscTools.View.BomComparison.BomComparisonTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.BomComparison"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:BomComparison="clr-namespace:MCG.CommonLib.WpfComponent.View.BomComparison;assembly=MCG.CommonLib.WpfComponent"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BitmapImage x:Key="Copy" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/page_copy.png" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
    </UserControl.Resources>

    <Grid>
        <BomComparison:BomComparisonDataGridLight  x:Name="aBomComparisonDataGrid" 
                                                   DataContext="{Binding CurrentDataContext.BomComparison}">
        </BomComparison:BomComparisonDataGridLight>
    </Grid>
</UserControl>
