<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.MiscTools.View.SapBomExportAllLevel.SapBomExportAllLevelMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.SapBomExportAllLevel"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:MCGLib="clr-namespace:MCG.CommonLib.Models.Enums;assembly=MCG.CommonLib"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
                     mc:Ignorable="d"
                     Title="{DynamicResource SEA_WindowTitle}" 
                     Height="450" Width="800"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SAP_BOM_32x32.png">
    
    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="SAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SAP_BOM_32x32.png"/>
            <BitmapImage x:Key="EXCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico"/>
            <BitmapImage x:Key="EXIT" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico"/>
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
            <BitmapImage x:Key="EXPAND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/ExpandAll.gif" />
            <BitmapImage x:Key="COLLAPSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CollapseAll.gif" />
            <ObjectDataProvider x:Key="DataRevisionEnum" 
                                MethodName="GetValues"
                                ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="MCGLib:McgRevisionSchemaEnum"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <conv:LevelConverter x:Key="levelConverter" />
            <conv:LevelConverter2 x:Key="levelConverter2" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"></conv:BoolToInverseBoolConverter>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <Fluent:Ribbon DockPanel.Dock="Top" AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem>
                <Fluent:RibbonGroupBox Header="{DynamicResource SBE_GrpData}"
                                   IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <StackPanel MinWidth="120"
                            Margin="2,0,2,0">
                        <Fluent:TextBox Header="{DynamicResource SBE_LbPart}"
                                    Text="{Binding CurrentDataContext.PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        <Fluent:ComboBox Header="{DynamicResource SBE_LbPlant}"
                                     IsEditable="False"
                                     ItemsSource="{Binding CurrentDataContext.AllSapPlants}"
                                     SelectedItem="{Binding CurrentDataContext.Plant, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>
                        <Fluent:ComboBox Header="{DynamicResource SEA_LbBomUsage}"
                                     IsEditable="False"
                                     ItemsSource="{Binding CurrentDataContext.AllBomUsage}"
                                     SelectedItem="{Binding CurrentDataContext.BomUsage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>
                    </StackPanel>
                    <StackPanel MinWidth="120"
                            Margin="2,0,2,0">
                        <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                            <Fluent:TwoLineLabel Text="{DynamicResource SBE_LbValidFrom}"
                                             HasTwoLines="False"
                                             VerticalContentAlignment="Center"  
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <DatePicker Width="100" 
                                    SelectedDate="{Binding CurrentDataContext.DateValidity,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="{DynamicResource SBE_GrpExport}"
                                   IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <Fluent:Button   Command="{Binding CommandStartSapBomExport}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource SAP}">
                    </Fluent:Button>
                    <Fluent:Button   Command="{Binding CommandStartExportExcel}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource EXCEL}">
                    </Fluent:Button>
                    <Fluent:Button   Command="{Binding CommandOpenHelp}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource HELP}">
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="item 1"
                              Margin="5,0,0,0"
                              Content="{DynamicResource SEA_StatusBar01}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="item 2"
                              Margin="5,0,0,0"
                              Content="{Binding CurrentDataContext.FlatStructure.Count}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="item 3"
                              Margin="5,0,0,0"
                              Content="{DynamicResource SEA_StatusBar02}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="item 4"
                              Margin="5,0,0,0"
                              Content="{Binding CurrentDataContext.AllComponents.Count}"
                              HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="ProgressBar"                                     
                              HorizontalAlignment="Right"
                              Margin="0,0,5,0">
                <ProgressBar Height="18"
                         Width="250"
                         Maximum="{Binding CurrentDataContext.AllComponents.Count}" 
                         Value="{Binding CurrentDataContext.SapSearchIndex}"
                         Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}}"></ProgressBar>
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>

        <DockPanel>
            <Grid>
                <TabControl>
                    <TabItem Header="{DynamicResource SEA_TabMain}">
                        <DataGrid ItemsSource="{Binding CurrentDataContext.FlatStructure}" 
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol01}" Binding="{Binding Level}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol02}" Binding="{Binding Number}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol03}" Binding="{Binding LineNumber}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol04}" Binding="{Binding Description}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol05}" Binding="{Binding Revision}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol06}" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol07}" Binding="{Binding Unit}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol08}" Binding="{Binding StandardPrice}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol09}" Binding="{Binding Supplier}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol10}" Binding="{Binding PriceMass}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="{DynamicResource SEA_TabConcat}">
                        <DataGrid ItemsSource="{Binding CurrentDataContext.AllComponents}" 
                              IsReadOnly="True"
                              AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol02}" Binding="{Binding Number}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol04}" Binding="{Binding Description}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol05}" Binding="{Binding Revision}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol06}" Binding="{Binding Quantity}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol08}" Binding="{Binding StandardPrice}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol09}" Binding="{Binding Supplier}"/>
                                <DataGridTextColumn Header="{DynamicResource SEA_LabelCol10}" Binding="{Binding PriceMass}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <Image  Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=False}" 
                        Stretch="Fill" 
                        gif:AnimationBehavior.SourceUri="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/wait.gif" 
                        ForceCursor="True" 
                        Cursor="Hand" 
                        Opacity="0.4"
                        IsHitTestVisible="False"></Image>
            </Grid>
        </DockPanel>
    </DockPanel>
</Fluent:RibbonWindow>
