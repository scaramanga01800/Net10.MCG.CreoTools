<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.MiscTools.View.SimplifiedRep.SimplifiedRepMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.SimplifiedRep"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
                     mc:Ignorable="d"
                     Title="{DynamicResource SRP_WindowTitle}"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Structure.ico"
                     Height="600" Width="1000">

    <Fluent:RibbonWindow.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="START" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Start.png"/>
            <BitmapImage x:Key="NEW" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/new.ico"/>
            <BitmapImage x:Key="COPY" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/duplicate2.ico"/>
            <BitmapImage x:Key="UPDATE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Update.png"/>
            <BitmapImage x:Key="DELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico"/>
            <BitmapImage x:Key="ACTIVATE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/exec.ico"/>
            <BitmapImage x:Key="SAVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save_32x32.png"/>
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico"/>
            <BitmapImage x:Key="INCLUDE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check_green_32x32.png"/>
            <BitmapImage x:Key="EXCLUDE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/remove_32x32.png"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter"></conv:BoolToInverseBoolConverter>
        </ResourceDictionary>
    </Fluent:RibbonWindow.Resources>

    <DockPanel>
        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="ActiveModel"
                                  HorizontalAlignment="Left"
                                  Margin="5,0,0,0">
                <TextBlock Text="{Binding CurrentDataContext.ActiveModelName}" />
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="DefaultRule"
                                  HorizontalAlignment="Left"
                                  Margin="20,0,0,0">
                <TextBlock Text="{Binding CurrentDataContext.SelectedDefaultRule}" />
            </Fluent:StatusBarItem>
            <Fluent:StatusBarItem Title="ProgressBar"
                                  HorizontalAlignment="Right"
                                  Margin="0,0,5,0">
                <ProgressBar Height="18"
                             Width="250"
                             Maximum="{Binding CurrentDataContext.NbModels}"
                             Value="{Binding CurrentDataContext.NbModelsInProgress}"
                             Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}}">
                    <ProgressBar.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentDataContext.NbModelsInProgress}"></TextBlock>
                            <TextBlock Text="/"></TextBlock>
                            <TextBlock Text="{Binding CurrentDataContext.NbModels}"></TextBlock>
                        </StackPanel>
                    </ProgressBar.ToolTip>
                </ProgressBar>
            </Fluent:StatusBarItem>
        </Fluent:StatusBar>

        <Fluent:Ribbon DockPanel.Dock="Top"
                       AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem>
                <Fluent:RibbonGroupBox Header="{DynamicResource SRP_RibGrpModel}"
                                       IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <Fluent:Button Command="{Binding CommandReadAsm}"
                                   Header="{DynamicResource SRP_BtStart}"
                                   LargeIcon="{StaticResource START}"
                                   IsEnabled="{Binding CurrentDataContext.IsCreoConnected}"
                                   Margin="5,0,5,0">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_BtStart}"
                                              Text="{DynamicResource SRP_ToolTipStart}"/>
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>

                    <Fluent:Button Command="{Binding CommandSaveModel}"
                                   Header="{DynamicResource SRP_BtSave}"
                                   LargeIcon="{StaticResource SAVE}"
                                   IsEnabled="{Binding CurrentDataContext.IsAssemblyLoaded}"
                                   Margin="5,0,5,0">
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="{DynamicResource SRP_RibGrpSimpRep}"
                                       IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <Fluent:ComboBox Header="{DynamicResource SRP_SimpRepList}"
                                     Width="320"
                                     MinWidth="320"
                                     IsEnabled="{Binding CurrentDataContext.IsAssemblyLoaded}"
                                     SelectedItem="{Binding CurrentDataContext.SelectedSimpRepName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     ItemsSource="{Binding CurrentDataContext.ListSimpRepName}">
                        <Fluent:ComboBox.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_SimpRepList}"
                                              Text="{DynamicResource SRP_ToolTipSimpRepList}"/>
                        </Fluent:ComboBox.ToolTip>
                    </Fluent:ComboBox>

                    <Fluent:TextBox Header="{DynamicResource SRP_NewSimpRepName}"
                                    Width="320"
                                    MinWidth="320"
                                    IsEnabled="{Binding CurrentDataContext.IsAssemblyLoaded}"
                                    Text="{Binding CurrentDataContext.NewSimpRepName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                    </Fluent:TextBox>

                    <Fluent:ComboBox Header="{DynamicResource SRP_DefaultRule}"
                                     Width="320"
                                     MinWidth="320"
                                     IsEnabled="{Binding CurrentDataContext.IsAssemblyLoaded}"
                                     SelectedItem="{Binding CurrentDataContext.SelectedDefaultRule, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     ItemsSource="{Binding CurrentDataContext.ListDefaultRule}">
                        <Fluent:ComboBox.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_DefaultRule}"
                                              Text="{DynamicResource SRP_ToolTipDefaultRule}"/>
                        </Fluent:ComboBox.ToolTip>
                    </Fluent:ComboBox>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox Header="{DynamicResource SRP_RibGrpActions}"
                                       IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}">
                    <Fluent:Button Command="{Binding CommandCreateSimpRep}"
                                   Header="{DynamicResource SRP_BtCreate}"
                                   LargeIcon="{StaticResource NEW}"
                                   IsEnabled="{Binding CurrentDataContext.IsAssemblyLoaded}"
                                   Margin="5,0,5,0"/>

                    <Fluent:Button Command="{Binding CommandCopySimpRep}"
                                   Header="{DynamicResource SRP_BtCopy}"
                                   LargeIcon="{StaticResource COPY}"
                                   IsEnabled="{Binding CurrentDataContext.IsSimpRepSelected}"
                                   Margin="5,0,5,0"/>

                    <Fluent:Button Command="{Binding CommandUpdateSimpRep}"
                                   Header="{DynamicResource SRP_BtUpdate}"
                                   LargeIcon="{StaticResource UPDATE}"
                                   IsEnabled="{Binding CurrentDataContext.IsSimpRepSelected}"
                                   Margin="5,0,5,0"/>

                    <Fluent:Button Command="{Binding CommandActivateSimpRep}"
                                   Header="{DynamicResource SRP_BtActivate}"
                                   LargeIcon="{StaticResource ACTIVATE}"
                                   IsEnabled="{Binding CurrentDataContext.IsSimpRepSelected}"
                                   Margin="5,0,5,0"/>

                    <Fluent:Button Command="{Binding CommandDeleteSimpRep}"
                                   Header="{DynamicResource SRP_BtDelete}"
                                   LargeIcon="{StaticResource DELETE}"
                                   IsEnabled="{Binding CurrentDataContext.IsSimpRepSelected}"
                                   Margin="5,0,5,0"/>
                </Fluent:RibbonGroupBox>

                <!-- Actions appliquees d'un coup a toutes les lignes selectionnees.
                     Elles ne modifient que la grille : la mise a jour Creo reste
                     declenchee par le bouton "Mettre a jour". -->
                <Fluent:RibbonGroupBox Header="{DynamicResource SRP_RibGrpSelection}"
                                       IsEnabled="{Binding CurrentDataContext.IsMultiSelectionActive}">
                    <Fluent:Button Command="{Binding CommandIncludeSelection}"
                                   Header="{DynamicResource SRP_BtIncludeSelection}"
                                   LargeIcon="{StaticResource INCLUDE}"
                                   Margin="5,0,5,0">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_BtIncludeSelection}"
                                              Text="{DynamicResource SRP_ToolTipIncludeSelection}"/>
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>

                    <Fluent:Button Command="{Binding CommandExcludeSelection}"
                                   Header="{DynamicResource SRP_BtExcludeSelection}"
                                   LargeIcon="{StaticResource EXCLUDE}"
                                   Margin="5,0,5,0">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_BtExcludeSelection}"
                                              Text="{DynamicResource SRP_ToolTipExcludeSelection}"/>
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>

                    <Fluent:ComboBox Header="{DynamicResource SRP_CommonSimpRep}"
                                     Width="260"
                                     MinWidth="260"
                                     SelectedItem="{Binding CurrentDataContext.SelectedCommonSimpRep, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     ItemsSource="{Binding CurrentDataContext.ListCommonSimpRep}">
                        <Fluent:ComboBox.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_CommonSimpRep}"
                                              Text="{DynamicResource SRP_ToolTipCommonSimpRep}"/>
                        </Fluent:ComboBox.ToolTip>
                    </Fluent:ComboBox>

                    <Fluent:Button Command="{Binding CommandApplyCommonSimpRep}"
                                   Header="{DynamicResource SRP_BtApplyCommonSimpRep}"
                                   Icon="{StaticResource UPDATE}"
                                   Margin="5,0,5,0">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="{DynamicResource SRP_BtApplyCommonSimpRep}"
                                              Text="{DynamicResource SRP_ToolTipApplyCommonSimpRep}"/>
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox>
                    <Fluent:Button LargeIcon="{StaticResource HELP}"
                                   Command="{Binding CommandOpenHelp}"
                                   Margin="5,0,5,0" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Grid>
            <DataGrid x:Name="DgComponents"
                      CanUserAddRows="False"
                      AutoGenerateColumns="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      SelectionChanged="DgComponents_SelectionChanged"
                      ItemsSource="{Binding CurrentDataContext.ListItem}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource SRP_Column_Index}"
                                        Binding="{Binding TreeIndex}"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource SRP_Column_Name}"
                                        Binding="{Binding Name}"
                                        Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource SRP_Column_Rep}"
                                        Binding="{Binding Rep}"
                                        Width="80"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="{DynamicResource SRP_Column_Description}"
                                        Binding="{Binding Description}"
                                        Width="2*"
                                        IsReadOnly="True"/>
                    <!-- Colonne "Inclus" en template : la case reagit des le premier clic,
                         sans passer par le mode edition du DataGrid. -->
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.Header>
                            <CheckBox Content="{DynamicResource SRP_Column_Included}"
                                      IsChecked="{Binding DataContext.CurrentDataContext.IsAllIncluded,
                                                          RelativeSource={RelativeSource AncestorType=Window},
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{DynamicResource SRP_ToolTipSelectAll}" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource SRP_Column_Action}"
                                        Binding="{Binding CurrentAction}"
                                        IsReadOnly="True"/>
                    <!-- Colonne en template : la liste est utilisable des le premier clic et
                         met immediatement a jour la colonne "Action". -->
                    <DataGridTemplateColumn Header="{DynamicResource SRP_Column_UserDefined}"
                                            Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding ListComponentSimpRep}"
                                          SelectedItem="{Binding SelectedComponentSimpRep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False"
                                          BorderThickness="0"
                                          Background="Transparent" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Image Visibility="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToVisibilityConv}, FallbackValue=False}"
                   Stretch="Fill"
                   gif:AnimationBehavior.SourceUri="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/wait.gif"
                   ForceCursor="True"
                   Cursor="Hand"
                   Opacity="0.4"
                   IsHitTestVisible="False"></Image>
        </Grid>
    </DockPanel>
</Fluent:RibbonWindow>
