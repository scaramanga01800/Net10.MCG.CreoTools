<UserControl x:Class="MCG.CREO_Tools.MiscTools.View.BomExport.BomExportTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.BomExport"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:Fluent="urn:fluent-ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BitmapImage x:Key="Copy" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/page_copy.png" />
        <BitmapImage x:Key="DRAWING" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/pdf.ico"  />
        <BitmapImage x:Key="REMOVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Remove.gif"  />
        <BitmapImage x:Key="EXPAND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/ExpandAll.gif" />
        <BitmapImage x:Key="COLLAPSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CollapseAll.gif" />
        <conv:LevelConverter x:Key="levelConverter" />
        <conv:LevelConverter2 x:Key="levelConverter2" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
        <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
    </UserControl.Resources>

    <DockPanel>
        <Fluent:StatusBar DockPanel.Dock="Bottom">
            <Fluent:StatusBarItem Title="First item"
                                  Margin="5,0,0,0"
                                  Content="{Binding CurrentBomExportWindowDataContext.StatusBarMsg}"
                                  HorizontalAlignment="Left" >
            </Fluent:StatusBarItem>
        </Fluent:StatusBar >

        <StackPanel Orientation="Horizontal" 
                    DockPanel.Dock="Top"  
                    Background="LightGray" 
                    Height="20"
                    Visibility="{Binding CurrentBomExportWindowDataContext.ShowSapCostVolumeInfo, Converter={StaticResource BoolToVisibilityConv}  }">
            <TextBlock Text="{DynamicResource BCE_LabelSapCost}" Margin="20,0,0,0" ></TextBlock>
            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.MainSapCost}" Margin="2,0,0,0"></TextBlock>
            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.SelectedSapPlant.CurrencySymbol}" Margin="2,0,0,0"></TextBlock>
            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.MainSapProvider,StringFormat= - ({0})}"></TextBlock>
        </StackPanel>
        <TabControl>
            <TabItem Header="{DynamicResource BCE_TabMain}">
                <ScrollViewer Name="ScrollHori" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto">

                    <Grid Grid.IsSharedSizeScope="True" Name="treeGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                        </Grid.RowDefinitions>


                        <TreeView Grid.Row="0" 
                                  BorderThickness="0" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                  ScrollViewer.CanContentScroll="True" 
                                  Grid.ColumnSpan="2"
                                  Margin="5,0,0,0">

                            <TreeViewItem Focusable="False">
                                <TreeViewItem.Header>
                                    <Grid Name="GridColumnAttribute">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition SharedSizeGroup="rowHeader1"/>
                                            <ColumnDefinition SharedSizeGroup="rowHeader2"/>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn1.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn2.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn3.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn4.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn5.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn6.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn7.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn8.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn9.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn10.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn11.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn12.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn13.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn14.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn15.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn16.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn17.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn18.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn19.Width}"/>
                                            <ColumnDefinition Width="{Binding CurrentBomExportWindowDataContext.BomColumn20.Width}"/>
                                        </Grid.ColumnDefinitions>

                                        <DataGridColumnHeader Grid.Column="0" >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumnLevel}" Margin="5,0" ></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumnNumber}" Grid.Column="1" >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumnNumber}" Margin="5,0" ></TextBlock>
                                        </DataGridColumnHeader>
                                        <TreeViewItem Grid.Column="2">
                                            <TreeViewItem.Header>
                                                <TreeViewItem Name="treeViewItemToMeasure" Padding="0"></TreeViewItem>
                                            </TreeViewItem.Header>
                                            <TreeViewItem.Width>
                                                <MultiBinding Converter="{StaticResource levelConverter}">
                                                    <Binding Path="CurrentBomExportWindowDataContext.MaxBomLevel"></Binding>
                                                    <Binding ElementName="treeViewItemToMeasure"  Path="ActualWidth"></Binding>
                                                </MultiBinding>
                                            </TreeViewItem.Width>
                                        </TreeViewItem>


                                        <DataGridColumnHeader Grid.Column="3" Command="{Binding CommandSortBom}" 
                                                              CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn1}"  
                                                              Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn1.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn1}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="4" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn2}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn2.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn2}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="5" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn3}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn3.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"   >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn3}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="6" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn4}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn4.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn4}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="7" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn5}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn5.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"   >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn5}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="8" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn6}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn6.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn6}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="9" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn7}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn7.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn7}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="10" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn8}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn8.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn8}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="11" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn9}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn9.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn9}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="12" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn10}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn10.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn10}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="13" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn11}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn11.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn11}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="14" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn12}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn12.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn12}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="15" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn13}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn13.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn13}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="16" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn14}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn14.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn14}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="17" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn15}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn15.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn15}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="18" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn16}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn16.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn16}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="19" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn17}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn17.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn17}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="20" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn18}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn18.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn18}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="21" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn19}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn19.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn19}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                        <DataGridColumnHeader Grid.Column="22" Command="{Binding CommandSortBom}" CommandParameter="{Binding CurrentBomExportWindowDataContext.BomColumn20}" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn20.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}"  >
                                            <TextBlock Text="{Binding CurrentBomExportWindowDataContext.BomColumn20}" Margin="5,0"></TextBlock>
                                        </DataGridColumnHeader>
                                    </Grid>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeView>

                        <TreeView Grid.Row="1" 
                                  BorderThickness="0"  
                                  ItemsSource="{Binding CurrentBomExportWindowDataContext.MainBom}" 
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                                  MouseLeftButtonDown="TreeView_MouseLeftButtonDown" 
                                  Grid.ColumnSpan="2"
                                  Margin="5,0,0,0">
                            <behaviors:Interaction.Triggers>
                                <behaviors:EventTrigger EventName="SelectedItemChanged">
                                    <behaviors:InvokeCommandAction Command="{Binding CommandSelectedBomItem}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>

                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>

                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="MiCopyPartNumber" Command="{Binding CommandCopyPartNumber}" Header="{DynamicResource BCE_MiCopyPartNumber}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ResourceKey=Copy}" Width="16" ></Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding CommandDownloadDrawing}" 
                                              CommandParameter="Selected"
                                              Header="{DynamicResource BCE_MiDownloadDrawing}"
                                              Visibility="{Binding Path=CurrentBomExportWindowDataContext.IsPartChecked,Converter={StaticResource BoolToVisibilityConv}}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ResourceKey=DRAWING}" Width="16" ></Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding CommandRemoveLine}" Header="{DynamicResource BCE_MiRemoveLine}">
                                        <MenuItem.Icon>
                                            <Image Source="{StaticResource ResourceKey=REMOVE}" Width="16" ></Image>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </TreeView.ContextMenu>

                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Structure}">
                                    <Grid>
                                        <Border BorderBrush="Gray" BorderThickness="1" />
                                        <Grid Name="GridComponent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition SharedSizeGroup="rowHeader1"/>
                                                <ColumnDefinition SharedSizeGroup="rowHeader2"/>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn1.Width, Source={StaticResource proxy}}" />
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn2.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn3.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn4.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn5.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn6.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn7.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn8.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn9.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn10.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn11.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn12.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn13.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn14.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn15.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn16.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn17.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn18.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn19.Width, Source={StaticResource proxy}}"/>
                                                <ColumnDefinition Width="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn20.Width, Source={StaticResource proxy}}"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding BomLevel}" Margin="5,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Number}" Margin="5,0" />
                                            <Rectangle Grid.Column="2" >
                                                <Rectangle.Width>
                                                    <MultiBinding Converter="{StaticResource levelConverter2}">
                                                        <Binding Path="Data.CurrentBomExportWindowDataContext.MaxBomLevel" Source="{StaticResource proxy}"></Binding>
                                                        <Binding Path="BomLevel"></Binding>
                                                        <Binding ElementName="treeViewItemToMeasure" Path="ActualWidth"></Binding>
                                                    </MultiBinding>
                                                </Rectangle.Width>
                                            </Rectangle>

                                            <TextBlock Grid.Column="3" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn1.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol1}" Margin="5,0" />
                                            <TextBlock Grid.Column="4" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn2.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol2}" Margin="5,0" />
                                            <TextBlock Grid.Column="5" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn3.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol3}" Margin="5,0" />
                                            <TextBlock Grid.Column="6" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn4.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol4}" Margin="5,0" />
                                            <TextBlock Grid.Column="7" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn5.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol5}" Margin="5,0" />
                                            <TextBlock Grid.Column="8" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn6.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol6}" Margin="5,0" />
                                            <TextBlock Grid.Column="9" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn7.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol7}" Margin="5,0" />
                                            <TextBlock Grid.Column="10" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn8.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol8}" Margin="5,0" />
                                            <TextBlock Grid.Column="11" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn9.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol9}" Margin="5,0" />
                                            <TextBlock Grid.Column="12" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn10.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol10}" Margin="5,0" />
                                            <TextBlock Grid.Column="13" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn11.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol11}" Margin="5,0" />
                                            <TextBlock Grid.Column="14" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn12.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol12}" Margin="5,0" />
                                            <TextBlock Grid.Column="15" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn13.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol13}" Margin="5,0" />
                                            <TextBlock Grid.Column="16" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn14.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol14}" Margin="5,0" />
                                            <TextBlock Grid.Column="17" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn15.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol15}" Margin="5,0" />
                                            <TextBlock Grid.Column="18" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn16.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol16}" Margin="5,0" />
                                            <TextBlock Grid.Column="19" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn17.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol17}" Margin="5,0" />
                                            <TextBlock Grid.Column="20" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn18.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol18}" Margin="5,0" />
                                            <TextBlock Grid.Column="21" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn19.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol19}" Margin="5,0" />
                                            <TextBlock Grid.Column="22" Visibility="{Binding Path=Data.CurrentBomExportWindowDataContext.BomColumn20.IsVisible, Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}" Text="{Binding ValueCol20}" Margin="5,0" />
                                        </Grid>
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <ToggleButton Command="{Binding CommandToggleExpandCollapse}" 
                                      CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"
                                      Width="26"
                                      HorizontalAlignment="Left">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Image Source="{StaticResource COLLAPSE}" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <Image Source="{StaticResource EXPAND}" />
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="LightSkyBlue" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter Content="{TemplateBinding Content}" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                    </Grid>

                </ScrollViewer>
            </TabItem>
            <TabItem Header="{DynamicResource BCE_TabComponents}">
                <DataGrid ItemsSource="{Binding CurrentBomExportWindowDataContext.AllComponents}" 
                          SelectedItem="{Binding CurrentBomExportWindowDataContext.SelectedComponent, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding CommandCopyPartNumber}"
                                      CommandParameter="{Binding CurrentBomExportWindowDataContext.SelectedComponent}"
                                      Header="{DynamicResource BCE_MiCopyPartNumber}">
                                <MenuItem.Icon>
                                    <Image Source="{StaticResource ResourceKey=Copy}" Width="16" ></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Command="{Binding CommandDownloadDrawing}" 
                                      CommandParameter="Component"
                                      Header="{DynamicResource BCE_MiDownloadDrawing}"
                                      Visibility="{Binding Path=CurrentBomExportWindowDataContext.IsPartChecked,Converter={StaticResource BoolToVisibilityConv}}">
                                <MenuItem.Icon>
                                    <Image Source="{StaticResource ResourceKey=DRAWING}" Width="16" ></Image>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource BCE_ColHeader01}" Binding="{Binding Number}"/>
                        <DataGridTextColumn Header="{DynamicResource BCE_ColHeader06}" Binding="{Binding MainWindchillObject.DescriptionEn}"/>
                        <DataGridTextColumn Header="{DynamicResource BCE_ColHeader02}" Binding="{Binding MainWindchillObject.Revision}"/>
                        <DataGridTextColumn Header="{DynamicResource BCE_ColHeader11}" Binding="{Binding CumulativeQuantity}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
