<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.MiscTools.View.MechanismTool.MechanismAnalysisMainView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.MiscTools.View.MechanismTool"
                     xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="{DynamicResource MMA_WindowTitle}" 
                     Height="450" Width="800"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/chart.ico">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Closing">
            <behaviors:InvokeCommandAction Command="{Binding CommandClosing}"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="MechanismAnalysis" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/chart.ico"/>
            <BitmapImage x:Key="DRAGDROP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/drag_and_drop.png"/>
            <BitmapImage x:Key="XLS" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Start.png"/>
            <BitmapImage x:Key="LARGEDELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico"/>
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel x:Name="MainSP" 
           AllowDrop="True" 
           Drop="MainSP_Drop"
           DragEnter="MainSP_DragEnter"
           DragLeave="MainSP_DragLeave">
        <behaviors:Interaction.Triggers>
            <behaviors:EventTrigger EventName="Drop">
                <behaviors:InvokeCommandAction Command="{Binding CommandDrop}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
            </behaviors:EventTrigger>
        </behaviors:Interaction.Triggers>

        <Fluent:Ribbon DockPanel.Dock="Top" AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem>
                <Fluent:RibbonGroupBox Header="{DynamicResource MMA_RibGrpData}">
                    <Fluent:Button Command="{Binding CommandCreateExcel}" 
                               LargeIcon="{StaticResource XLS}"
                               Margin="5,0,5,0">
                    </Fluent:Button>
                    <Fluent:Button   Command="{Binding CommandRemoveAll}" 
                     Margin="5,0,5,0"
                     LargeIcon="{StaticResource LARGEDELETE}">
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="{DynamicResource MMA_RibGrpTools}">
                    <Fluent:Button LargeIcon="{StaticResource HELP}"
                               Command="{Binding CommandOpenHelp}"
                               Margin="5,0,5,0">
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Grid>
            <DataGrid ItemsSource="{Binding CurrentDataContext.ListFile}" IsReadOnly="True" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File Name" 
                                    Binding="{Binding FileName}"></DataGridTextColumn>
                    <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Image x:Name="ImageDragDrop"
               Source="{StaticResource DRAGDROP}" 
               MaxHeight="300"
               Opacity="0.5"
               Visibility="Collapsed"
               IsHitTestVisible="False"></Image>
        </Grid>
    </DockPanel>
</Fluent:RibbonWindow>
