<Fluent:RibbonTabItem x:Class="MCG.CREO_Tools.CutLengthApp.View.CutLengthMainView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.CREO_Tools.CutLengthApp.View"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      xmlns:System="clr-namespace:System;assembly=mscorlib"
                      xmlns:Fluent="urn:fluent-ribbon"
                      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                      mc:Ignorable="d"
                      Header="{DynamicResource CT_AppName}">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="MouseEnter">
            <behaviors:InvokeCommandAction Command="{Binding CommandUpdateActiveCadModel}"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="CLASS" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/folder_SubClass.ico" />
            <BitmapImage x:Key="ASSEMBLY" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Assembly_32x32.png" />
            <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Part_32x32.png" />
            <BitmapImage x:Key="BULK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Bulk_Item_32x32.png" />
            <BitmapImage x:Key="ADD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Add.ico" />
            <BitmapImage x:Key="UPDATE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Update2.ico" />
            <BitmapImage x:Key="HELP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
            <BitmapImage x:Key="Edit" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Edit.ico"  />
            <BitmapImage x:Key="AddPart" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Add.ico"  />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <conv:InverseBoolConverter x:Key="InverseBoolConv"></conv:InverseBoolConverter>
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox Header="{DynamicResource CT_RibCutLength}" 
                           IsEnabled="{Binding CurrentDataContext.ActionInProgress, Converter={StaticResource InverseBoolConv}}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Height="32" Source="{StaticResource CLASS}"></Image>
            <Fluent:ComboBox  Width="150" 
                              IsEditable="False" 
                              ItemsSource="{Binding CurrentDataContext.ListCutLengthType}" 
                              SelectedItem="{Binding CurrentDataContext.SelectedCutLengthType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,5,0,0" Height="32">
            <Image Source="{StaticResource ASSEMBLY}" Margin="0,0,10,0"></Image>
            <TextBlock Text="{Binding CurrentDataContext.ActiveModelFileName, FallbackValue=Assembly}"
                       VerticalAlignment="Center"></TextBlock>
        </StackPanel>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource CT_RibCutLength}">
        <StackPanel  HorizontalAlignment="Center" Margin="5,0,5,0">
            <Fluent:TwoLineLabel  HorizontalAlignment="Center"
                                  Text="{DynamicResource CT_LabelQuantity}"
                                  HasTwoLines="False"/>
            <Fluent:TextBox Text="{Binding CurrentDataContext.Quantity, Mode=TwoWay}"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center"
                            HorizontalAlignment="Center"
                            MinWidth="50"
                            PreviewTextInput="TbDoubleInput_PreviewTextInput"
                            Margin="-9,0,0,0"></Fluent:TextBox>
            <Fluent:TwoLineLabel HorizontalAlignment="Center"                    
                                 FontSize="20"
                                 Text="{Binding CurrentDataContext.SelectedCutLengthType.Unit,FallbackValue=m}"
                                 MinWidth="20"></Fluent:TwoLineLabel>
        </StackPanel>
        <Fluent:ToggleButton Header="{DynamicResource CT_LabelBulkItem}"
                             LargeIcon="{StaticResource BULK}"
                             IsChecked="{Binding CurrentDataContext.BulkSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="5,0,0,0"></Fluent:ToggleButton>
        <Fluent:ToggleButton Header="{DynamicResource CT_Label3DPart}"
                             LargeIcon="{StaticResource PART}"
                             IsChecked="{Binding CurrentDataContext.ThreeDSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding CurrentDataContext.ThreeDIsEnable}"
                             Margin="5,0,0,0"></Fluent:ToggleButton>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource CT_TabCREO}"
                           IsEnabled="{Binding CurrentDataContext.ActionInProgress, Converter={StaticResource InverseBoolConv}}">
        <Fluent:Button LargeIcon="{StaticResource ADD}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandInsertCutLength}"
                       IsEnabled="{Binding CurrentDataContext.IsCreoEnable}"></Fluent:Button>
        <Fluent:Button LargeIcon="{StaticResource UPDATE}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandUpdateCutLength}"
                       IsEnabled="{Binding CurrentDataContext.IsCreoEnable}"></Fluent:Button>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource CT_TabTools}">


        <Fluent:ToggleButton LargeIcon="{StaticResource Edit}" 
                             IsChecked="{Binding CurrentDataContext.IsEditMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding CurrentDataContext.IsAdminToolsEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
            <Fluent:ToggleButton.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource  CT_TitleTipEdit}" 
                          Image="{StaticResource Edit}"
                          Text="{DynamicResource  CT_TextTipEdit}"/>
            </Fluent:ToggleButton.ToolTip>
        </Fluent:ToggleButton>

        <Fluent:Button LargeIcon="{StaticResource AddPart}" 
                       Command="{Binding CommandAddNewPartNumber}" 
                       CommandParameter="{StaticResource FalseValue}"
                       Margin="2,0,2,0"
                       Visibility="{Binding CurrentDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource  CT_TitleTipAddPart}" 
                          Image="{StaticResource AddPart}"
                          Text="{DynamicResource  CT_TextTipAddPart}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource HELP}"
                       Margin="5,0,5,0"
                       Command="{Binding CommandOpenHelp}"></Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
