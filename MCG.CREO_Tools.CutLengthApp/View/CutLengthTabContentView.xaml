<UserControl x:Class="MCG.CREO_Tools.CutLengthApp.View.CutLengthTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.CREO_Tools.CutLengthApp.View"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="MouseEnter">
            <behaviors:InvokeCommandAction Command="{Binding CommandUpdateActiveCadModel}"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="CADPART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/CAD_Prt.gif" />
            <BitmapImage x:Key="Edit" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Edit.ico"  />
            <BitmapImage x:Key="Duplicate" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/duplicate2.ico"  />
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <DataGrid Name="DgPartNumber" ItemsSource="{Binding CurrentDataContext.CurrentListPartNumber}" SelectedItem="{Binding CurrentDataContext.SelectedCutLengthPart, Mode=OneWayToSource}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
            <DataGrid.ContextMenu>
                <Fluent:ContextMenu x:Name="CmCheckedPart" >
                    <Fluent:MenuItem x:Name="MiOpenTemplate" Command="{Binding CommandOpenTemplate}"   
                                  Visibility="{Binding CurrentDataContext.ThreeDIsEnable, Converter={StaticResource BoolToVisibilityConv}}"
                                  IsEnabled="{Binding CurrentDataContext.IsCreoEnable}">
                        <MenuItem.Header>
                            <TextBlock Text="{DynamicResource CT_MiOpenTemplate}"/>
                        </MenuItem.Header>
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=CADPART}"></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                    <Fluent:MenuItem Command="{Binding CommandEditPartNumber}" 
                                  Header="{DynamicResource CT_MiEditPartNumber}"
                                  Visibility="{Binding CurrentDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv}}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Edit}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>

                    <Fluent:MenuItem Command="{Binding CommandAddNewPartNumber}" 
                                  CommandParameter="{StaticResource TrueValue}"
                                  Header="{DynamicResource CT_MiDuplicatePartNumber}"
                                  Visibility="{Binding CurrentDataContext.IsEditMode, Converter={StaticResource BoolToVisibilityConv}}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Duplicate}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </Fluent:MenuItem>
                </Fluent:ContextMenu>

            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding PartNumber}"  >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CT_ColHeader01}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding PartName}"  >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource CT_ColHeader02}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
