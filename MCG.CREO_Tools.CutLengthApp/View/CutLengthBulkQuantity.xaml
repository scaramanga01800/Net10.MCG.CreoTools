<Fluent:RibbonWindow x:Class="MCG.CREO_Tools.CutLengthApp.View.CutLengthBulkQuantity"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.CREO_Tools.CutLengthApp.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="{DynamicResource CT_TitleBulkItemQty}" 
                     Height="150" Width="180"
                     Icon="{DynamicResource IconBulkItem}"
                     ResizeMode="NoResize"
                     Topmost="True">

    <Window.Resources>
        <BitmapImage x:Key="IconBulkItem" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Bulk_Item_32x32.png" />
        <BitmapImage x:Key="OK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.png" />
        <BitmapImage x:Key="CANCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Close.png" />
    </Window.Resources>

    <StackPanel HorizontalAlignment="Center">
        <TextBox Text="{Binding Quantity, Mode=TwoWay,FallbackValue=0}" 
                 Height="40"
                 FontSize="20"
                 VerticalContentAlignment="Center" 
                 HorizontalContentAlignment="Center" 
                 PreviewTextInput="TextBox_PreviewTextInput"
                 Background="{DynamicResource IdealBackgroundColor}"
                 Foreground="{DynamicResource IdealForegroundColor}"></TextBox>
        <StackPanel Orientation="Horizontal" >

            <Fluent:Button Name="BtOk" Grid.Column="0" 
                           Header="{DynamicResource CT_BtOk}" 
                           Click="BtOk_Click"
                           Width="50"
                           LargeIcon="{StaticResource OK}"></Fluent:Button>

            <Fluent:Button Name="BtCancel" Grid.Column="1" 
                           Header="{DynamicResource CT_BtCancel}" 
                           Click="BtCancel_Click"
                           Width="50"
                           LargeIcon="{StaticResource CANCEL}"></Fluent:Button>
        </StackPanel>
    </StackPanel>
</Fluent:RibbonWindow>
