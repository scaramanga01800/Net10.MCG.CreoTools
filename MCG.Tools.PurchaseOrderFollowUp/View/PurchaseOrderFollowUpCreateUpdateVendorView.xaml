<Fluent:RibbonWindow x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowUpCreateUpdateVendorView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     mc:Ignorable="d"
                     AllowDrop="True"
                     Drop="MainSP_Drop"
                     DragEnter="MainSP_DragEnter"
                     DragLeave="MainSP_DragLeave"
                     Title="{DynamicResource POF_VendorWindow}" 
                     Height="690" Width="795"
                     ResizeMode="NoResize"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Vendor.ico">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Drop">
            <behaviors:InvokeCommandAction Command="{Binding CommandDropVendor}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="DRAGDROP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/drag_and_drop.png" />
            <BitmapImage x:Key="SEND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SendVendor.ico"/>
            <BitmapImage x:Key="REMOVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/delete.ico"/>
            <BitmapImage x:Key="OPEN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Openfile.ico" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:InverseBoolToVisibilityConverter x:Key="BoolToInverseBoolConverter"></conv:InverseBoolToVisibilityConverter>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Fluent:Ribbon DockPanel.Dock="Top" 
                           AreTabHeadersVisible="False">

                <Fluent:RibbonTabItem>
                    <Fluent:RibbonGroupBox Header="{DynamicResource POF_RibGrpData}">
                        <Fluent:Button Command="{Binding CommandSendVendorRequest}"
                                       Header="{DynamicResource POF_BtSendRequest}"
                                       LargeIcon="{StaticResource SEND}"
                                       Margin="5,0,5,0">
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtSendRequest}" 
                                                  Width ="250"
                                                  Image="{StaticResource SEND}"
                                                  Text="{DynamicResource POF_BtTooltipSendRequest}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>
                    </Fluent:RibbonGroupBox>
                </Fluent:RibbonTabItem>
            </Fluent:Ribbon>

            <Grid>
                <Canvas Background="AliceBlue">
                    <!--<Rectangle Name="VendorName"
                           Width="250" 
                           Height="70" 
                           Fill="LightBlue"
                           Stroke="Black" 
                           StrokeThickness="2" 
                           RadiusX="5" RadiusY="5">
                </Rectangle >-->
                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="10"
                        Canvas.Left="10">
                        <StackPanel Width="380"
                                Height="70">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             Text="{DynamicResource POF_VendorName}"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <Fluent:TextBox Margin="5,0,5,0"
                                        Header="{DynamicResource POF_VendorName1}"
                                        Text="{Binding CurrentDataContext.CurrentVendor.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            </Fluent:TextBox>
                            <Fluent:TextBox Margin="5,0"
                                        Header="{DynamicResource POF_VendorName2}"
                                        Text="{Binding CurrentDataContext.CurrentVendor.DescriptionShort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="90"
                        Canvas.Left="10">
                        <StackPanel Width="380"
                                Height="95">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorAdress}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:TextBox Margin="5,0"
                                            Header="{DynamicResource POF_VendorAdressNumber}"
                                            Width="120"
                                            Text="{Binding CurrentDataContext.CurrentVendor.StreetNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                </Fluent:TextBox>
                                <Fluent:TextBox Margin="5,0"
                                            Width="240"
                                            Header="{DynamicResource POF_VendorAdressStreet}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.StreetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:TextBox Margin="5,0"
                                            Header="{DynamicResource POF_VendorAdressCity}"
                                            Width="170"
                                            Text="{Binding CurrentDataContext.CurrentVendor.City, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox Margin="5,0"
                                            Width="190"
                                            Header="{DynamicResource POF_VendorAdressPostalCode}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.PostalCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorAdressCountry}"
                                        Width="170"
                                        Text="{Binding CurrentDataContext.CurrentVendor.Country, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="195"
                        Canvas.Left="10">
                        <StackPanel Width="380"
                                Height="95">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorCommunication}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:TextBox Margin="5,0"
                                            Header="{DynamicResource POF_VendorComLang}"
                                            Width="100"
                                            Text="{Binding CurrentDataContext.CurrentVendor.Langue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox Margin="5,0"
                                            Width="260"
                                            Header="{DynamicResource POF_VendorComTel}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.CompanyTel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorComMail}"
                                        Width="370"
                                        Text="{Binding CurrentDataContext.CurrentVendor.CompanyMail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Width="370"
                                        Header="{DynamicResource POF_VendorComBusinessType}"
                                        Text="{Binding CurrentDataContext.CurrentVendor.BusinessType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="10"
                        Canvas.Left="400">
                        <StackPanel Width="380"
                                Height="95">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorContact}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:TextBox Margin="5,0"
                                            Header="{DynamicResource POF_VendorContactFirstName}"
                                            Width="180"
                                            Text="{Binding CurrentDataContext.CurrentVendor.ContactFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox Margin="5,0"
                                            Width="180"
                                            Header="{DynamicResource POF_VendorContactLastName}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.ContactLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:TextBox Margin="5,0"
                                            Header="{DynamicResource POF_VendorContactDepartment}"
                                            Width="180"
                                            Text="{Binding CurrentDataContext.CurrentVendor.ContactDepartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox Margin="5,0"
                                            Width="180"
                                            Header="{DynamicResource POF_VendorContactTel}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.ContactTel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Width="370"
                                        Header="{DynamicResource POF_VendorContactMail}"
                                        Text="{Binding CurrentDataContext.CurrentVendor.ContactEmail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="115"
                        Canvas.Left="400">
                        <StackPanel Width="380"
                                Height="95">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorFinancial}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorFinancialSiret}"
                                        Width="250"
                                        Text="{Binding CurrentDataContext.CurrentVendor.Siret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            <Fluent:TextBox Margin="5,0"
                                        Width="250"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorFinancialSiren}"
                                        Text="{Binding CurrentDataContext.CurrentVendor.Siren, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorFinancialTVA}"
                                        Width="100"
                                        Text="{Binding CurrentDataContext.CurrentVendor.Tva, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="220"
                        Canvas.Left="400">
                        <StackPanel Width="380"
                                Height="70">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             Text="{DynamicResource POF_VendorBank}"
                                             HorizontalAlignment="Center"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <Fluent:TextBox Margin="5,0"
                                        HorizontalAlignment="Left"
                                        Header="{DynamicResource POF_VendorCountry}"
                                        Width="180"
                                        Text="{Binding CurrentDataContext.CurrentVendor.BankCountry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>

                            <StackPanel Orientation="Horizontal">
                                <Fluent:TwoLineLabel HasTwoLines="False"
                                                 Margin="10,0"
                                                 Text="{DynamicResource POF_VendorIBAN}"></Fluent:TwoLineLabel>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban1"
                                            Margin="-20,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            HorizontalContentAlignment="Center"
                                            KeyUp="Iban1_KeyDown"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.CommandBindings>
                                        <CommandBinding Command="ApplicationCommands.Paste" Executed="CommandBinding_Executed" />
                                    </TextBox.CommandBindings>
                                </Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban2"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban3"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban4"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban5"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban6"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban7"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP7, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban8"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP8, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                <Fluent:TextBox HorizontalAlignment="Left"
                                            x:Name="Iban9"
                                            Margin="-9,0,0,0"
                                            Width="45"
                                            MaxLength="4"
                                            CharacterCasing="Upper"
                                            PreviewTextInput="TextBox_PreviewTextInput"
                                            IsEnabled="False"
                                            HorizontalContentAlignment="Center"
                                            Text="{Binding CurrentDataContext.CurrentVendor.IbanP9, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="300"
                        Canvas.Left="10">
                        <StackPanel Width="770"
                                Height="50">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorOther}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <StackPanel Orientation="Horizontal">
                                <Fluent:ComboBox Margin="5,0"
                                             HorizontalAlignment="Left"
                                             Header="{DynamicResource POF_VendorMaterialGroup}"
                                             Width="370"
                                             ItemsSource="{Binding CurrentDataContext.ListMaterialGroup}"
                                             Text="{Binding CurrentDataContext.CurrentVendor.MaterialGroup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                </Fluent:ComboBox>

                                <Fluent:TextBox Margin="5,0"
                                            HorizontalAlignment="Left"
                                            Width="370"
                                            Header="{DynamicResource POF_VendorPurchaserCode}"
                                            Text="{Binding CurrentDataContext.CurrentVendor.PurchaserCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border BorderThickness="2" 
                        CornerRadius="5" BorderBrush="Black" 
                        Background="LightBlue"
                        Canvas.Top="360"
                        Canvas.Left="10">
                        <StackPanel Width="770"
                                Height="170">
                            <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="0,2,0,3"
                                             FontWeight="Bold"
                                             FontSize="13"
                                             Text="{DynamicResource POF_VendorFilesRequired}"
                                             HorizontalAlignment="Center"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="300">
                                    <Fluent:TwoLineLabel HasTwoLines="True"
                                             Margin="5,2,0,3"
                                             Text="{DynamicResource POF_VendorFilesRequired1}"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Left"></Fluent:TwoLineLabel>
                                    <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="5,2,0,3"
                                             Text="{DynamicResource POF_VendorFilesRequired2}"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                                    <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="5,2,0,3"
                                             Text="{DynamicResource POF_VendorFilesRequired3}"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                                    <Fluent:TwoLineLabel HasTwoLines="False"
                                             Margin="5,2,0,3"
                                             Text="{DynamicResource POF_VendorFilesRequired4}"
                                             HorizontalAlignment="Left"
                                             HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                                </StackPanel>
                                <DataGrid Margin="5,0"
                                          CanUserAddRows="False"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="False"
                                          HorizontalAlignment="Left"
                                          Width="460"
                                          Height="140"
                                          ItemsSource="{Binding CurrentDataContext.CurrentVendor.ListAttachment}"
                                          SelectedItem="{Binding CurrentDataContext.CurrentVendor.SelectedAttachment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                                    <behaviors:Interaction.Triggers>
                                        <behaviors:EventTrigger EventName="MouseDoubleClick">
                                            <behaviors:InvokeCommandAction Command="{Binding CommandOpenAttachmentVendor}" ></behaviors:InvokeCommandAction>
                                        </behaviors:EventTrigger>
                                    </behaviors:Interaction.Triggers>

                                    <DataGrid.ContextMenu>
                                        <Fluent:ContextMenu>
                                            <Fluent:MenuItem Header="{DynamicResource POF_MenuOpenItem}" 
                                                 Command="{Binding CommandOpenAttachmentVendor}" 
                                                 Icon="{StaticResource OPEN}">
                                            </Fluent:MenuItem>
                                            <Fluent:MenuItem Header="{DynamicResource POF_MenuRemoveItem}" 
                                                 Command="{Binding CommandRemoveAttachementVendor}" 
                                                 Icon="{StaticResource REMOVE}"
                                                 IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                                            </Fluent:MenuItem>
                                        </Fluent:ContextMenu>
                                    </DataGrid.ContextMenu>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{DynamicResource POF_Col20}" 
                                                            Binding="{Binding FileName}"
                                                            IsReadOnly="True"></DataGridTextColumn>
                                        <DataGridTextColumn Header="{DynamicResource POF_Col19}" 
                                                            Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            IsReadOnly="False"></DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Canvas>

                <Grid x:Name="ImageDragDrop"
                      Visibility="Collapsed">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush Color="#FFF8F8F9"  Opacity="0.5"/>
                        </Rectangle.Fill>
                    </Rectangle>

                    <Image Source="{StaticResource DRAGDROP}" 
                           MaxHeight="500"
                           Opacity="0.5"
                           IsHitTestVisible="False"></Image>
                </Grid>
            </Grid>
        </DockPanel>
    </Grid>
</Fluent:RibbonWindow>
