<Fluent:RibbonWindow x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowCreateUpdateView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
                     xmlns:localVM="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.ViewModel"
                     xmlns:PoView="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:System="clr-namespace:System;assembly=mscorlib"
                     xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
                     xmlns:validators="clr-namespace:MCG.CommonLib.WpfComponent.Validator;assembly=MCG.CommonLib.WpfComponent"
                     xmlns:constants="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.Configuration;assembly=MCG.Tools.PurchaseOrderFollowUp"
                     xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
                     xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions"
                     mc:Ignorable="d"
                     AllowDrop="True"
                     Drop="MainSP_Drop"
                     DragEnter="MainSP_DragEnter"
                     DragLeave="MainSP_DragLeave"
                     Height="450" Width="1280"
                     Title="{Binding CurrentDataContext.CurrentRequest.WindowTitle}"
                     x:Name="PoMainWindow"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Purchase.ico"
                     Closing="PoMainWindow_Closing">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="Drop">
            <behaviors:InvokeCommandAction Command="{Binding CommandDrop}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="ITEM" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PartAdd.ico"/>
            <BitmapImage x:Key="SAVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save.ico"/>
            <BitmapImage x:Key="SAVECLOSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SaveClose.ico"/>
            <BitmapImage x:Key="REMOVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/delete.ico"/>
            <BitmapImage x:Key="SEND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PurchaseSend.ico"/>
            <BitmapImage x:Key="DRAGDROP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/drag_and_drop.png" />
            <BitmapImage x:Key="SEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Search_32x32.png" />
            <BitmapImage x:Key="OPEN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Openfile.ico" />
            <BitmapImage x:Key="PO_UPDATE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Purchase_update.ico" />
            <BitmapImage x:Key="STOCK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/stock.ico" />
            <BitmapImage x:Key="CREATE_PR_SAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PurchaseAdd.ico" />
            <BitmapImage x:Key="CREATE_PR_CONVERT_SAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PurchaseConvert.ico" />
            <BitmapImage x:Key="DOWNLOAD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Download.ico" />
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv2"></conv:BoolToVisibilityConverter>
            <conv:InverseBoolToVisibilityConverter x:Key="BoolToInverseBoolConverter"></conv:InverseBoolToVisibilityConverter>
            <conv:BooleanOrConverter x:Key="BooleanOrConverter"></conv:BooleanOrConverter>
            <conv:BoolToInverseBoolConverter x:Key="BoolToInverseBoolConverter2"></conv:BoolToInverseBoolConverter>
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>

            <ObjectDataProvider x:Key="PurchaseOrderStatus" MethodName="GetValues"
                            ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="localVM:PurchaseOrderStatus"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <Storyboard x:Key="UpdateNotAllowedStoryboard" Duration="0:0:6">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.0" To="0.8" Duration="0:0:1"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.8" To="0.8" Duration="0:0:1" BeginTime="0:0:1"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:5"/>
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding CommandSaveRequest}" CommandParameter="{StaticResource FalseValue}"/>
    </Window.InputBindings>

    <Grid>
        <DockPanel IsEnabled="{Binding CurrentDataContext.IsNoActionInProgress}">
            <Fluent:Ribbon DockPanel.Dock="Top" 
                   AreTabHeadersVisible="False" 
                   IsEnabled="{Binding CurrentDataContext.IsPleaseWaitShown, Converter={StaticResource BoolToInverseBoolConverter}}" >
                <Fluent:RibbonTabItem >
                    <Fluent:RibbonGroupBox Header="{DynamicResource POF_RibGrpData}" >
                        <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:ComboBox Header="{DynamicResource POF_CBPurchaseType}"
                                 ItemsSource="{Binding CurrentDataContext.ListPurchaseType}"
                                 SelectedItem="{Binding CurrentDataContext.CurrentRequest.RequestType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="False"
                                 Width="240">
                            </Fluent:ComboBox>
                            <Button Width="22"
                            x:Name="ButtonSearchRequestType"
                            Click="ButtonSearchRequestType_Click"
                            Command="{Binding CommandSearchRquestType}"
                            CommandParameter="RESET">
                                <Image Source="{StaticResource SEARCH}"></Image>
                            </Button>
                        </StackPanel>

                        <Fluent:ComboBox Header="{DynamicResource POF_CBCostCenter}"
                                 IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}"
                                 ItemsSource="{Binding CurrentDataContext.ListCostCenter}"
                                 SelectedItem="{Binding CurrentDataContext.CurrentRequest.CostCenter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEditable="False"
                                 Width="262"
                                 ToolTip="{Binding CurrentDataContext.CurrentRequest.CostCenter.Description}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ComboBoxItem}">
                                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </Fluent:ComboBox>


                        <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:ComboBox Header="{DynamicResource POF_CBInternalOrder}"
                                     ItemsSource="{Binding CurrentDataContext.ListInternalOrder}"
                                     SelectedItem="{Binding CurrentDataContext.CurrentRequest.InternalOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="False"
                                     Width="240"
                                     ToolTip="{Binding CurrentDataContext.CurrentRequest.InternalOrder.Number}">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="ToolTip" Value="{Binding Number}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </Fluent:ComboBox>
                            <Button Width="22"
                            x:Name="ButtonSearchOrder"
                            Click="ButtonSearchOrder_Click"
                            Command="{Binding CommandSetSearchOrder}">
                                <Image Source="{StaticResource SEARCH}"></Image>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                            IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:ComboBox Header="{DynamicResource POF_CBVendor}"
                                     ItemsSource="{Binding CurrentDataContext.ListVendor}"
                                     SelectedItem="{Binding CurrentDataContext.CurrentRequest.Vendor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEditable="False"
                                     MaxWidth="240"
                                     MinWidth="150"
                                     ToolTip="{Binding CurrentDataContext.CurrentRequest.Vendor.Number}">

                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ComboBoxItem}">
                                        <Setter Property="ToolTip" Value="{Binding Number}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </Fluent:ComboBox>
                            <Button Width="22"
                            x:Name="ButtonSearchVendor"
                            Click="ButtonSearchVendor_Click"
                            Command="{Binding CommandSetSearchVendor}">
                                <Image Source="{StaticResource SEARCH}"></Image>
                            </Button>
                        </StackPanel>

                        <Fluent:TextBox Header="{DynamicResource POF_TBRequestedBy}"
                                IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}"
                                Text="{Binding CurrentDataContext.CurrentRequest.RequestedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </Fluent:TextBox>

                        <Fluent:TextBox Header="{DynamicResource POF_TBSapRequest}"
                                Text="{Binding CurrentDataContext.CurrentRequest.SapPurchaseRequest, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <Fluent:TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:TextBox.IsEnabled>
                        </Fluent:TextBox>

                        <Fluent:TextBox Header="{DynamicResource POF_TBSapRequest}"
                                Text="{Binding CurrentDataContext.CurrentRequest.SapPurchaseOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding CurrentDataContext.CurrentRequest.IsAdminUpdate, Converter={StaticResource BoolToVisibilityConv2}}">
                            <Fluent:TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:TextBox.IsEnabled>
                        </Fluent:TextBox>

                        <Fluent:ComboBox Header="{DynamicResource POF_Col17}"
                                 IsEditable="False"
                                 ItemsSource="{Binding Source={StaticResource PurchaseOrderStatus}}" 
                                 SelectedItem="{Binding CurrentDataContext.CurrentRequest.Status, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Visibility="{Binding CurrentDataContext.CurrentRequest.IsAdminUpdate, Converter={StaticResource BoolToVisibilityConv2}}">
                        </Fluent:ComboBox>

                        <Fluent:TextBox Header="{DynamicResource POF_Col21}"
                                Text="{Binding CurrentDataContext.CurrentRequest.Total_Ordered, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding CurrentDataContext.CurrentRequest.IsAdminUpdate, Converter={StaticResource BoolToVisibilityConv2}}">
                            <Fluent:TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:TextBox.IsEnabled>
                        </Fluent:TextBox>
                        <Fluent:TextBox Header="{DynamicResource POF_Col22}"
                                Text="{Binding CurrentDataContext.CurrentRequest.Total_Goods, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding CurrentDataContext.CurrentRequest.IsAdminUpdate, Converter={StaticResource BoolToVisibilityConv2}}">
                            <Fluent:TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:TextBox.IsEnabled>
                        </Fluent:TextBox>
                        <Fluent:TextBox Header="{DynamicResource POF_Col23}"
                                Text="{Binding CurrentDataContext.CurrentRequest.Total_Invoice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Visibility="{Binding CurrentDataContext.CurrentRequest.IsAdminUpdate, Converter={StaticResource BoolToVisibilityConv2}}">
                            <Fluent:TextBox.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:TextBox.IsEnabled>
                        </Fluent:TextBox>

                        <StackPanel Width="200"
                            Margin="5,0,5,0"
                            IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:TwoLineLabel Text="{DynamicResource POF_TBGeneralDescription}"
                                         HasTwoLines="False"
                                         HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Center"></Fluent:TwoLineLabel>
                            <TextBox Height="50" 
                             Background="{DynamicResource IdealBackgroundColor}"
                             Foreground="{DynamicResource IdealForegroundColor}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                             ScrollViewer.VerticalScrollBarVisibility="Auto" 
                             Text="{Binding CurrentDataContext.CurrentRequest.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             AcceptsReturn="True" />
                        </StackPanel>

                        <Fluent:Button Command="{Binding CommandCreateItem}"
                               Header="{DynamicResource POF_BtAddItem}"
                               LargeIcon="{StaticResource ITEM}"
                               Margin="5,0,5,0"
                               IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtAddItem}" 
                                          Width ="250"
                                          Image="{StaticResource ITEM}"
                                          Text="{DynamicResource POF_BtTooltipAddItem}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>

                        <Fluent:Button Command="{Binding CommandSaveRequest}"
                               CommandParameter="{StaticResource FalseValue}"
                               Header="{DynamicResource POF_BtSaveRequest}"
                               LargeIcon="{StaticResource SAVE}"
                               Margin="5,0,5,0">
                            <Fluent:Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:Button.IsEnabled>
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtSaveRequest}" 
                                          Width ="250"
                                          Image="{StaticResource SAVE}"
                                          Text="{DynamicResource POF_BtTooltipSaveRequest}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>

                        <Fluent:Button Command="{Binding CommandSaveRequest}"
                               CommandParameter="{StaticResource TrueValue}"
                               Header="{DynamicResource POF_BtSaveRequestClose}"
                               LargeIcon="{StaticResource SAVECLOSE}"
                               Margin="5,0,5,0">
                            <Fluent:Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource BooleanOrConverter}">
                                    <Binding Path="CurrentDataContext.CurrentRequest.IsUpdateAllowed"/>
                                    <Binding Path="CurrentDataContext.IsRoleSapCreator"/>
                                </MultiBinding>
                            </Fluent:Button.IsEnabled>
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtSaveRequestClose}" 
                                          Width ="250"
                                          Image="{StaticResource SAVECLOSE}"
                                          Text="{DynamicResource POF_BtTooltipSaveRequestClose}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>

                        <Fluent:Button Command="{Binding CommandSendRequest}"
                               CommandParameter="{StaticResource TrueValue}"
                               Header="{DynamicResource POF_BtSendRequest}"
                               LargeIcon="{StaticResource SEND}"
                               Margin="5,0,5,0"
                               IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtSendRequest}" 
                                          Width ="250"
                                          Image="{StaticResource SEND}"
                                          Text="{DynamicResource POF_BtTooltipSendRequest}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>

                        <Fluent:Button Command="{Binding CommandShowSapStock}"
                               CommandParameter="{StaticResource TrueValue}"
                               Header="{DynamicResource POF_BtShowSapStock}"
                               LargeIcon="{StaticResource STOCK}"
                               Margin="5,0,5,0">
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtShowSapStock}" 
                                          Width ="250"
                                          Image="{StaticResource STOCK}"
                                          Text="{DynamicResource POF_BtToolTipShowSapStock}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>
                    </Fluent:RibbonGroupBox>

                    <Fluent:RibbonGroupBox Header="{DynamicResource POF_RibGrpSapCreator}"
                                   Visibility="{Binding CurrentDataContext.IsRoleSapCreator, Converter={StaticResource BoolToVisibilityConv}}">
                        <Fluent:Button Command="{Binding CommandCreateSapRequest}"
                               Header="{DynamicResource POF_BtCreateSapRquest}"
                               LargeIcon="{StaticResource CREATE_PR_SAP}"
                               Margin="5,0,5,0">
                            <Fluent:Button.Style>
                                <Style TargetType="Fluent:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CurrentRequest.RequestType}" Value="{x:Static localVM:PurchaseOrderType.RESA}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Fluent:Button.Style>
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtCreateSapRquest}" 
                                          Width ="250"
                                          Image="{StaticResource CREATE_PR_SAP}"
                                          Text="{DynamicResource POF_BtToolTipCreateSapRquest}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>
                        <Fluent:Button Command="{Binding CommandConvertSapRequest}"
                               Header="{DynamicResource POF_BtConvertSapRquest}"
                               LargeIcon="{StaticResource CREATE_PR_CONVERT_SAP}"
                               Margin="5,0,5,0">
                            <Fluent:Button.Style>
                                <Style TargetType="Fluent:Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CurrentRequest.RequestType}" Value="{x:Static localVM:PurchaseOrderType.RESA}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CurrentRequest.RequestType}" Value="{x:Static localVM:PurchaseOrderType.ZNB}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.CurrentRequest.RequestType}" Value="{x:Static localVM:PurchaseOrderType.ZICP}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </Fluent:Button.Style>
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="{DynamicResource POF_BtConvertSapRquest}" 
                                          Width ="250"
                                          Image="{StaticResource CREATE_PR_CONVERT_SAP}"
                                          Text="{DynamicResource POF_BtToolTipConvertSapRquest}"/>
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>
                    </Fluent:RibbonGroupBox>

                    <Fluent:RibbonGroupBox Header="{DynamicResource POF_RibGrpA1dmin}"
                                   Visibility="{Binding CurrentDataContext.IsRoleAdmin, Converter={StaticResource BoolToVisibilityConv}}">
                        <Fluent:Button Command="{Binding CommandUpdatePrFromSapHub}"
                               Header="{DynamicResource POF_BtUpdatePrFromSapHub}"
                               LargeIcon="{StaticResource PO_UPDATE}"
                               Margin="5,0,5,0">
                        </Fluent:Button>

                        <Fluent:Button Command="{Binding CommandUpdatePoFromSapHub}"
                               Header="{DynamicResource POF_BtUpdatePoFromSapHub}"
                               LargeIcon="{StaticResource PO_UPDATE}"
                               Margin="5,0,5,0">
                        </Fluent:Button>
                    </Fluent:RibbonGroupBox>
                </Fluent:RibbonTabItem>

            </Fluent:Ribbon>
            <TabControl>
                <TabItem Header="{DynamicResource POF_TabItem}" >
                    <DataGrid AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      x:Name="ItemDataGrid"
                      IsReadOnly="False"
                      ItemsSource="{Binding CurrentDataContext.CurrentRequest.UpdatedListItem}"
                      SelectedItem="{Binding CurrentDataContext.CurrentRequest.SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="LightGray" />
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="Gray" />
                                    </Trigger>
                                    <Trigger Property="IsReadOnly" Value="False">
                                        <Setter Property="Background" Value="LightYellow" />
                                    </Trigger>
                                    <Trigger Property="IsReadOnly" Value="True">
                                        <Setter Property="Background" Value="LightGray" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.ContextMenu>
                            <Fluent:ContextMenu>
                                <Fluent:MenuItem Header="{DynamicResource POF_MenuRemoveItem}" 
                                         Command="{Binding CommandRemoveItem}" 
                                         Icon="{StaticResource REMOVE}"
                                         IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                                </Fluent:MenuItem>
                            </Fluent:ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource POF_Col01}"
                                        Binding="{Binding Number, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="False">

                            </DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource POF_Col02}"
                                        Binding="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        Visibility="{Binding Data.CurrentDataContext.IsDienNlagMaterial, Source={StaticResource proxy},Converter={StaticResource BoolToInverseBoolConverter}}"
                                        IsReadOnly="False"></DataGridTextColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col02}"
                                            Visibility="{Binding Data.CurrentDataContext.IsDienNlagMaterial, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConv}}"
                                            IsReadOnly="False">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="False"
                                      ItemsSource="{Binding Data.CurrentDataContext.ListDienNlagMaterial, Source={StaticResource proxy}}" 
                                      SelectedItem="{Binding SelectedMaterial, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ComboBoxItem}">
                                                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SelectedMaterial}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource POF_Col03}"
                                        Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        IsReadOnly="False">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type TextBox}">
                                        <Setter Property="MaxLength" Value="{x:Static constants:PurchaseOrderFollowUpConstants.MaxSapDesignationCarac}" />
                                        <EventSetter Event="PreviewTextInput" Handler="TextBox_PreviewTextInput" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZRMI">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZICP">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZNB">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="RESA">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <Trigger Property="IsReadOnly" Value="False">
                                                <Setter Property="Background" Value="LightYellow" />
                                            </Trigger>
                                            <Trigger Property="IsReadOnly" Value="True">
                                                <Setter Property="Background" Value="LightGray" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="LightGray" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col07}" 
                                            CanUserSort="True" 
                                            SortMemberPath="Price"
                                            IsReadOnly="False">
                                <DataGridTemplateColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZRMI">
                                                <Setter Property="IsEnabled" Value="True" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZICP">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="ZNB">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Data.CurrentDataContext.CurrentRequest.RequestType, Source={StaticResource proxy}}" Value="RESA">
                                                <Setter Property="IsEnabled" Value="False" />
                                            </DataTrigger>
                                            <Trigger Property="IsReadOnly" Value="False">
                                                <Setter Property="Background" Value="LightYellow" />
                                            </Trigger>
                                            <Trigger Property="IsReadOnly" Value="True">
                                                <Setter Property="Background" Value="LightGray" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="LightGray" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTemplateColumn.CellStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:# ##0.00} {1} ">
                                                    <Binding Path="Price"/>
                                                    <Binding Path="Data.CurrentDataContext.CurrentRequest.CurrencySymbol"  Source="{StaticResource proxy}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Price, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         GotKeyboardFocus="TextBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource POF_Col04}"
                                        Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                        IsReadOnly="False"></DataGridTextColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col05}"
                                                    MinWidth="90"
                                                    IsReadOnly="False">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding DeliveryDateDateTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                        </DatePicker>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeliveryDateDateTime, StringFormat='dd.MM.yyyy'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col08}"
                                            IsReadOnly="False">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="False"
                                          ItemsSource="{Binding Data.CurrentDataContext.ListDeliveryLocation, Source={StaticResource proxy}}" 
                                          SelectedItem="{Binding DeliveryAdress, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ComboBoxItem}">
                                                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DeliveryAdress}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource POF_Col09}"
                                        Binding="{Binding Detail, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsReadOnly="False"></DataGridTextColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col17}"
                                            IsReadOnly="{Binding Data.CurrentDataContext.CurrentRequest.IsAdminUpdate, Source={StaticResource proxy}, Converter={StaticResource BoolToInverseBoolConverter2}}">
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="False"
                                          ItemsSource="{Binding Source={StaticResource PurchaseOrderStatus}}" 
                                          SelectedItem="{Binding GoodReceiptStatus, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ComboBoxItem}">
                                                    <Setter Property="ToolTip" Value="{Binding GoodReceiptStatus}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding GoodReceiptStatus}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col21}" 
                                            CanUserSort="True" 
                                            SortMemberPath="Total_Ordered"
                                            IsReadOnly="{Binding Data.CurrentDataContext.CurrentRequest.IsAdminUpdate, Source={StaticResource proxy}, Converter={StaticResource BoolToInverseBoolConverter2}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:# ##0.00} {1} ">
                                                    <Binding Path="Total_Ordered"/>
                                                    <Binding Path="Data.CurrentDataContext.CurrentRequest.CurrencySymbol"  Source="{StaticResource proxy}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Total_Ordered, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         GotKeyboardFocus="TextBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col22}" 
                                            CanUserSort="True" 
                                            SortMemberPath="Total_Goods"
                                            IsReadOnly="{Binding Data.CurrentDataContext.CurrentRequest.IsAdminUpdate, Source={StaticResource proxy}, Converter={StaticResource BoolToInverseBoolConverter2}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:# ##0.00} {1} ">
                                                    <Binding Path="Total_Goods"/>
                                                    <Binding Path="Data.CurrentDataContext.CurrentRequest.CurrencySymbol"  Source="{StaticResource proxy}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Total_Goods, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         GotKeyboardFocus="TextBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{DynamicResource POF_Col23}" 
                                            CanUserSort="True" 
                                            SortMemberPath="Total_Invoice"
                                            IsReadOnly="{Binding Data.CurrentDataContext.CurrentRequest.IsAdminUpdate, Source={StaticResource proxy}, Converter={StaticResource BoolToInverseBoolConverter2}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Right">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0:# ##0.00} {1} ">
                                                    <Binding Path="Total_Invoice"/>
                                                    <Binding Path="Data.CurrentDataContext.CurrentRequest.CurrencySymbol"  Source="{StaticResource proxy}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Total_Invoice, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         GotKeyboardFocus="TextBox_GotKeyboardFocus"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>
                </TabItem>
                <TabItem Header="{DynamicResource POF_TabAttachment}">
                    <DataGrid AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserSortColumns="True"
              IsReadOnly="False"
              ItemsSource="{Binding CurrentDataContext.CurrentRequest.UpdatedListAttachment}"
              SelectedItem="{Binding CurrentDataContext.CurrentRequest.SelectedAttachment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">

                        <behaviors:Interaction.Triggers>
                            <behaviors:EventTrigger EventName="MouseDoubleClick">
                                <behaviors:InvokeCommandAction Command="{Binding CommandOpenAttachment}" ></behaviors:InvokeCommandAction>
                            </behaviors:EventTrigger>
                        </behaviors:Interaction.Triggers>

                        <DataGrid.ContextMenu>
                            <Fluent:ContextMenu>
                                <Fluent:MenuItem Header="{DynamicResource POF_MenuOpenItem}" 
                                         Command="{Binding CommandOpenAttachment}" 
                                         Icon="{StaticResource OPEN}">
                                </Fluent:MenuItem>
                                <Fluent:MenuItem Header="{DynamicResource POF_MenuDownloadItem}" 
                                         Command="{Binding CommandDownloadAttachment}" 
                                         Icon="{StaticResource DOWNLOAD}">
                                </Fluent:MenuItem>
                                <Fluent:MenuItem Header="{DynamicResource POF_MenuRemoveItem}" 
                                         Command="{Binding CommandRemoveAttachement}" 
                                         Icon="{StaticResource REMOVE}"
                                         IsEnabled="{Binding CurrentDataContext.CurrentRequest.IsUpdateAllowed}">
                                </Fluent:MenuItem>
                            </Fluent:ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource POF_Col20}"
                                        IsReadOnly="True"
                                        Binding="{Binding FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                            <DataGridTextColumn Header="{DynamicResource POF_Col19}"
                                        Binding="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                        </DataGrid.Columns>

                    </DataGrid>
                </TabItem>
            </TabControl>
        </DockPanel>

        <Grid x:Name="ImageDragDrop"
              Visibility="Collapsed">
            <Rectangle>
                <Rectangle.Fill>
                    <SolidColorBrush Color="#FFF8F8F9"  Opacity="0.5"/>
                </Rectangle.Fill>
            </Rectangle>

            <Image Source="{StaticResource DRAGDROP}" 
                   MaxHeight="500"
                   Opacity="0.5"
                   IsHitTestVisible="False"></Image>
        </Grid>

        <Grid Background="lightyellow" 
              x:Name="UpdateNotAllowed" 
              Opacity="0.0" 
              IsHitTestVisible="False"
              Height="120"
              VerticalAlignment="Top"
              Visibility="{Binding CurrentDataContext.IsRoleSapCreator, Converter={StaticResource BoolToInverseBoolConverter}}">
            <Fluent:TwoLineLabel Text="{DynamicResource POF_LabelUpdateNotAllowed}"
                                 Background="lightyellow"
                                 Foreground="Black"
                                 FontSize="25"
                                 HorizontalContentAlignment="center"
                                 VerticalContentAlignment="center"
                                 HorizontalAlignment="stretch" 
                                 VerticalAlignment="stretch"
                                 IsHitTestVisible="False">
            </Fluent:TwoLineLabel>
        </Grid>

        <Image Visibility="{Binding CurrentDataContext.IsNoActionInProgress, Converter={StaticResource BoolToInverseBoolConverter}, FallbackValue=True}" 
               Stretch="Fill" 
               gif:AnimationBehavior.SourceUri="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/wait.gif" 
               ForceCursor="True" 
               Cursor="Hand" 
               Opacity="0.4"
               IsHitTestVisible="False">
        </Image>

        <Canvas>
            <local:PurchaseOrderFollowUpSearchItemView x:Name="SearchVendorUserControl" Visibility="Collapsed"/>
            <local:PurchaseOrderFollowUpSearchItemView x:Name="SearchOrderUserControl" Visibility="Collapsed"/>
            <local:PurchaseOrderFollowSelectRequestTypeView x:Name="SelectRequestType" Visibility="Collapsed"></local:PurchaseOrderFollowSelectRequestTypeView>
        </Canvas>
    </Grid>
</Fluent:RibbonWindow>
