<Fluent:RibbonWindow x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowUpAddInternalOrderView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     ResizeMode="NoResize"
                     WindowStartupLocation="CenterOwner"
                     Title="{DynamicResource POF_WindowAddInternalOrder}"
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/InternalOrderAdd.ico"
                     Height="230" Width="450"
                     Background="{DynamicResource IdealBackgroundColor80}">

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="SEND" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/InternalOrderSend.ico" />
            <BitmapImage x:Key="CLOSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Fluent:TextBox Grid.Row="0"
                        Margin="5"
                        Header="{DynamicResource POF_LabelAddInternalOrderNumber}"
                        MaxLength="12"
                        Text="{Binding Number, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

        <Fluent:TextBox Grid.Row="1"
                        Margin="5"
                        Header="{DynamicResource POF_LabelAddInternalOrderDescription}"
                        MaxLength="100"
                        Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Height="44"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
            <Button x:Name="Send"
                    IsDefault="True"
                    IsEnabled="{Binding IsValid}"
                    Click="Send_Click">
                <Image Source="{StaticResource SEND}" />
            </Button>
            <Rectangle Width="100" />
            <Button x:Name="CloseWindow"
                    IsCancel="True"
                    Click="Close_Click">
                <Image Source="{StaticResource CLOSE}" />
            </Button>
        </StackPanel>
    </Grid>
</Fluent:RibbonWindow>
