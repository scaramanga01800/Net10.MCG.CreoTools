<UserControl x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowSelectRequestTypeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             mc:Ignorable="d" 
             Width="270"
             Background="{DynamicResource IdealBackgroundColor80}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="ITEM" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PartAdd.ico"/>
            <BitmapImage x:Key="SAVE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save.ico"/>
            <BitmapImage x:Key="SAVECLOSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/SaveClose.ico"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToWidthConverter x:Key="BoolToWidthConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border BorderThickness="2" BorderBrush="Black">
        <StackPanel x:Name="MyGrid">
            <StackPanel.Resources>
                <Storyboard x:Key="fadeOutStoryboard">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.3"/>
                </Storyboard>
                <Storyboard x:Key="fadeInStoryboard">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                </Storyboard>
            </StackPanel.Resources>
            <Fluent:TwoLineLabel Text="{Binding CurrentDataContext.BtRequestTypeQuestion}"
                                 FontSize="16">
            
            </Fluent:TwoLineLabel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToWidthConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToWidthConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToWidthConverter}}"></ColumnDefinition>
                    <ColumnDefinition Width="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToWidthConverter}}"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" 
                        Content="{Binding CurrentDataContext.BtRequestType1}" 
                        Click="Button_Click" 
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT1"/>
                <Button Grid.Column="1" 
                        Content="{Binding CurrentDataContext.BtRequestType2}" 
                        Click="Button_Click" 
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT2"/>
                <Button Grid.Column="2" 
                        Content="{Binding CurrentDataContext.BtRequestType3}" 
                        Click="Button_Click"  
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT3"
                        Visibility="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Grid.Column="3" 
                        Content="{Binding CurrentDataContext.BtRequestType4}" 
                        Click="Button_Click"  
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT4"
                        Visibility="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Grid.Column="4" 
                        Content="{Binding CurrentDataContext.BtRequestType5}" 
                        Click="Button_Click"  
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT5"
                        Visibility="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Grid.Column="5" 
                        Content="{Binding CurrentDataContext.BtRequestType6}" 
                        Click="Button_Click"  
                        Command="{Binding CommandSearchRquestType}"
                        CommandParameter="BT6"
                        Visibility="{Binding CurrentDataContext.IsAllBtRequestTypeShown, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
