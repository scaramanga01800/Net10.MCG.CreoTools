<Window x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowUpDuplicate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
        mc:Ignorable="d"
        Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Purchase_duplicate.ico"
        Title="{DynamicResource POF_WindowTitleDuplicateRequest}"
        Height="450" Width="800">
    <Window.Resources>
        <conv:StringFormatConverter x:Key="StringFormatConverter"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <!-- Affichage des groupes d'ordres -->
            <ItemsControl ItemsSource="{Binding CurrentDataContext.ListDuplicateRequest}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" 
                                BorderBrush="Black" 
                                Margin="10" 
                                Padding="10">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" FontSize="16">
                                    <TextBlock.Text>
                                        <Binding Path="NumberItem" 
                                                 Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelGroupNumber"/>
                                    </TextBlock.Text>
                                </TextBlock>
                                <!-- Liste des ordres dans chaque groupe -->
                                <ItemsControl ItemsSource="{Binding ListeDuplicateOrder}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="1" 
                                                    BorderBrush="Gray" 
                                                    Margin="5" Padding="5">
                                                <StackPanel>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <Binding Path="ID" 
                                                                     Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelDuplicateId"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <Binding Path="SapPurchaseRequest" 
                                                                     Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelDuplicateSapRequest"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <Binding Path="SapPurchaseOrder" 
                                                                     Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelDuplicateSapOrder"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <Binding Path="Vendor" 
                                                                     Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelDuplicateVendor"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    <TextBlock>
                                                        <TextBlock.Text>
                                                            <Binding Path="Total_Ordered" 
                                                                     Converter="{StaticResource StringFormatConverter}" ConverterParameter="POF_LabelDuplicateTotalOrdered"/>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Window>
