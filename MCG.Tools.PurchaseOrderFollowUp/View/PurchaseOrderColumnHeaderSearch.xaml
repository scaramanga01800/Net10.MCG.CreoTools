<UserControl x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderColumnHeaderSearch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush >
                <GradientStop Color="{DynamicResource Fluent.Ribbon.Colors.AccentColor20}"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Orientation="Vertical" MinWidth="100" >
            <Fluent:TwoLineLabel Grid.Row="0"
                                 Margin="10,0"
                                 HorizontalAlignment="Center"
                                 HorizontalContentAlignment="Center" 
                                 VerticalContentAlignment="Center" 
                                 Height="25" 
                                 FontSize="12"
                                 HasTwoLines="False"
                                 Text="{Binding AttributeName,FallbackValue='Attribute Name'}"/>
            <Fluent:TextBox x:Name="TbValue"  
                            Grid.Row="1" 
                            Text="{Binding CurrentCommandParameter.FilterValue, FallbackValue=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  
                            FontSize="12"  
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Margin="-9,0,0,0">
                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="KeyUp" >
                        <behaviors:InvokeCommandAction Command="{Binding DataContextCommand.CommandSearchColumnKeyWord}" 
                                                       CommandParameter="{Binding CurrentCommandParameter}"/>
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>
            </Fluent:TextBox>
        </StackPanel>
    </Grid>

</UserControl>
