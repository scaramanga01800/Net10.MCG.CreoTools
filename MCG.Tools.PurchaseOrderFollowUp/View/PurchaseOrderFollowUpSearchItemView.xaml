<UserControl x:Class="MCG.Tools.PurchaseOrderFollowUp.View.PurchaseOrderFollowUpSearchItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:local="clr-namespace:MCG.Tools.PurchaseOrderFollowUp.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200" Background="{DynamicResource IdealBackgroundColor80}" >

    <UserControl.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="SEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Search_32x32.png" />
            <BitmapImage x:Key="SELECT" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico" />
            <BitmapImage x:Key="CLOSE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/delete.ico" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConv"></conv:BoolToVisibilityConverter>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <Storyboard x:Key="MaxRowStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.0" To="0.8" Duration="0:0:1"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.8" To="0.8" Duration="0:0:1" BeginTime="0:0:1"/>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                     From="0.8" To="0.0" Duration="0:0:1" BeginTime="0:0:4"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="2" BorderBrush="Black">
        <DockPanel  Height="200" Margin="1" >
            <Grid DockPanel.Dock="Top">
                <StackPanel Orientation="Horizontal">
                    <StackPanel MinWidth="200">
                        <Fluent:TextBox Header="{DynamicResource POF_TbNumber}"
                                    Text="{Binding CurrentDataContext.NumberSearchField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommandSearchItem}"/>
                            </TextBox.InputBindings>
                        </Fluent:TextBox>
                        <Fluent:TextBox Header="{DynamicResource POF_TbName}"
                                    Text="{Binding CurrentDataContext.DescriptionSearchField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommandSearchItem}"/>
                            </TextBox.InputBindings>
                        </Fluent:TextBox>
                    </StackPanel>
                    <Button Height="44"
                        Command="{Binding CommandSearchItem}">
                        <Image Source="{StaticResource SEARCH}"></Image>
                    </Button>
                    <Button Height="44"
                        x:Name="ButtonCheck"
                        Click="ButtonCheck_Click"
                        Command="{Binding CommandSelectItem}">
                        <Image Source="{StaticResource SELECT}"></Image>
                    </Button>
                    <Button Height="44"
                            x:Name="ButtonClose"
                            Click="ButtonClose_Click"
                            Visibility="{Binding CurrentDataContext.IsCloseBtShown, Converter={StaticResource BoolToVisibilityConv}}">
                        <Image Source="{StaticResource CLOSE}"></Image>
                    </Button>
                </StackPanel>
                <Grid Background="lightyellow" 
                      x:Name="MaxRowLabel" 
                      Opacity="0.0" 
                      IsHitTestVisible="False">
                    <Fluent:TwoLineLabel Text="{DynamicResource POF_LabelMaxRow}"
                                         Background="lightyellow"
                                         Foreground="Black"
                                         FontSize="16"
                                         HorizontalContentAlignment="center"
                                         VerticalContentAlignment="center"
                                         HorizontalAlignment="stretch" 
                                         VerticalAlignment="stretch"
                                         IsHitTestVisible="False">
                    </Fluent:TwoLineLabel>
                </Grid>
            </Grid>


            <DataGrid ItemsSource="{Binding CurrentDataContext.ListItem}"
                      SelectedItem="{Binding CurrentDataContext.SelectedItem}"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      AutoGenerateColumns="False"
                      MouseDoubleClick="ButtonCheck_Click">

                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="MouseDoubleClick">
                        <behaviors:InvokeCommandAction Command="{Binding CommandSelectItem}" ></behaviors:InvokeCommandAction>
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource POF_TbNumber}"
                                        Binding="{Binding Number}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource POF_TbName}"
                                        Binding="{Binding Description}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource POF_TbLocation}"
                                        Binding="{Binding Location}"
                                        Visibility="{Binding Data.CurrentDataContext.HasLocationProperty, 
                                             Source={StaticResource proxy}, 
                                             Converter={StaticResource BoolToVisibilityConv}}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource POF_TbSociety}"
                                        Binding="{Binding Society}"
                                        Visibility="{Binding Data.CurrentDataContext.HasLocationProperty, 
                                             Source={StaticResource proxy}, 
                                             Converter={StaticResource BoolToVisibilityConv}}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource POF_VendorAdressCity}"
                                        Binding="{Binding City}"
                                        Visibility="{Binding Data.CurrentDataContext.HasLocationProperty, 
                                             Source={StaticResource proxy}, 
                                             Converter={StaticResource BoolToVisibilityConv}}"></DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
