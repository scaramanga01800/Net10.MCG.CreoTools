                                        SelectedDate="{Binding CurrentDataContext.ChartPoCreatedAfterDateTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right"
                                    Margin="4,0,0,0"
                                    Orientation="Horizontal">
                            <Fluent:TwoLineLabel Text="{DynamicResource POF_LabelDateTo}" 
                                     HasTwoLines="False"
                                     VerticalContentAlignment="Center"  
                                     HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                            <DatePicker Width="100" 
                                        SelectedDate="{Binding CurrentDataContext.ChartPoCreatedBeforeDateTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>

                        </StackPanel>
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Polygon Points="20,10 30,5 30,8 40,8 40,11 30,11 30,15" Fill="Red" Stroke="Red" StrokeThickness="5"/>
                            <Fluent:TwoLineLabel Text="{DynamicResource POF_LabelDateWarning}"
                                     FontSize="15"
                                     Margin="5,0,0,0"
                                     Foreground="Red"
                                     HasTwoLines="False"
                                     VerticalContentAlignment="Center"  
                                     HorizontalContentAlignment="Center"></Fluent:TwoLineLabel>
                        </StackPanel>
                    </StackPanel>


                    <Border BorderThickness="1"
                                BorderBrush="Black"
                                Padding="10" >

                        <StackPanel Orientation="Horizontal">
                            <Border BorderThickness="0.3"
                                    BorderBrush="Black"
                                    Padding="10" 
                                    Height="320"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Vertical"
                                            Margin="10,5,0,5">
                                    <Fluent:TwoLineLabel HasTwoLines="False"
                                             Text="{DynamicResource POF_CBCostCenter}"
                                             Margin="2"></Fluent:TwoLineLabel>
                                    <CheckBox x:Name="selectAllCheckBox" 
                                              Content="{DynamicResource POF_CBCostCenterSelectAll}"
                                              IsChecked="{Binding CurrentDataContext.IsAllCostCenterSelected}"/>
                                    <ListView ItemsSource="{Binding CurrentDataContext.ListCostCenter}" 
                                              Height="250">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Number}"
                                              IsChecked="{Binding IsSelected}"/>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="50,0">

                                <Fluent:TwoLineLabel HasTwoLines="False"
                                                     HorizontalAlignment="Center"
                                                     Text="{DynamicResource POF_TitleTotalPurchaseRequest}"></Fluent:TwoLineLabel>
                                <lvc:PieChart Width="300" 
                                              Height="400" 
                                              Name="pieChartNumber" 
                                              DataTooltip="{x:Null}" 
                                              Series="{Binding CurrentDataContext.AllPurchasePieSeriesNumber}" 
                                              LegendLocation="Bottom" />
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Left"
                                        Margin="50,0">

                                <Fluent:TwoLineLabel HasTwoLines="False"
                                                     HorizontalAlignment="Center"
                                                     Text="{DynamicResource POF_TitleTotalBudget}"></Fluent:TwoLineLabel>

                                <lvc:CartesianChart Series="{Binding CurrentDataContext.AllPurchaseStackColSeriesNumber}"
                                                    LegendLocation="Bottom"
                                                    Height="400"
                                                    Width="250">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis LabelFormatter="{Binding CurrentDataContext.PieSeriesCostFormatter}"></lvc:Axis>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>

                            <StackPanel Margin="50,0">
                                <StackPanel Orientation="Horizontal">
                                    <Fluent:TwoLineLabel HasTwoLines="False"
                                                         HorizontalAlignment="Center"
                                                         Text="{DynamicResource POF_TitleTotalVendorCost}"></Fluent:TwoLineLabel>
                                    <Fluent:TextBox Text="{Binding CurrentDataContext.MinVendorRatio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:TextBox>
                                </StackPanel>
                                <lvc:PieChart Width="300" 
                                              Height="400" 
                                              Series="{Binding CurrentDataContext.AllPurchasePieSeriesVendorCost}" 
                                              LegendLocation="Bottom"/>       
                            </StackPanel>

                        </StackPanel>
                    </Border>

                </DockPanel>
            </TabItem>

            <TabItem Header="{DynamicResource POF_TabInternalOrder}">
                <DataGrid ItemsSource="{Binding CurrentDataContext.ListAllInternalOrder}"
              SelectedItem="{Binding CurrentDataContext.SelectedInternalOrder, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
              IsReadOnly="True"
              CanUserAddRows="False"
              AutoGenerateColumns="False">
                    <DataGrid.ContextMenu>
                        <Fluent:ContextMenu>
                            <Fluent:MenuItem Header="{DynamicResource POF_MenuCopyNumber}" 
                                 Command="{Binding CommandCopyIONumber}"
                                     Icon="{StaticResource COPY}">
                            </Fluent:MenuItem>
                        </Fluent:ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource POF_Col25}" 
                                Binding="{Binding Number}"></DataGridTextColumn>
                        <DataGridTextColumn Header="{DynamicResource POF_Col26}"
                                Binding="{Binding Description}"></DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <Image  Visibility="{Binding CurrentDataContext.IsNoActionInProgress, Converter={StaticResource BoolToInverseBoolConverter}, FallbackValue=True}" 
                Stretch="Fill" 
                gif:AnimationBehavior.SourceUri="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/wait.gif" 
                ForceCursor="True" 
                Cursor="Hand" 
                Opacity="0.4"
                IsHitTestVisible="False"></Image>

    </Grid>
</UserControl>
