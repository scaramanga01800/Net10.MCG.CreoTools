                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="6"></TextBlock>
                                    </StackPanel>
                                </Fluent:MenuItem.Header>
                            </Fluent:MenuItem>
