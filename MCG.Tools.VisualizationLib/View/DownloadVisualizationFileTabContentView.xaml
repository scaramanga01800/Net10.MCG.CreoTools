                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="11"></TextBlock>
                                    </StackPanel>
                                </Fluent:MenuItem.Header>
                            </Fluent:MenuItem>
                            <Fluent:MenuItem Command="{Binding CommandMenuItemSearchBom}" CommandParameter="12">
                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="12"></TextBlock>
                                    </StackPanel>
                                </Fluent:MenuItem.Header>
                            </Fluent:MenuItem>
                        </Fluent:MenuItem>

                        <Fluent:MenuItem Header="{DynamicResource VIS_MiSearchSapBom}" >
                            <Fluent:MenuItem.Style>
                                <Style TargetType="Fluent:MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PART}">
                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Fluent:MenuItem.Style>
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource STRUCTURE_SAP}"></Image>
                            </Fluent:MenuItem.Icon>
                            <Fluent:MenuItem Command="{Binding CommandMenuItemSearchSapBom}" CommandParameter="1">
                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="1"></TextBlock>
                                    </StackPanel>
                                </Fluent:MenuItem.Header>
                            </Fluent:MenuItem>
