                        <Fluent:MenuItem Header="{DynamicResource VIS_MiDeletePart}" Command="{Binding CommandMenuItemDeletePart}"  >
                            <Fluent:MenuItem.Style>
                                <Style TargetType="Fluent:MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
