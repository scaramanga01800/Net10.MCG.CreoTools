                                    </Style.Triggers>
                                </Style>
                            </Fluent:MenuItem.Style>
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource STRUCTURE}"></Image>
                            </Fluent:MenuItem.Icon>
                            <Fluent:MenuItem Command="{Binding CommandMenuItemSearchBom}" CommandParameter="1">
                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
