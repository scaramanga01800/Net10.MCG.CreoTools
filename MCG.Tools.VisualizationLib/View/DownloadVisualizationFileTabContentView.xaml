<UserControl x:Class="MCG.Tools.VisualizationLib.View.DownloadVisualizationFileTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.VisualizationLib.View"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:localVM="clr-namespace:MCG.Tools.VisualizationLib.ViewModel"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:VisuFile="clr-namespace:MCG.Tools.VisualizationLib.ViewModel"
             xmlns:MCGEnum="clr-namespace:MCG.CommonLib.Models.Enums;assembly=MCG.CommonLib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <behaviors:Interaction.Triggers>
        <behaviors:EventTrigger EventName="KeyDown">
            <behaviors:InvokeCommandAction Command="{Binding CommandPaste}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
        </behaviors:EventTrigger>
    </behaviors:Interaction.Triggers>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="PASTE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/paste.gif" />
            <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/part.gif" />
            <BitmapImage x:Key="ECN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/chgnotice.gif" />
            <BitmapImage x:Key="DELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <BitmapImage x:Key="WORD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Word.ico" />
            <BitmapImage x:Key="EXCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico" />
            <BitmapImage x:Key="POWERPOINT" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PowerPoint.ico" />
            <BitmapImage x:Key="PDF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Pdf.ico" />
            <BitmapImage x:Key="TIFF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Image.ico" />
            <BitmapImage x:Key="DXF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dxf.ico" />
            <BitmapImage x:Key="DWG" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dwg.ico" />
            <BitmapImage x:Key="STEP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Stp_64x64.png" />
            <BitmapImage x:Key="IGES" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Igs_64x64.png" />
            <BitmapImage x:Key="PVZ" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/creo_view.png" />
            <BitmapImage x:Key="OTHER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Document_64x64.png" />
            <BitmapImage x:Key="UNKNOWN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/unknown_doc.gif" />
            <BitmapImage x:Key="STRUCTURE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Structure.ico" />
            <BitmapImage x:Key="STRUCTURE_SAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Structure_SAP.ico" />
            <BitmapImage x:Key="DRAGDROP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/drag_and_drop.png" />
            <BitmapImage x:Key="NEW" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/new.ico" />
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>
            <Style x:Key="Body_Content_DataGrid_Centering"
                        TargetType="{x:Type DataGridCell}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <DockPanel x:Name="MainDockPanel" 
               AllowDrop="False" 
               Drop="DockPanel_Drop" 
               DragEnter="MainDockPanel_DragEnter" 
               DragLeave="MainDockPanel_DragLeave">

            <Fluent:StatusBar DockPanel.Dock="Bottom" Height="20">
                <Fluent:StatusBarItem HorizontalAlignment="Left" 
                                  Margin="5,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource VIS_StatusBarNbElem}" Margin="0,0,5,0"></TextBlock>
                        <TextBlock Text="{Binding CurrentDataContext.SearchedPartList.Count}"></TextBlock>
                    </StackPanel>
                </Fluent:StatusBarItem>
                <Fluent:StatusBarItem HorizontalAlignment="Right" 
                                  Margin="0,0,5,0"
                                  Visibility="{Binding CurrentDataContext.IsSearchInProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding CurrentDataContext.StatusBarTextRight}"></TextBlock>
                </Fluent:StatusBarItem>
                <Fluent:StatusBarItem Title="ProgressBar"                                     
                                  HorizontalAlignment="Right"
                                  Margin="0,0,5,0">
                    <Fluent:StatusBarItem.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentDataContext.CurrentStep}" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Text="\" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Text="{Binding CurrentDataContext.TotalStep}" VerticalAlignment="Center"></TextBlock>
                        </StackPanel>
                    </Fluent:StatusBarItem.ToolTip>
                    <ProgressBar Height="17"
                             Width="250"
                             Maximum="{Binding CurrentDataContext.TotalStep}" 
                             Value="{Binding CurrentDataContext.CurrentStep}"
                             Visibility="{Binding CurrentDataContext.IsSearchInProgress, Converter={StaticResource BoolToVisibilityConverter}}"></ProgressBar>
                </Fluent:StatusBarItem>
            </Fluent:StatusBar>
            <DataGrid x:Name="DgParts"
                      ItemsSource="{Binding  CurrentDataContext.SearchedPartList}" 
                      SelectedItem="{Binding CurrentDataContext.SelectedPart, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="False" 
                      RowDetailsVisibilityMode="Visible"
                      CanUserAddRows="False"
                      CellStyle="{StaticResource Body_Content_DataGrid_Centering}">

                <behaviors:Interaction.Triggers>
                    <behaviors:EventTrigger EventName="KeyDown">
                        <behaviors:InvokeCommandAction Command="{Binding CommandPaste}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
                    </behaviors:EventTrigger>
                </behaviors:Interaction.Triggers>

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ItemFrom}" Value="{x:Static MCGEnum:DocumentTypeEnum.FROMECN}">
                                <Setter Property="Background" Value="#C8FFC4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ItemFrom}" Value="{x:Static MCGEnum:DocumentTypeEnum.FROMBOM}">
                                <Setter Property="Background" Value="#C4EBFF"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                <Setter Property="ToolTip" Value="{Binding DetailComment}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                <Setter Property="ToolTip" Value="{Binding DetailComment}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>

                </DataGrid.Resources>

                <DataGrid.ContextMenu>
                    <Fluent:ContextMenu>
                        <Fluent:MenuItem Header="{DynamicResource VIS_MiPastePart}" Command="{Binding CommandMenuItemPastePart}">
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource PASTE}"></Image>
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="{DynamicResource VIS_MiOpenPart}" Command="{Binding CommandMenuItemOpenPart}"   >
                            <Fluent:MenuItem.Style>
                                <Style TargetType="Fluent:MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PART}">
                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Fluent:MenuItem.Style>
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource PART}"></Image>
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="{DynamicResource VIS_MiOpenEcn}" Command="{Binding CommandMenuItemOpenEcn}" >
                            <Fluent:MenuItem.Style>
                                <Style TargetType="Fluent:MenuItem">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                            <Setter Property="Visibility" Value="Visible"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart.ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PART}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentDataContext.SelectedPart}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Fluent:MenuItem.Style>
                            <Fluent:MenuItem.Icon>
                                <Image Source="{StaticResource ECN}"></Image>
                            </Fluent:MenuItem.Icon>
                        </Fluent:MenuItem>
                        <Fluent:MenuItem Header="{DynamicResource VIS_MiSearchBom}" >
