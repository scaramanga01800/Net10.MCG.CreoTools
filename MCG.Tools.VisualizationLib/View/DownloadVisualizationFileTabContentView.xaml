                    </Fluent:ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.RowDetailsTemplate >
                    <DataTemplate>
                        <StackPanel x:Name="SpRowDetailTemplate"
                                Orientation="Horizontal" 
                                Visibility="{Binding IsDocumentFound, Converter={StaticResource BoolToVisibilityConverter}}" 
                                Background="#FFECECEC">
                            <Rectangle Width="15"></Rectangle>
                            <Fluent:CheckBox VerticalAlignment="Center" IsChecked="{Binding IsAllSelected,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></Fluent:CheckBox>
                            <Rectangle Width="15"></Rectangle>
                            <StackPanel>
                                <TreeView ItemsSource="{Binding  SearchedDocumentList}" Background="{Binding ElementName=SpRowDetailTemplate,Path=Background}" BorderThickness="0">
                                    <TreeView.ContextMenu>
                                        <Fluent:ContextMenu Visibility="Collapsed">
                                            <Fluent:MenuItem Header="TEST"  >
                                            </Fluent:MenuItem>
                                        </Fluent:ContextMenu>
                                    </TreeView.ContextMenu>
                                    <TreeView.ItemTemplate>
                                        <DataTemplate >
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Fluent:CheckBox Margin="5,0,10,0" IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=False}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image Height="25" IsHitTestVisible="False">
                                                    <Image.Style>
                                                        <Style TargetType="{x:Type Image}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.WORD}">
                                                                    <Setter Property="Source" Value="{StaticResource WORD}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipWord}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.EXCEL}">
                                                                    <Setter Property="Source" Value="{StaticResource EXCEL}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipExcel}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.POWERPOINT}">
                                                                    <Setter Property="Source" Value="{StaticResource POWERPOINT}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPowerPoint}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PDF}">
                                                                    <Setter Property="Source" Value="{StaticResource PDF}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPdf}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.TIFF}">
                                                                    <Setter Property="Source" Value="{StaticResource TIFF}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipTiff}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.DXF}">
                                                                    <Setter Property="Source" Value="{StaticResource DXF}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipDxf}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.DWG}">
                                                                    <Setter Property="Source" Value="{StaticResource DWG}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipDwg}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.STEP}">
                                                                    <Setter Property="Source" Value="{StaticResource STEP}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipStep}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.IGES}">
                                                                    <Setter Property="Source" Value="{StaticResource IGES}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipIges}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PVZ}">
                                                                    <Setter Property="Source" Value="{StaticResource PVZ}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPvz}"></Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.OTHER}">
                                                                    <Setter Property="Source" Value="{StaticResource OTHER}" />
                                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipOther}"></Setter>
                                                                </DataTrigger>

                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding DocumentNumber}" Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False"></TextBlock>
                                                <TextBlock Text="{Binding DocumentRevision}" Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False"></TextBlock>
                                                <TextBlock Text="{Binding Comment}" Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False"></TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.Header>
                            <Fluent:CheckBox  IsChecked="{Binding Data.CurrentDataContext.IsAllPartSelected,Source={StaticResource proxy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                <behaviors:Interaction.Triggers>
                                    <behaviors:EventTrigger EventName="Checked">
                                        <behaviors:InvokeCommandAction Command="{Binding Data.CommandCheckUncheckAll, Source={StaticResource proxy} }" CommandParameter="{StaticResource TrueValue}" ></behaviors:InvokeCommandAction>
                                    </behaviors:EventTrigger>

                                    <behaviors:EventTrigger EventName="Unchecked">
                                        <behaviors:InvokeCommandAction Command="{Binding Data.CommandCheckUncheckAll, Source={StaticResource proxy} }" CommandParameter="{StaticResource FalseValue}" ></behaviors:InvokeCommandAction>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                            </Fluent:CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Fluent:CheckBox  IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=False}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center">
                                </Fluent:CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn CanUserResize="False" CanUserSort="True" SortMemberPath="ItemType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Height="20" >
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PART}">
                                                    <Setter Property="Source" Value="{StaticResource PART}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPart}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                                    <Setter Property="Source" Value="{StaticResource ECN}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipEcn}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.UNKNOWN}">
                                                    <Setter Property="Source" Value="{StaticResource UNKNOWN}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipUnknown}"></Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn  Binding="{Binding PartNumber}" 
                                         IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColPartNumber}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn>

                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PART}">
                                        <Setter Property="IsEnabled" Value="True" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.ECN}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ItemType}" Value="{x:Static MCGEnum:DocumentTypeEnum.UNKNOWN}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTemplateColumn.CellStyle>

                        <DataGridTemplateColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColPartRevision}"></Label>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox IsEditable="False" 
                                          Text="{Binding PartRevision,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AllPartRevisionState}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} - {1}">
                                                            <Binding Path="Revision" />
                                                            <Binding Path="State" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Image Width="12"
                                           Height="12"
                                           Margin="0,0,4,0"
                                           Source="{StaticResource NEW}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLatestRevisionSelected}"
                                                                 Value="False">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                        <Image.ToolTip>
                                            <ToolTip>
                                                A newer revision exists.
                                                The displayed revision is the latest approved revision.
                                            </ToolTip>
                                        </Image.ToolTip>
                                    </Image>

                                    <TextBlock Text="{Binding PartRevision}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <!--<DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center" Text="{Binding PartRevision}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>-->
                    </DataGridTemplateColumn>

                    <DataGridTextColumn  Binding="{Binding State}" IsReadOnly="True">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColState}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn CanUserSort="True" SortMemberPath="Comment">
                        <DataGridTemplateColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColComment}"></Label>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Comment}">
                                    <TextBlock.ToolTip>
                                        <Fluent:TwoLineLabel Text="{Binding DetailComment}"></Fluent:TwoLineLabel>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn  Binding="{Binding AddedFrom}" IsReadOnly="True"
                                     Visibility="{Binding Data.CurrentDataContext.IsColAddedFromShown,Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColAddedFrom}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding DescriptionEng}" IsReadOnly="True"
                                     Visibility="{Binding Data.CurrentDataContext.IsColDescriptionEngShown,Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColDescriptionEng}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding DescriptionLocal}" IsReadOnly="True"
                                     Visibility="{Binding Data.CurrentDataContext.IsColDescriptionLocalShown,Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColDescriptionLocal}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding PdmContext}" IsReadOnly="True"
                                     Visibility="{Binding Data.CurrentDataContext.IsColPdmContextShown,Source={StaticResource proxy}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGridTextColumn.Header>
                            <Label Content="{DynamicResource VIS_LabelColPdmContext}"></Label>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>
        </DockPanel>
        <Image x:Name="ImageDragDrop"
               Source="{StaticResource DRAGDROP}" 
               MaxHeight="300"
               Opacity="0.5"
               Visibility="Collapsed"
               IsHitTestVisible="False"></Image>
    </Grid>
</UserControl>
