                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource VIS_MiSearchBomLevel}"></TextBlock>
                                        <TextBlock Margin="5,0,0,0" Text="2"></TextBlock>
                                    </StackPanel>
                                </Fluent:MenuItem.Header>
                            </Fluent:MenuItem>
                            <Fluent:MenuItem Command="{Binding CommandMenuItemSearchSapBom}" CommandParameter="3">
                                <Fluent:MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
