<UserControl x:Class="MCG.Tools.VisualizationLib.View.ConvertToPdfTabContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.VisualizationLib.View"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:MCGEnum="clr-namespace:MCG.CommonLib.Models.Enums;assembly=MCG.CommonLib"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="DRAGDROP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/drag_and_drop.png" />
            <BitmapImage x:Key="WORD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Word.ico" />
            <BitmapImage x:Key="EXCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico" />
            <BitmapImage x:Key="POWERPOINT" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/PowerPoint.ico" />
            <BitmapImage x:Key="PDF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Pdf.ico" />
            <BitmapImage x:Key="TIFF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Image.ico" />
            <BitmapImage x:Key="DXF" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dxf.ico" />
            <BitmapImage x:Key="DWG" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dwg.ico" />
            <BitmapImage x:Key="STEP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Stp_64x64.png" />
            <BitmapImage x:Key="IGES" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Igs_64x64.png" />
            <BitmapImage x:Key="PVZ" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/creo_view.png" />
            <BitmapImage x:Key="OTHER" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Document_64x64.png" />
            <System:Boolean x:Key="FalseValue">False</System:Boolean>
            <System:Boolean x:Key="TrueValue">True</System:Boolean>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
            <Style x:Key="Body_Content_DataGrid_Centering"
                   TargetType="{x:Type DataGridCell}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type DataGridCell}">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>


    <DockPanel x:Name="MainSP" 
               AllowDrop="True" 
               Drop="MainSP_Drop"
               DragEnter="MainSP_DragEnter"
               DragLeave="MainSP_DragLeave">
        <behaviors:Interaction.Triggers>
            <behaviors:EventTrigger EventName="Drop">
                <behaviors:InvokeCommandAction Command="{Binding CommandDrop}" PassEventArgsToCommand="True"></behaviors:InvokeCommandAction>
            </behaviors:EventTrigger>
        </behaviors:Interaction.Triggers>
        <Grid>
            <DataGrid x:Name="DgFiles" 
                      ItemsSource="{Binding CurrentDataContext.ListConvertItem}" 
                      IsReadOnly="True" 
                      AutoGenerateColumns="False"
                      CellStyle="{StaticResource Body_Content_DataGrid_Centering}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn CanUserSort="True" 
                                            SortMemberPath="IsSelected"
                                            CanUserResize="False">
                        <DataGridTemplateColumn.Header>
                            <Fluent:CheckBox  IsChecked="{Binding Data.CurrentDataContext.IsAllPartSelected,Source={StaticResource proxy},Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}">
                                <behaviors:Interaction.Triggers>
                                    <behaviors:EventTrigger EventName="Checked">
                                        <behaviors:InvokeCommandAction Command="{Binding Data.CommandCheckUncheckAll, Source={StaticResource proxy} }" CommandParameter="{StaticResource TrueValue}" ></behaviors:InvokeCommandAction>
                                    </behaviors:EventTrigger>

                                    <behaviors:EventTrigger EventName="Unchecked">
                                        <behaviors:InvokeCommandAction Command="{Binding Data.CommandCheckUncheckAll, Source={StaticResource proxy} }" CommandParameter="{StaticResource FalseValue}" ></behaviors:InvokeCommandAction>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                            </Fluent:CheckBox>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Fluent:CheckBox IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=False}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center">
                                </Fluent:CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn CanUserSort="True" 
                                            SortMemberPath="DocumentType"
                                            CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Height="25" IsHitTestVisible="False">
                                    <Image.Style>
                                        <Style TargetType="{x:Type Image}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.WORD}">
                                                    <Setter Property="Source" Value="{StaticResource WORD}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipWord}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.EXCEL}">
                                                    <Setter Property="Source" Value="{StaticResource EXCEL}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipExcel}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.POWERPOINT}">
                                                    <Setter Property="Source" Value="{StaticResource POWERPOINT}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPowerPoint}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PDF}">
                                                    <Setter Property="Source" Value="{StaticResource PDF}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPdf}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.TIFF}">
                                                    <Setter Property="Source" Value="{StaticResource TIFF}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipTiff}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.DXF}">
                                                    <Setter Property="Source" Value="{StaticResource DXF}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipDxf}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.DWG}">
                                                    <Setter Property="Source" Value="{StaticResource DWG}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipDwg}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.STEP}">
                                                    <Setter Property="Source" Value="{StaticResource STEP}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipStep}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.IGES}">
                                                    <Setter Property="Source" Value="{StaticResource IGES}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipIges}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.PVZ}">
                                                    <Setter Property="Source" Value="{StaticResource PVZ}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipPvz}"></Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding DocumentType}" Value="{x:Static MCGEnum:DocumentTypeEnum.OTHER}">
                                                    <Setter Property="Source" Value="{StaticResource OTHER}" />
                                                    <Setter Property="ToolTip" Value="{DynamicResource VIS_DocToolTipOther}"></Setter>
                                                </DataTrigger>

                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{DynamicResource VIS_ColFileName}" 
                                        Binding="{Binding OrigFileName}">
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="{DynamicResource VIS_ColStatus}"
                                        Binding="{Binding Status}">
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Image x:Name="ImageDragDrop"
                   Source="{StaticResource DRAGDROP}" 
                   MaxHeight="300"
                   Opacity="0.5"
                   Visibility="Collapsed"
                   IsHitTestVisible="False"></Image>
        </Grid>

    </DockPanel>
</UserControl>
