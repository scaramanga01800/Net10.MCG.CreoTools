<UserControl x:Class="MCG.Tools.EcnDataCheck.View.EcnDataCheckMoveTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:local="clr-namespace:MCG.Tools.EcnDataCheck.View"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <CollectionViewSource x:Key="WindchillContextList" Source="{Binding CurrentEcnDataCheckDataContext.WindchillContextList}" />
            <BitmapImage x:Key="Copy" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/page_copy.png" />
            <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="400"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label HorizontalContentAlignment="Center" 
               VerticalContentAlignment="Center" 
               Content="{DynamicResource EDC_LabelSendMail}" 
               Background="LightGray" 
               Margin="1"></Label>
            <Button Name="BtSendMail" 
                Command="{Binding CommandMoveSendMail}" 
                Grid.Column="2" 
                Content="{DynamicResource EDC_BtSendMail}"></Button>
            <Grid Grid.Column="1" Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>
                <Label HorizontalContentAlignment="Right" 
                   VerticalContentAlignment="Center" 
                   Content="{DynamicResource EDC_LabelLocation}" 
                   Background="LightGray"></Label>
                <ComboBox Name="CbListLocation" 
                      Grid.Column="1" 
                      ItemsSource="{Binding CurrentEcnDataCheckDataContext.ListLocation}" 
                      SelectedItem="{Binding CurrentEcnDataCheckDataContext.SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   
                      VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></ComboBox>
                <CheckBox  Grid.Column="0" 
                       Grid.Row="1" 
                       Content="{DynamicResource EDC_CbProduct}" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       IsChecked="{Binding CurrentEcnDataCheckDataContext.IsCheckBoxProductSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Command="{Binding CommandMoveUdpateContextList}"></CheckBox>
                <CheckBox Grid.Column="1" 
                      Grid.Row="1" 
                      Content="{DynamicResource EDC_CbLibrary}" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center" 
                      IsChecked="{Binding CurrentEcnDataCheckDataContext.IsCheckBoxLibraySelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      Command="{Binding CommandMoveUdpateContextList}"></CheckBox>
                <Label Grid.Column="0" 
                   Grid.Row="2" 
                   HorizontalContentAlignment="Right" 
                   VerticalContentAlignment="Center" 
                   Content="{DynamicResource EDC_LabelContextFilter}" 
                   Background="LightGray"></Label>

                <TextBox Grid.Column="1" 
                     Grid.Row="2" 
                     Text="{Binding CurrentEcnDataCheckDataContext.ContextFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=Filter}" 
                     VerticalContentAlignment="Center" 
                     ToolTip="{DynamicResource EDC_ToolTipSearchKeyWord}">
                    <behaviors:Interaction.Triggers>
                        <behaviors:EventTrigger EventName="KeyUp" >
                            <behaviors:InvokeCommandAction Command="{Binding CommandMoveUdpateContextList}"/>
                        </behaviors:EventTrigger>
                    </behaviors:Interaction.Triggers>
                </TextBox>

                <Label Grid.Column="2" 
                   Grid.Row="0" 
                   HorizontalContentAlignment="Center" 
                   VerticalContentAlignment="Center" 
                   Content="{DynamicResource EDC_LabelApplyContextAll}" 
                   Background="LightGray"></Label>
                <ComboBox Grid.Column="2"
                      Grid.Row="1" 
                      ItemsSource="{Binding CurrentEcnDataCheckDataContext.WindchillContextList}" 
                      SelectedItem="{Binding CurrentEcnDataCheckDataContext.SelectedContext, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   
                      VerticalContentAlignment="Center" 
                      HorizontalContentAlignment="Center"  >
                    <behaviors:Interaction.Triggers>
                        <behaviors:EventTrigger EventName="SelectionChanged" >
                            <behaviors:InvokeCommandAction Command="{Binding CommandSetContextToAll}"/>
                        </behaviors:EventTrigger>
                    </behaviors:Interaction.Triggers>
                </ComboBox>
            </Grid>
        </Grid>

        <DataGrid Name="DataGridMove" 
              IsReadOnly="False" 
              GridLinesVisibility="All" 
              CanUserAddRows="False" 
              SelectedItem="{Binding CurrentEcnDataCheckDataContext.SelectedMoveItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
              ItemsSource="{Binding CurrentEcnDataCheckDataContext.MoveItemList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
              AutoGenerateColumns="False"  >
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="CmCheckedPart" Visibility="{Binding CurrentEcnDataCheckDataContext.SelectedMoveItem, Converter={StaticResource SelectItemToVisibilityConv}}">
                    <MenuItem x:Name="MiCopyPartNumber" Command="{Binding CommandCopyPartNumber}" CommandParameter="{Binding CurrentEcnDataCheckDataContext.SelectedMoveItem.EcnWtPart.Number}" Header="{DynamicResource EDC_MiCopyPartNumber}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Copy}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Number}"  IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader01}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Context}"  IsReadOnly="True" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader23}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Folder}"  IsReadOnly="True" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader24}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTemplateColumn SortMemberPath="NewContextName">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader25}"></TextBlock>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" 
                                  SelectedItem="{Binding NewContextName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                  Text="{Binding NewContextName, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" 
                                  ItemsSource="{Binding  WindchillContextList}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Binding="{Binding NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader26}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
