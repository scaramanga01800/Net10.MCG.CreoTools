<Fluent:RibbonWindow x:Class="MCG.Tools.EcnDataCheck.View.EcnDataCheckEcaSelection"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.EcnDataCheck.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="{DynamicResource EDC_WindowSelectEca}" 
                     Height="150" Width="300" 
                     ShowInTaskbar="False" 
                     Topmost="True"  
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/programs.ico">
    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="Close" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Close.png" />
            <BitmapImage x:Key="Check" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.png" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <GradientStop Color="{DynamicResource Fluent.Ribbon.Colors.AccentColor20}"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Fluent:TwoLineLabel Text="{DynamicResource EDC_LabelSelectEca}"
                         HasTwoLines="False"
                         Background="#FFC9C9CA" 
                         HorizontalAlignment="Center"
                         HorizontalContentAlignment="Center" 
                         VerticalContentAlignment="Center" 
                         FontSize="18"></Fluent:TwoLineLabel>
        <Fluent:ComboBox x:Name="CbSelection"
                     Height="30"
                     Margin="0,0,8,0"
                     Grid.Row="1" 
                     HorizontalContentAlignment="Center" 
                     VerticalContentAlignment="Center" 
                     FontSize="18" 
                     ItemsSource="{Binding EcaList}" 
                     SelectedItem="{Binding EcaNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ></Fluent:ComboBox>
        <StackPanel DockPanel.Dock="Bottom" 
                Name="StackPanelButton" 
                Grid.Row="2" 
                Orientation="Horizontal" 
                HorizontalAlignment="Center" 
                Height="32" Margin="0,2" 
                Width="{Binding ActualWindowWidth,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}">

            <Button ToolTip="{Binding BtOkValue, FallbackValue=OK}" 
                Click="BtOK_Click">
                <Image Source="{StaticResource ResourceKey=Check}"></Image>
            </Button>
            <Rectangle Width="50"></Rectangle>
            <Button  ToolTip="{Binding BtCancelValue, FallbackValue=Cancel}" 
                 Click="BtCancel_Click">
                <Image Source="{StaticResource ResourceKey=Close}"></Image>
            </Button>
        </StackPanel>

    </Grid>
</Fluent:RibbonWindow>
