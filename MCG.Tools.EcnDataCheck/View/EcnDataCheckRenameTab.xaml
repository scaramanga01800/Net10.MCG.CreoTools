<UserControl x:Class="MCG.Tools.EcnDataCheck.View.EcnDataCheckRenameTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.EcnDataCheck.View"
             xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="500">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <CollectionViewSource x:Key="WebTermList" Source="{Binding CurrentEcnDataCheckDataContext.WebTermList}" />
            <BitmapImage x:Key="Copy" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/page_copy.png" />
            <conv:SelectedItemToVisibilityConverter x:Key="SelectItemToVisibilityConv"></conv:SelectedItemToVisibilityConverter>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Height="30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="{DynamicResource EDC_LabelSendMail}" Background="LightGray" Margin="1"></Label>
            <Button Name="BtSendMail" Command="{Binding CommandRenameSendMail}" Grid.Column="2" Content="{DynamicResource EDC_BtSendMail}"></Button>
            <Grid Grid.Column="1" Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Content="{DynamicResource EDC_LabelLocation}" Background="LightGray"></Label>
                <ComboBox Name="CbListLocation" Grid.Column="1"  ItemsSource="{Binding CurrentEcnDataCheckDataContext.ListLocation}"  SelectedItem="{Binding CurrentEcnDataCheckDataContext.SelectedLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"   VerticalContentAlignment="Center" HorizontalContentAlignment="Center"></ComboBox>
            </Grid>
        </Grid>
        <DataGrid IsReadOnly="False" GridLinesVisibility="All" CanUserAddRows="False" SelectedItem="{Binding CurrentEcnDataCheckDataContext.SelectedRenameItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CurrentEcnDataCheckDataContext.RenameItemList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutoGenerateColumns="False"  >
            <DataGrid.ContextMenu>
                <ContextMenu x:Name="CmCheckedPart" Visibility="{Binding CurrentEcnDataCheckDataContext.SelectedRenameItem, Converter={StaticResource SelectItemToVisibilityConv}}">
                    <MenuItem x:Name="MiCopyPartNumber" Command="{Binding CommandCopyPartNumber}" CommandParameter="{Binding CurrentEcnDataCheckDataContext.SelectedRenameItem.EcnWtPart.Number}" Header="{DynamicResource EDC_MiCopyPartNumber}">
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Copy}" Width="16" ></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Number}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader01}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Revision}" IsReadOnly="True" >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader02}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding EcnWtPart.Name}"  IsReadOnly="True"  >
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader21}"></TextBlock>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridComboBoxColumn   ItemsSource="{Binding Source={StaticResource WebTermList}}" TextBinding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False">
                    <DataGridComboBoxColumn.Header>
                        <TextBlock Text="{DynamicResource EDC_ColHeader22}"></TextBlock>
                    </DataGridComboBoxColumn.Header>
                </DataGridComboBoxColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
