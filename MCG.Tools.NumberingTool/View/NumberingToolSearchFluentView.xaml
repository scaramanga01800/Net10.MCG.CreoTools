<UserControl x:Class="MCG.Tools.NumberingTool.View.NumberingToolSearchFluentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.NumberingTool.View"
             xmlns:Fluent="urn:fluent-ribbon"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BitmapImage x:Key="Update" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Modify_16x16.png" />
        <BitmapImage x:Key="Search" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Search_32x32.png" />
        <BitmapImage x:Key="Check" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico" />
        <BitmapImage x:Key="Drawing" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/pdf.ico" />
        <BitmapImage x:Key="PART" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/part.gif" />
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="25,5" 
                HorizontalAlignment="Left">
            <Fluent:TextBox Width="250" 
                            Margin="2"
                            Fluent:InputControlProperties.InputWidth="150"
                            Header="{DynamicResource NUT_LabelNumber}"
                            Text="{Binding SearchNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            VerticalContentAlignment="Center" 
                            ToolTip="{DynamicResource NUT_ToolTipSearchKeyWord}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CommandStartSearch}"/>
                </TextBox.InputBindings>
            </Fluent:TextBox>

            <Fluent:TextBox Width="250" 
                            Margin="2"
                            Fluent:InputControlProperties.InputWidth="150"
                            Header="{DynamicResource NUT_LabelDescription}"
                            Text="{Binding SearchDescription,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                            VerticalContentAlignment="Center"  
                            ToolTip="{DynamicResource NUT_ToolTipSearchKeyWord}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CommandStartSearch}"/>
                </TextBox.InputBindings>
            </Fluent:TextBox>

            <Fluent:ComboBox Width="250"
                             Margin="2"
                             Fluent:InputControlProperties.InputWidth="150"
                             IsEditable="True" 
                             Header="{DynamicResource NUT_LabelProduct}"
                             ItemsSource="{Binding SearchProductList}" 
                             Text="{Binding SearchProduct,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"  
                             ToolTip="{DynamicResource NUT_ToolTipSearchKeyWord}">
                <Fluent:ComboBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CommandStartSearch}"/>
                </Fluent:ComboBox.InputBindings>
            </Fluent:ComboBox>

            <Fluent:ComboBox Width="250" 
                             Margin="2"
                             Fluent:InputControlProperties.InputWidth="150"
                             IsEditable="True" 
                             Header="{DynamicResource NUT_LabelCreator}"
                             ItemsSource="{Binding SearchCreatedByList}" 
                             Text="{Binding SearchCreatedBy,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"  
                             ToolTip="{DynamicResource NUT_ToolTipSearchKeyWord}">
                <Fluent:ComboBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CommandStartSearch}"/>
                </Fluent:ComboBox.InputBindings>
            </Fluent:ComboBox>

            <StackPanel HorizontalAlignment="Center" Margin="5,20,5,10">
                <Fluent:TwoLineLabel HasTwoLines="False"
                                 Text="{DynamicResource NUT_LabelCreatedOn}" 
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource IdealForegroundColor}"
                                 Margin="0,0,0,5"></Fluent:TwoLineLabel>
                <StackPanel Orientation="Horizontal" Height="30">
                    <Fluent:TwoLineLabel Width="30" 
                                     HasTwoLines="False" 
                                     Text="{DynamicResource NUT_LabelFrom}"
                                     Foreground="{DynamicResource IdealForegroundColor}"
                                     HorizontalAlignment="Right"></Fluent:TwoLineLabel>
                    <DatePicker Width="110" 
                            Margin="1" 
                            SelectedDate="{Binding SearchCreatedAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                    <Fluent:TwoLineLabel Margin="20,0,0,0"
                                     HasTwoLines="False" 
                                     Text="{DynamicResource NUT_LabelTo}"
                                     Foreground="{DynamicResource IdealForegroundColor}"
                                     HorizontalAlignment="Right"></Fluent:TwoLineLabel>
                    <DatePicker Width="110" 
                            Margin="1" 
                            SelectedDate="{Binding SearchCreatedBefore,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
                </StackPanel>
            </StackPanel>

            <Button  Height="32" Width="32" Command="{Binding CommandStartSearch}" ToolTip="{DynamicResource NUT_ToolTipSearch}" Margin="5">
                <Image Source="{StaticResource Search}"></Image>
            </Button>

        </StackPanel>
        <StatusBar DockPanel.Dock="Bottom" 
               Margin="5,0,5,5">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource NUT_NumberFound}" Margin="0,0,2,0"></TextBlock>
                    <TextBlock VerticalAlignment="Center" Text="{Binding ListSearchNumber.Count}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <DataGrid ItemsSource="{Binding ListSearchNumber}"  
              SelectedItem="{Binding SelectedSearchNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
              IsReadOnly="True" 
              CanUserAddRows="False" 
              AutoGenerateColumns="False"
              Margin="5,0,5,0">

            <behaviors:Interaction.Triggers>
                <behaviors:EventTrigger EventName="MouseDoubleClick">
                    <behaviors:InvokeCommandAction Command="{Binding CommandUseSearchNumber}"></behaviors:InvokeCommandAction>
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem  Header="{DynamicResource NUT_BtUseNumber}" Command="{Binding CommandUseSearchNumber}"  >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Check}"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="{DynamicResource NUT_BtActionUpdate}" Command="{Binding CommandUpdateNumber}"  >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Update}"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="{DynamicResource NUT_BtActionDownloadDrawing}" Command="{Binding CommandDownloadDrawing}"  >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Drawing}"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem  Header="{DynamicResource NUT_BtActionOpenPart}" Command="{Binding CommandOpenPartDetail}"  >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=PART}"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding Number}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelNumber}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding Product}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelProduct}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding Description}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelDescription}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding Format}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelFormat}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding CreatedBy}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelCreator}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding CreatedOn,StringFormat='dd/MM/yyyy'}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelCreatedOn}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
