<Fluent:RibbonWindow x:Class="MCG.Tools.NumberingTool.View.NumberingToolCreateSeveralFluentView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                     xmlns:local="clr-namespace:MCG.Tools.NumberingTool.View"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                     mc:Ignorable="d"
                     Title="{DynamicResource NUT_TitlePartNumber}" 
                     Height="300" Width="300" 
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/part.gif" >

    <Window.Resources>
        <ResourceDictionary>
            <BitmapImage x:Key="Close" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <BitmapImage x:Key="Check" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico" />
            <BitmapImage x:Key="Update" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save_32x32.png" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" ></conv:BoolToVisibilityConverter>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" ></conv:InverseBoolToVisibilityConverter>
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <DockPanel.Background>
            <LinearGradientBrush >
                <GradientStop Color="{DynamicResource Fluent.Ribbon.Colors.AccentColor20}"/>
            </LinearGradientBrush>
        </DockPanel.Background>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <Fluent:TwoLineLabel HasTwoLines="False"
                             Margin="0,0,2,0"
                             Text="{DynamicResource NUT_LabelNumberingRange}"></Fluent:TwoLineLabel>
            <Fluent:TwoLineLabel HasTwoLines="False"
                             Margin="0,0,2,0"
                             Text="{Binding SelectedNumberingTemplate}"></Fluent:TwoLineLabel>
            <Fluent:ComboBox VerticalContentAlignment="Center"
                         Fluent:InputControlProperties.InputWidth="40"
                         Margin="10,0,2,0"
                         IsEditable="False"
                         Header="{DynamicResource NUT_LabelSizeBlock}"
                         ItemsSource="{Binding ListSizeBlock}" 
                         SelectedItem="{Binding SelectedSizeBlock, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></Fluent:ComboBox>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <StackPanel DockPanel.Dock="Bottom" Name="StackPanelButton" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Height="32" Margin="0,2" Width="{Binding ActualWindowWidth,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}">
                <Button ToolTip="{DynamicResource NUT_BtCreate}" Command="{Binding CommandStartCreateSeveralNumbers}" Visibility="{Binding IsSeveralNumberCreated,Converter={StaticResource InverseBoolToVisibilityConverter}}" >
                    <Image   Source="{StaticResource Check}"></Image>
                </Button>
                <!--<Button ToolTip="{DynamicResource NUT_BtUpdate}" Command="{Binding CommandStartUpdateSeveralNumbers}"  Visibility="{Binding IsSeveralNumberCreated,Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                <Image   Source="{StaticResource Update}"></Image>
            </Button>-->
                <Button ToolTip="{DynamicResource NUT_BtUpdate}" Command="{Binding CommandStartUpdateSeveralNumbers}"  Visibility="{Binding IsUpdateShown,Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <Image   Source="{StaticResource Update}"></Image>
                </Button>
                <Rectangle Width="100"></Rectangle>
                <Button  ToolTip="{DynamicResource NUT_BtCancel}" Command="{Binding CommandCancel}">
                    <Image   Source="{StaticResource Close}"></Image>
                </Button>
            </StackPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding ListNewNumber}"  SelectedItem="{Binding SelectedNewNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False" AutoGenerateColumns="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpdated}" Value="False">
                            <Setter Property="Background" Value="White"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUpdated}" Value="True">
                            <Setter Property="Background" Value="Yellow"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem  Header="{DynamicResource NUT_BtUseNumber}" Command="{Binding CommandUseNewNumber}"  >
                        <MenuItem.Icon>
                            <Image Source="{StaticResource ResourceKey=Check}"></Image>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding Number}"  IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelNumber}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <!--<DataGridTextColumn  Binding="{Binding Product}" IsReadOnly="False">
                <DataGridTextColumn.Header>
                    <Label Content="{DynamicResource NUT_LabelProduct}" ></Label>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>-->

                <DataGridTemplateColumn Visibility="{Binding Data.IsUpdateShown,Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <DataGridTemplateColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelProduct}" ></Label>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Product, Mode=OneWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Product, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        ItemsSource="{Binding Data.SearchProductList,Source={StaticResource proxy}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>



                <DataGridTextColumn  Binding="{Binding Description}" IsReadOnly="False" Visibility="{Binding Data.IsUpdateShown,Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelDescription}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTemplateColumn Visibility="{Binding Data.IsUpdateShown,Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <DataGridTemplateColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelFormat}" ></Label>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Format, Mode=OneWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" Text="{Binding Format, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                        ItemsSource="{Binding Data.SearchFormatList,Source={StaticResource proxy}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!--<DataGridTextColumn  Binding="{Binding Format}" IsReadOnly="False" >
                <DataGridTextColumn.Header>
                    <Label Content="{DynamicResource NUT_LabelFormat}" ></Label>
                </DataGridTextColumn.Header>
            </DataGridTextColumn>-->

                <DataGridTextColumn  Binding="{Binding CreatedBy}" IsReadOnly="True" Visibility="{Binding Data.IsUpdateShown,Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelCreator}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding CreatedOn,StringFormat='dd/MM/yyyy'}"  IsReadOnly="True" Visibility="{Binding Data.IsUpdateShown,Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource NUT_LabelCreatedOn}" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>

    </DockPanel>
</Fluent:RibbonWindow>
