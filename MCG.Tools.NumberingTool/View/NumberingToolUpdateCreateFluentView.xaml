<Fluent:RibbonWindow x:Class="MCG.Tools.NumberingTool.View.NumberingToolUpdateCreateFluentView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.NumberingTool.View"
                     xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="{DynamicResource NUT_TitlePartNumber}" 
                     Height="300" Width="300" 
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/part.gif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <BitmapImage x:Key="Close" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Delete.ico" />
            <BitmapImage x:Key="Check" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check.ico" />
            <BitmapImage x:Key="Update" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save_32x32.png" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" ></conv:BoolToVisibilityConverter>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" ></conv:InverseBoolToVisibilityConverter>

        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <DockPanel.Background>
            <LinearGradientBrush >
                <GradientStop Color="{DynamicResource Fluent.Ribbon.Colors.AccentColor20}"/>
            </LinearGradientBrush>
        </DockPanel.Background>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <StackPanel DockPanel.Dock="Bottom" Name="StackPanelButton" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Height="32" Margin="0,2" Width="{Binding ActualWindowWidth,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}">
                <Button ToolTip="{DynamicResource NUT_BtCreate}" Command="{Binding CommandCreateNumber}" Visibility="{Binding IsUpdateShown,Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Image   Source="{StaticResource Check}"></Image>
                </Button>
                <Button ToolTip="{DynamicResource NUT_BtUpdate}" Command="{Binding CommandUpdateNumber}"  Visibility="{Binding IsUpdateShown,Converter={StaticResource BoolToVisibilityConverter},FallbackValue=Collapsed}">
                    <Image   Source="{StaticResource Update}"></Image>
                </Button>
                <Rectangle Width="100"></Rectangle>
                <Button  ToolTip="{DynamicResource NUT_BtCancel}" Command="{Binding CommandCancel}">
                    <Image   Source="{StaticResource Close}"></Image>
                </Button>
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="5" Height="30">
            <Fluent:TwoLineLabel  Width="90" VerticalContentAlignment="Center" 
                                  Text="{DynamicResource NUT_LabelCreatedOn}"
                                  HasTwoLines="False"></Fluent:TwoLineLabel>
            <Fluent:TwoLineLabel  Width="150" VerticalContentAlignment="Center" 
                                  Text="{Binding CurrentItem.CreatedOn,StringFormat='dd/MM/yyyy'}"
                                  HasTwoLines="False"></Fluent:TwoLineLabel>
        </StackPanel>

        <StackPanel >
            <StackPanel Orientation="Horizontal" Margin="5">
                <Fluent:TwoLineLabel  Width="90"
                                  VerticalContentAlignment="Center" 
                                  Text="{DynamicResource NUT_LabelDescription}"
                                  HasTwoLines="False"></Fluent:TwoLineLabel>
                <TextBox  AcceptsReturn="True"  
                      Width="150" 
                      Height="50" 
                      Text="{Binding CurrentItem.Description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto">
                </TextBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5" Height="30">
                <Fluent:ComboBox Width="240" 
                             Fluent:InputControlProperties.InputWidth="150"
                             IsEditable="True"
                             Header="{DynamicResource NUT_LabelProduct}"
                             ItemsSource="{Binding ListProduct}" 
                             VerticalContentAlignment="Center" 
                             Text="{Binding CurrentItem.Product,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=N/A}"></Fluent:ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="5" Height="30">
                <Fluent:ComboBox Width="240"
                             Fluent:InputControlProperties.InputWidth="150"
                             IsEditable="True"
                             Header="{DynamicResource NUT_LabelFormat}"
                             ItemsSource="{Binding ListFormat}" VerticalContentAlignment="Center" 
                             Text="{Binding CurrentItem.Format,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=N/A}"></Fluent:ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5" Height="30">
                <Fluent:TwoLineLabel  Width="90" VerticalContentAlignment="Center" 
                                  Text="{DynamicResource NUT_LabelCreator}"
                                  HasTwoLines="False"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel  Width="150" VerticalContentAlignment="Center" 
                                  Text="{Binding CurrentItem.CreatedBy,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged, FallbackValue=Unknown}"
                                  HasTwoLines="False"></Fluent:TwoLineLabel>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Fluent:RibbonWindow>
