<Fluent:RibbonWindow x:Class="MCG.Tools.EcnEcoFollowUp.View.EcoWorkFlowTasksView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.EcnEcoFollowUp.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="Eco Workflow Tasks" 
                     Height="600" Width="600" 
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/sap.png">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel x:Name="MainDock">
        <Fluent:Ribbon DockPanel.Dock="Top" AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem >
                <Fluent:RibbonGroupBox Width="{Binding ActualWidth, ElementName=MainDock}">
                    <Fluent:TextBox FontSize="14"
                                Margin="0,0,0,1"
                                MinWidth="200"
                                Width="{Binding ActualWidth, ElementName=TbDesc}"
                                HorizontalContentAlignment="Center"
                                IsReadOnly="True"
                                Header="{DynamicResource EFU_LabelSearchEcnNumber}"
                                Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Number}" />
                    <Fluent:TextBox FontSize="14"  
                                Margin="0,1,0,1"
                                MinWidth="200"
                                Width="{Binding ActualWidth, ElementName=TbDesc}"
                                HorizontalContentAlignment="Center"
                                IsReadOnly="True"
                                Header="{DynamicResource EFU_LabelSearchEcoStatus}"
                                Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Status}" />
                    <Fluent:TextBox Name="TbDesc" 
                                Margin="0,1,0,0"
                                FontSize="14"  
                                MinWidth="200"
                                IsReadOnly="True"
                                HorizontalContentAlignment="Center"
                                Header="{DynamicResource EFU_LabelEcnDescription}"
                                Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Name}" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Button Name="BtOk" DockPanel.Dock="Bottom" Content="{DynamicResource EFU_BtClose}"  Height="30" Click="BtOk_Click"></Button>
        <Fluent:TwoLineLabel DockPanel.Dock="Top"  
                         HorizontalContentAlignment="Center" 
                         VerticalContentAlignment="Center" 
                         FontSize="16" 
                         Text="{DynamicResource EFU_LabelMainPlant}"
                         HorizontalAlignment="Center"
                         HasTwoLines="False"/>

        <DataGrid DockPanel.Dock="Top" Name="EcoWfTaskMainPlant" ItemsSource="{Binding EcoWfTaskListMainPlant}" Margin="2" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="1-View ECO">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType1}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="2-Plant Relevant">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType2}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="3-Planning">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType3}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="4-Purchase">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType4}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="5-Quality">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType5}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="6-Production">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType6}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="7-Effective date">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType7}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="COMPLETED">
                            <Setter Property="Background" Value="#FF82C4FB"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="READY">
                            <Setter Property="Background" Value="#FFFF9696"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="COMMITTED">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="SELECTED">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding CALCULATED_PLANT_DESC}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelSapPlant}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding TYPE_ITEM}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemName}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_STATUS}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemStatus}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_ACTUAL_AGENT}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemOwner}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_CREATION_DATE,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemCreatedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_END_DATE,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemCompletedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>

        <Fluent:TwoLineLabel DockPanel.Dock="Top" 
                         HorizontalContentAlignment="Center" 
                         VerticalContentAlignment="Center" 
                         FontSize="16" 
                         Text="{DynamicResource EFU_LabelOtherPlants}"
                         HorizontalAlignment="Center"
                         HasTwoLines="False"/>

        <DataGrid DockPanel.Dock="Top" Name="EcoWfTaskOtherPlant" ItemsSource="{Binding EcoWfTaskListOtherPlants}" Margin="2" IsReadOnly="True" AutoGenerateColumns="False">
            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="1-View ECO">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType1}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="2-Plant Relevant">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType2}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="3-Planning">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType3}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="4-Purchase">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType4}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="5-Quality">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType5}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="6-Production">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType6}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TYPE_ITEM}" Value="7-Effective date">
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_LabelWfTaskType7}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="COMPLETED">
                            <Setter Property="Background" Value="#FF82C4FB"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="READY">
                            <Setter Property="Background" Value="#FFFF9696"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="COMMITTED">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding WI_STATUS}" Value="SELECTED">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding CALCULATED_PLANT_DESC}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelSapPlant}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding TYPE_ITEM}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemName}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_STATUS}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemStatus}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_ACTUAL_AGENT}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemOwner}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_CREATION_DATE,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemCreatedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WI_END_DATE,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfItemCompletedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>
    </DockPanel>
</Fluent:RibbonWindow>
