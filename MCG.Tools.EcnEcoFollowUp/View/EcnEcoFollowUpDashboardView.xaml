<UserControl x:Class="MCG.Tools.EcnEcoFollowUp.View.EcnEcoFollowUpDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MCG.Tools.EcnEcoFollowUp.View"
             xmlns:Conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
             xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
             xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Fluent="urn:fluent-ribbon"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <Conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></Conv:BoolToVisibilityConverter>
            <Conv:InverseBoolConverter x:Key="InverseBoolConverter"></Conv:InverseBoolConverter>
            <Conv:BoolToVisibilityMultiAndConverter x:Key="BoolToVisibilityMultiAndConverter"></Conv:BoolToVisibilityMultiAndConverter>
            <BitmapImage x:Key="Hide" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/hide.gif" />
            <BitmapImage x:Key="ECN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/chgnotice.gif" />
            <BitmapImage x:Key="WFTASK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/WfTask.gif" />
            <BitmapImage x:Key="WFTASKSAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/sap.png" />
            <BitmapImage x:Key="Refresh" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/refresh.gif" />
            <BitmapImage x:Key="Add" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Add_Cross.ico" />
            <BitmapImage x:Key="Add_search" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Add_search.gif" />
            <BitmapImage x:Key="Remove" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Remove.gif" />
            <BitmapImage x:Key="Export" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico" />
            <BitmapImage x:Key="DOC" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/doc_document.gif" />
            <BitmapImage x:Key="DASHBOARD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_16x16.png" />

            <CollectionViewSource x:Key="ListPriority" Source="{Binding DashboardItem.ListPriority}" />
            <MCGWpfLib:BindingProxy x:Key="proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" Height="30">
                <Button Margin="1,0" ToolTip="{DynamicResource EFU_BtAddOneEcn}" Command="{Binding CommandAddOneEcn}">
                    <Image   Source="{StaticResource ResourceKey=Add}"></Image>
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource  BoolToVisibilityMultiAndConverter}">
                            <Binding Path="Data.DashboardItem.IsAddDeletEcnEcoAllowed" Source="{StaticResource proxy}" />
                            <Binding Path="Data.DashboardItem.UpdateAllowed" Source="{StaticResource proxy}" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button Margin="1,0" ToolTip="{DynamicResource EFU_BtAddEcnFromSearch}" Command="{Binding CommandAddEcnFromSearch}" >
                    <Image   Source="{StaticResource ResourceKey=Add_search}"></Image>
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource  BoolToVisibilityMultiAndConverter}">
                            <Binding Path="Data.DashboardItem.IsAddDeletEcnEcoAllowed" Source="{StaticResource proxy}" />
                            <Binding Path="Data.DashboardItem.UpdateAllowed" Source="{StaticResource proxy}" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button Margin="1,0" ToolTip="{DynamicResource EFU_BtDeleteSelectedEcn}" Command="{Binding CommandDeleteSelectedEcn}" >
                    <Image   Source="{StaticResource ResourceKey=Remove}"></Image>
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource  BoolToVisibilityMultiAndConverter}">
                            <Binding Path="Data.DashboardItem.IsAddDeletEcnEcoAllowed" Source="{StaticResource proxy}" />
                            <Binding Path="Data.DashboardItem.UpdateAllowed" Source="{StaticResource proxy}" />
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button Margin="1,0" ToolTip="{DynamicResource EFU_BtExportToXls}" Command="{Binding CommandExportXls}">
                    <Image   Source="{StaticResource ResourceKey=Export}"></Image>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" 
                        DockPanel.Dock="Left" 
                        Height="40" 
                        VerticalAlignment="Center"
                        Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}">
                <Fluent:TwoLineLabel HasTwoLines="False" Text="ID:" VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{Binding DashboardItem.Id}" VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{DynamicResource EFU_LabelCreatedBy}" VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{Binding DashboardItem.CreatedBy}" VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{DynamicResource EFU_LabelCreatedOn}" VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{Binding DashboardItem.CreatedOn}" VerticalAlignment="Center"></Fluent:TwoLineLabel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                        Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}">
                <Fluent:TwoLineLabel HasTwoLines="False" Text="{DynamicResource EFU_LabelDashboardGenComment}" 
                       VerticalAlignment="Center"></Fluent:TwoLineLabel>
                <TextBox Height="40"
                         Width="250"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" 
                         Text="{Binding DashboardItem.GeneralComment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         AcceptsReturn="True" 
                         IsReadOnly="{Binding Data.DashboardItem.UpdateAllowed, Source={StaticResource proxy},Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" Height="30">
                <Button Margin="1,0" Command="{Binding CommandRefreshDashboard}">
                    <Image  ToolTip="{DynamicResource EFU_TtRefreshDashboard}"  HorizontalAlignment="Right" Source="{StaticResource ResourceKey=Refresh}"/>
                </Button>
                <Button Margin="1,0" Command="{Binding CommandHideDashboard}" Visibility="{Binding DashboardItem.IsHideShowDashboardAllowed,Converter={StaticResource BoolToVisibilityConverter}}">
                    <Image  ToolTip="{DynamicResource EFU_TtHideDashboard}"  Source="{StaticResource ResourceKey=Hide}"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <DockPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Background="#FF8DB4E2">
                <CheckBox Content="{DynamicResource EFU_LabelInProgress}" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsInProgress,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="{DynamicResource EFU_LabelUnderReview}" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsUnderReview,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="{DynamicResource EFU_LabelResolved}" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsResolved,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="{DynamicResource EFU_LabelCanceled}" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsCanceled,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Background="#FFC4D79B">
                <CheckBox Content="{DynamicResource EFU_LabelNotCreated}" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsStatusNotCreated,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="99" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsStatus99,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="01" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsStatus01,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="02" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsStatus02,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="03" Margin="2,0" IsChecked="{Binding DashboardItem.CurrentDashboardConfiguration.IsStatus03,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <CheckBox Content="{DynamicResource EFU_DashboardIsShared}" Visibility="{Binding DashboardItem.IsCreator,Converter={StaticResource BoolToVisibilityConverter}}"  Margin="2,0" IsChecked="{Binding DashboardItem.IsShared,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
                <CheckBox Content="{DynamicResource EFU_DashboardIsReadOnly}" Visibility="{Binding DashboardItem.IsCreator,Converter={StaticResource BoolToVisibilityConverter}}" Margin="2,0" IsEnabled="{Binding DashboardItem.IsShared}" IsChecked="{Binding DashboardItem.IsReadOnly,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></CheckBox>
            </StackPanel>
        </DockPanel>


        <DataGrid RowHeight="22" 
                  Name="DgEcnEco" 
                  FrozenColumnCount="3" 
                  ItemsSource="{Binding DashboardItem.ListEcnEco}" 
                  SelectedItem="{Binding DashboardItem.SelectedEcnEco,Mode=OneWayToSource,UpdateSourceTrigger=PropertyChanged}" 
                  CanUserAddRows="False" 
                  IsReadOnly="False" 
                  AutoGenerateColumns="False" 
                  SelectionMode="Extended" 
                  SelectionUnit="Cell" 
                  MouseLeftButtonUp="DataGrid_MouseLeftButtonUp"
                  ColumnDisplayIndexChanged="DgEcnEco_ColumnDisplayIndexChanged"
                  Loaded="DgEcnEco_Loaded">
            <DataGrid.ContextMenu>
                <Fluent:ContextMenu>
                    <Fluent:MenuItem x:Name="MiOpenEcn"
                                     Header="{DynamicResource EFU_MiOpenEcn}" 
                                     Command="{Binding CommandMenuItemOpenEcn}"  
                                     Icon="{StaticResource ResourceKey=ECN}">
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiOpenEcnDocs" 
                                     Header="{DynamicResource EFU_MiOpenEcnDocs}" 
                                     Command="{Binding CommandMenuItemOpenEcnDocs}" 
                                     ItemsSource="{Binding DashboardItem.SelectedEcnEco.EcnEcoToShowEndUser.MenuAttachments}" 
                                     Icon="{StaticResource ResourceKey=DOC}">
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiEcnWfTask" 
                                     Header="{DynamicResource EFU_MiSearchEcnWfTask}" 
                                     Command="{Binding CommandMenutItemSearchEcnWfTask}" 
                                     Icon="{StaticResource ResourceKey=WFTASK}">
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiEcoWfTask" 
                                     Header="{DynamicResource EFU_MiSearchEcoWfTask}" 
                                     Command="{Binding CommandMenutItemSearchEcoWfTask}"
                                     Icon="{StaticResource ResourceKey=WFTASKSAP}">
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiDeleteEcnEco" 
                                     Header="{DynamicResource EFU_MiSavedDashboardRemoveEcnEco}" 
                                     Command="{Binding CommandMenutItemRemoveEcnEco}" 
                                     Visibility="{Binding DashboardItem.IsAddDeletEcnEcoAllowed,Converter={StaticResource BoolToVisibilityConverter}}"
                                     Icon="{StaticResource ResourceKey=Remove}">
                    </Fluent:MenuItem>
                    <Fluent:MenuItem x:Name="MiSearchAddEcnEcoToDashboard" 
                                     Header="{DynamicResource EFU_MiSearchAddEcnEcoToDashboard}">
                        <Fluent:MenuItem.Icon>
                            <Image Height="13" Source="{StaticResource DASHBOARD}"></Image>
                        </Fluent:MenuItem.Icon>
                    </Fluent:MenuItem>
                </Fluent:ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Background="LightGray">
                        <StackPanel Width="250" 
                                    Margin="2,2" 
                                    Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}">
                            <Fluent:TwoLineLabel HasTwoLines="False" 
                                                 Text="{DynamicResource EFU_LabelEcnEcoComment}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center" ></Fluent:TwoLineLabel>
                            <TextBox Height="80" 
                                     Background="{DynamicResource IdealBackgroundColor}"
                                     Foreground="{DynamicResource IdealForegroundColor}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                     Text="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" 
                                     IsReadOnly="{Binding Data.DashboardItem.UpdateAllowed, Source={StaticResource proxy},Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>
                        <StackPanel Width="250" 
                                    Margin="2,2" 
                                    Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}">
                            <Fluent:TwoLineLabel HasTwoLines="False" 
                                                 Text="{DynamicResource EFU_LabelEcnEcoActions}" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center" ></Fluent:TwoLineLabel>
                            <TextBox Height="80" 
                                     Background="{DynamicResource IdealBackgroundColor}"
                                     Foreground="{DynamicResource IdealForegroundColor}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                     Text="{Binding Information, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" 
                                     IsReadOnly="{Binding Data.DashboardItem.UpdateAllowed, Source={StaticResource proxy},Converter={StaticResource InverseBoolConverter}}"/>
                        </StackPanel>

                        <StackPanel Orientation="Vertical"
                                    Margin="2,2" 
                                    Background="{DynamicResource PdmColor}" 
                                    VerticalAlignment="Center">
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelSearchEcnNumberPart}"
                                            Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Nb_Part}" 
                                            Margin="5,1"
                                            VerticalAlignment="Center"
                                            IsReadOnly="True"/>
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelSearchEcnNbDrawing}"
                                            Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Nb_Drw}" 
                                            Margin="5,1"
                                            VerticalAlignment="Center"
                                            IsReadOnly="True"/>
                        </StackPanel>

                        <StackPanel Margin="2,2" 
                                    Background="{DynamicResource SapColor}" 
                                    VerticalAlignment="Center">
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelSearchEcnSapOrder}"
                                            Margin="5,1"
                                            Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}" 
                                            IsReadOnly="{Binding Data.DashboardItem.UpdateAllowed, Source={StaticResource proxy},Converter={StaticResource InverseBoolConverter}}"
                                            AcceptsReturn="False" 
                                            Text="{Binding SapOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            </Fluent:TextBox>
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelEcoNextStepSecondary}"
                                            Margin="5,1"
                                            IsReadOnly="True"
                                            Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Next_Step_Secondary}">
                            </Fluent:TextBox>
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelEcoLastWiCreatedOnSecondary}"
                                            Margin="5,1"
                                            IsReadOnly="True"
                                            Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Last_Wi_Created_On_Secondary,StringFormat='dd/MM/yyyy'}">
                            </Fluent:TextBox>
                            <Fluent:TextBox Header="{DynamicResource EFU_LabelEcoWiInProgressSecondary}"
                                            Margin="5,1"
                                            IsReadOnly="True"
                                            Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Wi_Secondary_Plants}">
                            </Fluent:TextBox>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>

            <DataGrid.Columns>
                <MCGWpfLib:DataGridTemplateColumnMcg CanUserReorder="False" 
                                                     CanUserResize="False"
                                                     ColumnId="CkeckBox">
                    <MCGWpfLib:DataGridTemplateColumnMcg.Header>
                        <CheckBox Name="CheckBoxHeader" >
                            <behaviors:Interaction.Triggers>
                                <behaviors:EventTrigger EventName="Checked">
                                    <behaviors:InvokeCommandAction Command="{Binding Data.CommandCheckAllDashboard , Source={StaticResource proxy} }" ></behaviors:InvokeCommandAction>
                                </behaviors:EventTrigger>

                                <behaviors:EventTrigger EventName="Unchecked">
                                    <behaviors:InvokeCommandAction Command="{Binding Data.CommandUncheckAllDashboard, Source={StaticResource proxy} }" ></behaviors:InvokeCommandAction>
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>
                        </CheckBox>
                    </MCGWpfLib:DataGridTemplateColumnMcg.Header>
                    <MCGWpfLib:DataGridTemplateColumnMcg.CellTemplate>
                        <DataTemplate>
                            <CheckBox Name="CbTemplate" 
                                      IsChecked="{Binding IsSelected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=False}" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </MCGWpfLib:DataGridTemplateColumnMcg.CellTemplate>
                </MCGWpfLib:DataGridTemplateColumnMcg>

                <MCGWpfLib:DataGridComboBoxColumnMcg DataGridComboBoxColumn.ItemsSource="{Binding Source={StaticResource ListPriority}}" 
                                                     SelectedItemBinding="{Binding Priority,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                                     Visibility="{Binding Data.DashboardItem.IsPersonalInfoShown, Source={StaticResource proxy},Converter={StaticResource BoolToVisibilityConverter}}" 
                                                     IsReadOnly="{Binding Data.DashboardItem.UpdateAllowed, Source={StaticResource proxy},Converter={StaticResource InverseBoolConverter}}"
                                                     ColumnId="EFU_LabelPriority">
                    <DataGridComboBoxColumn.Header>
                        <StackPanel Background="{DynamicResource PdmColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelPriority}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridComboBoxColumn.Header>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </MCGWpfLib:DataGridComboBoxColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg  Binding="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Number}" 
                                                  IsReadOnly="True"
                                                  ColumnId="EFU_LabelSearchEcnNumber">
                    <DataGridTextColumn.Header>
                        <StackPanel Background="{DynamicResource PdmColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelSearchEcnNumber}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECNINPROGRESS">
                                    <Setter Property="Background" Value="#FFFDE9D9"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcnInProgress}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECNINPROGRESS90">
                                    <Setter Property="Background" Value="#FFDA9694"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcnInProgress90}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOTOBECREATED">
                                    <Setter Property="Background" Value="#FFB8CCE4"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoToBeCreated}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOSTATUS99">
                                    <Setter Property="Background" Value="#FFB8CCE4"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoStatus99}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOSTATUS01_6MONTHS">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#FFC4D79B" Offset="0"/>
                                                <GradientStop Color="#FEC4D79B" Offset="0.10"/>
                                                <GradientStop Color="#FFFF5A5A" Offset="0.2"/>
                                                <GradientStop Color="#FEC4D79B" Offset="0.30"/>
                                                <GradientStop Color="#FEC4D79B" Offset="0.5"/>
                                                <GradientStop Color="#FFFF5A5A" Offset="0.6"/>
                                                <GradientStop Color="#FEC4D79B" Offset="0.70"/>
                                                <GradientStop Color="#FEC4D79B" Offset="0.90"/>
                                                <GradientStop Color="#FFFF5A5A" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoStatus01_6months}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOSTATUS01">
                                    <Setter Property="Background" Value="#FFC4D79B"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoStatus01}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOSTATUS02">
                                    <Setter Property="Background" Value="#FF9BBB59"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoStatus02}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECOSTATUS03">
                                    <Setter Property="Background" Value="#FFDDD9C4"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcoStatus03}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECNCANCELED">
                                    <Setter Property="Background" Value="#FFD9D9D9"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcnCanceled}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding EcnEcoToShowEndUser.Status}" Value="ECNUNDERREVIEW">
                                    <Setter Property="Background" Value="#FFFABF8F"/>
                                    <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipEcnUnderReview}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </MCGWpfLib:DataGridTextColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg  Binding="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Name}" 
                                                  IsReadOnly="True"
                                                  ColumnId="EFU_LabelEcnDescription">
                    <DataGridTextColumn.Header>
                        <StackPanel Background="{DynamicResource PdmColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelEcnDescription}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </MCGWpfLib:DataGridTextColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg  Binding="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_State}" 
                                                  IsReadOnly="True"
                                                  ColumnId="EFU_LabelSearchEcnState">
                    <DataGridTextColumn.Header>
                        <StackPanel Background="{DynamicResource PdmColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelSearchEcnState}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </MCGWpfLib:DataGridTextColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg Binding="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Status}" 
                                                 IsReadOnly="True" 
                                                 SortMemberPath="EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Status_Order"
                                                 ColumnId="EFU_LabelSearchSAPStatus">
                    <DataGridTextColumn.Header>
                        <StackPanel Background="{DynamicResource SapColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelSearchSAPStatus}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </MCGWpfLib:DataGridTextColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg   IsReadOnly="True"
                                                   ColumnId="EFU_LabelEcoMainPlant">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat=" {0} ({1})">
                            <Binding Path="EcnEcoToShowEndUser.EcnEcoFollowUp.MainPlantDescription"/>
                            <Binding Path="EcnEcoToShowEndUser.EcnEcoFollowUp.MainPlant"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                    <DataGridTextColumn.Header>
                        <StackPanel Background="{DynamicResource SapColor}">
                            <Fluent:TwoLineLabel Text="{DynamicResource EFU_LabelEcoMainPlant}" 
                                                 HasTwoLines="True"
                                                 Margin="10,0"
                                                 Foreground="{DynamicResource IdealForegroundColor}"/>
                        </StackPanel>
                    </DataGridTextColumn.Header>
                </MCGWpfLib:DataGridTextColumnMcg>

                <MCGWpfLib:DataGridTextColumnMcg  Binding="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Eco_Next_Step}" 
                                                  IsReadOnly="True"
                                                  ColumnId="EFU_LabelEcoNextStep">
                    <DataGridTextColumn.Header>
