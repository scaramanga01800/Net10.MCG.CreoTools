<Fluent:RibbonWindow x:Class="MCG.Tools.EcnEcoFollowUp.View.EcnEcaWorkFlowTasksView"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:local="clr-namespace:MCG.Tools.EcnEcoFollowUp.View"
                     xmlns:Fluent="urn:fluent-ribbon"
                     mc:Ignorable="d"
                     Title="Ecn Eca Workflow Tasks" 
                     Height="600" Width="600" 
                     Icon="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/WfTask.gif">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel x:Name="MainDock">
        <Fluent:Ribbon DockPanel.Dock="Top" AreTabHeadersVisible="False">
            <Fluent:RibbonTabItem >
                <Fluent:RibbonGroupBox Width="{Binding ActualWidth, ElementName=MainDock}">
                    <Fluent:TextBox FontSize="14"
                                    Margin="0,0,0,1"
                                    MinWidth="200"
                                    Width="{Binding ActualWidth, ElementName=TbDesc}"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Header="{DynamicResource EFU_LabelSearchEcnNumber}"
                                    Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Number}" />
                    <Fluent:TextBox FontSize="14"  
                                    Margin="0,1,0,1"
                                    MinWidth="200"
                                    Width="{Binding ActualWidth, ElementName=TbDesc}"
                                    HorizontalContentAlignment="Center"
                                    IsReadOnly="True"
                                    Header="{DynamicResource EFU_LabelSearchEcnState}"
                                    Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_State}" />
                    <Fluent:TextBox Name="TbDesc" 
                                    Margin="0,1,0,0"
                                    FontSize="14"  
                                    MinWidth="200"
                                    IsReadOnly="True"
                                    HorizontalContentAlignment="Center"
                                    Header="{DynamicResource EFU_LabelEcnDescription}"
                                    Text="{Binding EcnEcoToShowEndUser.EcnEcoFollowUp.Ecn_Name}" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <Button Name="BtOk"
                DockPanel.Dock="Bottom" 
                Content="{DynamicResource EFU_BtClose}"  
                Height="30" 
                Click="BtOk_Click"></Button>

        <Fluent:TwoLineLabel DockPanel.Dock="Top" 
                             Text="{DynamicResource EFU_LabelEcnWfTask}"  
                             HorizontalContentAlignment="Center" 
                             Height="30" 
                             FontSize="16"
                             HorizontalAlignment="Center"
                             HasTwoLines="False"></Fluent:TwoLineLabel>

        <DataGrid Name="SpEcnWfTask" 
                  ItemsSource="{Binding ListEcnWfTask}" 
                  DockPanel.Dock="Top" 
                  Margin="2" 
                  IsReadOnly="True" 
                  AutoGenerateColumns="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKCOMPLETED">
                            <Setter Property="Background" Value="#FF82C4FB"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfTaskCompleted}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKREWORKED">
                            <Setter Property="Background" Value="#FF8A80FF"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfTaskReworked}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKINPROGRESS">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfInProgress}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn x:Name="Col01"  Binding="{Binding WfTaskName}" IsReadOnly="True" >
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskName}"  Background="#FF538DD5" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskOwner}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskOwner}" Background="#FF538DD5" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding Vote}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskStatus}" Background="#FF538DD5" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskCreatedOn,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskCreatedDate}" Background="#FF538DD5" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskCompletedOn,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskCompletedDate}" Background="#FF538DD5" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>

        </DataGrid>

        <Fluent:TwoLineLabel DockPanel.Dock="Top" 
                             Text="{DynamicResource EFU_LabelEcoWfTask}" 
                             HorizontalContentAlignment="Center" 
                             Height="30" 
                             FontSize="16"
                             HorizontalAlignment="Center"
                             HasTwoLines="False"></Fluent:TwoLineLabel>

        <DataGrid DockPanel.Dock="Top" 
                  Name="SpEcaWfTask" 
                  ItemsSource="{Binding ListEcaWfTask}" 
                  Margin="2" 
                  IsReadOnly="True" 
                  AutoGenerateColumns="False">

            <DataGrid.Resources>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKCOMPLETED">
                            <Setter Property="Background" Value="#FF82C4FB"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfTaskCompleted}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKREWORKED">
                            <Setter Property="Background" Value="#FF8A80FF"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfTaskReworked}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="WFTASKINPROGRESS">
                            <Setter Property="Background" Value="#FFFFDA69"/>
                            <Setter Property="ToolTip" Value="{DynamicResource EFU_ToolTipWfInProgress}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn  Binding="{Binding EcaNumber}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfEcaNumber}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding EcaSate}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfEcaState}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskName}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskName}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskOwner}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskOwner}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding Vote}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskStatus}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskCreatedOn,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskCreatedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn  Binding="{Binding WfTaskCompletedOn,StringFormat='dd/MM/yyyy'}" IsReadOnly="True">
                    <DataGridTextColumn.Header>
                        <Label Content="{DynamicResource EFU_LabelWfTaskCompletedDate}" Background="#FFC4D79B" ></Label>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Fluent:RibbonWindow>
