<Fluent:RibbonTabItem x:Class="MCG.Tools.EcnEcoFollowUp.View.EcnEcoFollowUpFluentTabView"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                      xmlns:local="clr-namespace:MCG.Tools.EcnEcoFollowUp.View"
                      xmlns:Fluent="urn:fluent-ribbon"
                      xmlns:MCGWpfLib="clr-namespace:MCG.CommonLib.WpfComponent.View;assembly=MCG.CommonLib.WpfComponent"
                      xmlns:conv="clr-namespace:MCG.Converters;assembly=MCG.Converters"
                      mc:Ignorable="d" 
                      d:DesignHeight="450" d:DesignWidth="800"
                      Header="{DynamicResource EFU_AppName}">

    <Fluent:RibbonTabItem.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"></conv:BoolToVisibilityConverter>
            <BitmapImage x:Key="SEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Search_32x32.png" />
            <BitmapImage x:Key="SAVESEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Save_16x16.png" />
            <BitmapImage x:Key="SAVEDSEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/search_16x16.png" />
            <BitmapImage x:Key="RECENTSEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/search_16x16.png" />
            <BitmapImage x:Key="EXCEL" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Excel.ico" />
            <BitmapImage x:Key="ECN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/chgnotice.gif" />
            <BitmapImage x:Key="WFTASK" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/WfTask.gif" />
            <BitmapImage x:Key="WFTASKSAP" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/sap.png" />
            <BitmapImage x:Key="DASHBOARD" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_16x16.png" />
            <BitmapImage x:Key="DASHBOARD_NEW" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_new_32x32.png" />
            <BitmapImage x:Key="DASHBOARD_SEARCH" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_search_32x32.png" />
            <BitmapImage x:Key="DASHBOARD_SAVED" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_show_32x32.png" />
            <BitmapImage x:Key="DASHBOARD_SENT_ECN" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Dashboard_send_32x32.png" />
            <BitmapImage x:Key="DASHBOARD_SEARCHED" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/search_16x16.png" />
            <BitmapImage x:Key="DASHBOARD_EMPTY" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Empty_dashboard_16x16.png" />
            <BitmapImage x:Key="DELETE" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Close.png" />

            <BitmapImage x:Key="CalendarGreen" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/calendar_green.ico" />
            <BitmapImage x:Key="CalendarRed" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/calendar_red.ico" />
            <BitmapImage x:Key="CheckGreen" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/check_green_32x32.png" />
            <BitmapImage x:Key="Filter" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/Filter.ico"/>
            <BitmapImage x:Key="Help" UriSource="pack://application:,,,/MCG.CommonLib.Resources;component/Resources/help.ico" />
        </ResourceDictionary>
    </Fluent:RibbonTabItem.Resources>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpMainSearch}"  Grid.IsSharedSizeScope="True">

        <Fluent:TwoLineLabel HorizontalAlignment="Center" 
                         Text="{DynamicResource EFU_LabelSearchEcnNumber}"></Fluent:TwoLineLabel>
        <Fluent:TextBox HorizontalContentAlignment="Center" 
                    VerticalContentAlignment="Center"
                    MinWidth="80"
                    Text="{Binding CurrentEcnEcoFollowUpDataContext.EcnNumber,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                    Margin="-9,0,0,0">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding CommandSearchEcnEco}"/>
            </TextBox.InputBindings>
        </Fluent:TextBox>
        <Fluent:SplitButton  Size="Middle" Header="{DynamicResource EFU_MiMainSearchShort}" Icon="{StaticResource SAVEDSEARCH}">
            <Fluent:MenuItem Header="{DynamicResource EFU_MiSaveSearch}" Icon="{StaticResource SAVESEARCH}" Command="{Binding CommandMenuItemSaveSearch}">
            </Fluent:MenuItem>
            <Fluent:MenuItem x:Name="MiSavedSearches" Header="{DynamicResource EFU_MiSavedSearches}" Icon="{StaticResource SAVEDSEARCH}">
            </Fluent:MenuItem>
            <Fluent:MenuItem x:Name="MiRecentSearches" Header="{DynamicResource EFU_MiRecenteSearches}" Icon="{StaticResource RECENTSEARCH}">
                <Fluent:MenuItem.Resources>
                    <Style x:Key="RecentSearchMenu" TargetType="{x:Type Fluent:MenuItem}">
                        <Setter Property="MenuItem.Header" Value="{Binding Name}" />
                        <Setter Property="MenuItem.Icon" Value="{StaticResource RECENTSEARCH}" />
                        <Setter Property="MenuItem.Command" Value="{Binding CommandSavedOrRecentSearch}"/>
                    </Style>
                </Fluent:MenuItem.Resources>
            </Fluent:MenuItem>
        </Fluent:SplitButton>

        <Fluent:Button  LargeIcon="{StaticResource SEARCH}" Command="{Binding CommandSearchEcnEco}" Margin="2,0,2,0">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_BtTitleStartSearch}" Width ="250"
                      Image="{StaticResource SEARCH}"
                      Text="{DynamicResource EFU_BtStartSearch}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpMainSearchPdm}" Background="{DynamicResource PdmColor}">
        <Fluent:SplitButton Header="{DynamicResource EFU_LabelSearchEcnCreatedOn}" LargeIcon="{StaticResource CalendarRed}" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label   Content="{DynamicResource EFU_LabelDateFrom}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.CreatedAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label  Content="{DynamicResource EFU_LabelDateTo}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.CreatedBefore,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
        </Fluent:SplitButton>

        <Fluent:SplitButton  Header="{DynamicResource EFU_LabelSearchEcnResolvedOn}" LargeIcon="{StaticResource CalendarGreen}" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label   Content="{DynamicResource EFU_LabelDateFrom}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.ResolvedAfter,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label  Content="{DynamicResource EFU_LabelDateTo}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.ResolvedBefore,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
        </Fluent:SplitButton>

        <Fluent:SplitButton Header="{DynamicResource EFU_LabelSearchOtherCriteria}" LargeIcon="{StaticResource Filter}" HorizontalAlignment="Right" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <Fluent:ComboBox Header="{DynamicResource EFU_LabelSearchProduct}" Width="200" IsEditable="True" ItemsSource="{Binding CurrentEcnEcoFollowUpDataContext.PdmProductList}" SelectedItem="{Binding CurrentEcnEcoFollowUpDataContext.PdmProduct,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></Fluent:ComboBox>
            <Fluent:ComboBox Header="{DynamicResource EFU_LabelSearchEcnState}" Width="200" IsEditable="True" ItemsSource="{Binding CurrentEcnEcoFollowUpDataContext.EcnStateList}" SelectedItem="{Binding CurrentEcnEcoFollowUpDataContext.EcnState,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" ></Fluent:ComboBox>
            <Fluent:TextBox  Width="200" 
                         Header="{DynamicResource EFU_LabelSearchKeyWord}" 
                         Text="{Binding CurrentEcnEcoFollowUpDataContext.KeyWords,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"  
                         HorizontalAlignment="Center" 
                         ToolTip="{DynamicResource EFU_ToolTipSearchKeyWord}"/>
            <Fluent:TextBox  Width="200" 
                         Header="{DynamicResource EFU_LabelSearchCreator}" 
                         Text="{Binding CurrentEcnEcoFollowUpDataContext.EcnCreator,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"  
                         HorizontalAlignment="Center" 
                         ToolTip="{DynamicResource EFU_ToolTipSearchKeyWordCreator}"/>
        </Fluent:SplitButton>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpMainSearchSap}" Background="{DynamicResource  SapColor}">
        <Fluent:SplitButton Header="{DynamicResource EFU_LabelSearchEcoCreatedOn}" LargeIcon="{StaticResource CalendarGreen}" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label   Content="{DynamicResource EFU_LabelDateFrom}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.CreatedAfterSap,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
                <Label  Content="{DynamicResource EFU_LabelDateTo}" VerticalContentAlignment="Center"  HorizontalContentAlignment="Center"></Label>
                <DatePicker Width="100" SelectedDate="{Binding CurrentEcnEcoFollowUpDataContext.CreatedBeforeSap,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"></DatePicker>
            </StackPanel>
        </Fluent:SplitButton>

        <Fluent:SplitButton Header="{DynamicResource EFU_LabelSearchSAPStatus}" LargeIcon="{StaticResource CheckGreen}" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <Fluent:CheckBox Header="{DynamicResource EFU_LabelSAPStatusNotCreated}" IsChecked="{Binding CurrentEcnEcoFollowUpDataContext.IsStatusNotCreated,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></Fluent:CheckBox>
            <StackPanel Orientation="Horizontal">
                <Fluent:CheckBox Header="99" IsChecked="{Binding CurrentEcnEcoFollowUpDataContext.IsStatus99,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></Fluent:CheckBox>
                <Fluent:CheckBox Header="01" IsChecked="{Binding CurrentEcnEcoFollowUpDataContext.IsStatus01,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></Fluent:CheckBox>
                <Fluent:CheckBox Header="02" IsChecked="{Binding CurrentEcnEcoFollowUpDataContext.IsStatus02,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></Fluent:CheckBox>
                <Fluent:CheckBox Header="03" IsChecked="{Binding CurrentEcnEcoFollowUpDataContext.IsStatus03,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged,FallbackValue=true}"></Fluent:CheckBox>
            </StackPanel>
        </Fluent:SplitButton>

        <Fluent:SplitButton Header="{DynamicResource EFU_LabelSearchOtherCriteria}" LargeIcon="{StaticResource Filter}" IsEnabled="{Binding CurrentEcnEcoFollowUpDataContext.IsOtherFieldEnable}">
            <Fluent:TextBox  Width="200" 
                         Header="{DynamicResource EFU_LabelSearchKeyWordProject}" 
                         Text="{Binding CurrentEcnEcoFollowUpDataContext.KeyWordsProject,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"  
                         HorizontalAlignment="Center" 
                         ToolTip="{DynamicResource EFU_ToolTipSearchKeyWord}"/>
            <Fluent:TextBox  Width="200" 
                         Header="{DynamicResource EFU_LabelSearchKeyWordCategory}" 
                         Text="{Binding CurrentEcnEcoFollowUpDataContext.KeyWordsCategory,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center"  
                         HorizontalAlignment="Center"
                         ToolTip="{DynamicResource EFU_ToolTipSearchKeyWord}"/>
        </Fluent:SplitButton>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpDashboard}" >
        <Fluent:SplitButton Size="Large" Icon="{StaticResource DASHBOARD_NEW}" LargeIcon="{StaticResource DASHBOARD_NEW}" Margin="2,1,2,0">
            <Fluent:MenuItem Icon="{StaticResource DASHBOARD_EMPTY}" Header="{DynamicResource EFU_MiCreateDashboardEmpty}" Command="{Binding CommandMenuItemCreateDashboardEmpty}" ></Fluent:MenuItem>
            <Fluent:MenuItem Icon="{StaticResource DASHBOARD_SEARCHED}" Header="{DynamicResource EFU_MiCreateDashboardFromSearch}" Command="{Binding CommandMenuItemCreateDashboardFromSearch}"></Fluent:MenuItem>
        </Fluent:SplitButton>

        <Fluent:Button  LargeIcon="{StaticResource DASHBOARD_SEARCH}" Command="{Binding CommandMenuItemSearchDashboard}" Margin="2,0,2,0">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_MiSearchDashboard}" Width ="250"
                              Image="{StaticResource DASHBOARD_SEARCH}"
                              Text="{DynamicResource EFU_MiSearchDashboard}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>

        <Fluent:Button  LargeIcon="{StaticResource DASHBOARD_SENT_ECN}" Command="{Binding CommandAddSelectedEcnEcotoDashboard}" Margin="2,0,2,0">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_BtTitleSearchAddSelectedEcnEcoToDashboard}" Width ="250"
                              Image="{StaticResource DASHBOARD_SENT_ECN}"
                              Text="{DynamicResource EFU_MiSearchAddSelectedEcnEcoToDashboard}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>

        <Fluent:SplitButton x:Name="MiSavedDashboard" Size="Large" Icon="{StaticResource DASHBOARD_SAVED}" LargeIcon="{StaticResource DASHBOARD_SAVED}" Margin="2,1,2,0"></Fluent:SplitButton>

    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpMainTools}" >
        <Fluent:Button  LargeIcon="{StaticResource EXCEL}" Command="{Binding CommandExportXls}" Margin="2,0,2,0">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_BtTitleExportExcel}" Width ="250"
                              Image="{StaticResource EXCEL}"
                              Text="{DynamicResource EFU_BtExportExcel}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>

        <Fluent:Button LargeIcon="{StaticResource Help}" Command="{Binding CommandShowHelp}" Margin="2,0,2,0"></Fluent:Button>
    </Fluent:RibbonGroupBox>

    <Fluent:RibbonGroupBox Header="{DynamicResource EFU_TabGrpAdmin}" Visibility="{Binding CurrentEcnEcoFollowUpDataContext.IsAdminToolsEnabled,Converter={StaticResource BoolToVisibilityConverter}}">
        <Fluent:Button  LargeIcon="{StaticResource DELETE}" Command="{Binding CommandAdmToolDeleteEcnEco}">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_MiDeleteEcnEco}" Width ="250"
                              Image="{StaticResource DELETE}"
                              Text="{DynamicResource EFU_MiDeleteEcnEco}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>

        <Fluent:Button  LargeIcon="{StaticResource SEARCH}" Command="{Binding CommandAdmToolSeachDeletedEcn}">
            <Fluent:Button.ToolTip>
                <Fluent:ScreenTip Title="{DynamicResource EFU_MiSearchDeletedEcn}" Width ="250"
                              Image="{StaticResource SEARCH}"
                              Text="{DynamicResource EFU_MiSearchDeletedEcn}"/>
            </Fluent:Button.ToolTip>
        </Fluent:Button>
    </Fluent:RibbonGroupBox>
</Fluent:RibbonTabItem>
